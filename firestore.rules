rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isMjOrAdmin() {
      return isSignedIn() && (myRole() == 'mj' || myRole() == 'admin');
    }

    function ownsCharacter(characterId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/characters/$(characterId))
        && get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;
    }

    // Profile + role. Any signed-in member can read (small trusted group,
    // no directory-harvesting concern). A user may only write their own
    // doc, and may not change their own `role` — only an existing admin
    // can promote/demote. This is the fix for the actual hole: previously
    // any signed-in user could set their own role to 'admin'.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'joueur';
      allow update: if (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Any signed-in member can read the campaign list; only mj/admin can
    // create, edit, assign/clear a GM, or delete — matches the app's
    // canManageCampaigns gate, now actually enforced server-side.
    match /Campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMjOrAdmin();

      // Campaign-scoped reference lore. Seeded only via the Admin SDK
      // (scripts/seedAll.mjs), which bypasses these rules entirely —
      // clients get read-only access, no legitimate write path. Mirrors
      // the flat legacy `races`/`classes` rules below during the migration.
      match /Races/{raceId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /Classes/{classId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // Approval status per player. Coarse (owner-or-mj, whole-doc) on
      // purpose, matching the flat legacy `participants` rule below during
      // the migration — session/injuries/posture fields still live on this
      // doc too (Cluster 3a; moving them to Characters/{id}/States/Current
      // is Cluster 3b, not done yet), and players need to freely adjust
      // their own hp/mana/posture/injuries/advantage.
      match /Players/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isMjOrAdmin() || request.auth.uid == uid;
        allow delete: if isMjOrAdmin();
      }

      // Character sheets. Readable by any signed-in member (team roster
      // shows everyone). Owners may only edit `backstory`/`updatedAt` (histoire
      // editor) — mirrors the flat legacy `characters` rule's FR-012
      // restriction and the literal fields `updateCharacter` actually writes
      // today (src/models/repositories/CharacterRepository.ts) pending the
      // PascalCase cleanup tracked as Cluster 8.
      match /Characters/{characterId} {
        allow read: if isSignedIn();
        allow create: if isMjOrAdmin()
          || (request.resource.data.PlayerId == request.auth.uid
              && request.resource.data.CampaignId == campaignId);
        allow update: if isMjOrAdmin()
          || (resource.data.PlayerId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backstory', 'updatedAt']));
        allow delete: if isMjOrAdmin() || resource.data.PlayerId == request.auth.uid;

        function ownsThisCharacter() {
          return get(/databases/$(database)/documents/Campaigns/$(campaignId)/Characters/$(characterId)).data.PlayerId == request.auth.uid;
        }

        match /States/Current {
          allow read: if isSignedIn();
          allow write: if isMjOrAdmin() || ownsThisCharacter();
        }
        match /Equipment/Main {
          allow read: if isSignedIn();
          allow write: if isMjOrAdmin() || ownsThisCharacter();
        }
        match /Items/{itemId} {
          allow read: if isSignedIn();
          allow write: if isMjOrAdmin() || ownsThisCharacter();
        }
      }
    }

    // Static reference lore. Seeded only via the Admin SDK
    // (scripts/uploadStaticDataAdmin.mjs), which bypasses these rules
    // entirely — clients get read-only access, no legitimate write path.
    match /races/{raceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /factions/{factionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /cosmology/{tierId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Character sheets. Readable by any signed-in member (team roster shows
    // everyone). Writable by the owner or mj/admin — checked against the
    // *existing* doc on update/delete so a non-owner can't spoof ownership
    // by writing a new ownerUid in the same request that grants themselves
    // access. No in-app create/update path exists yet (characters are
    // currently seeded via admin scripts), but the rule holds regardless
    // of what UI exists today.
    //
    // Note: documents are readable by any signed-in member by design
    // (team roster use case). Keep owner/mj-only private fields out of this
    // document and in a dedicated restricted path if needed later.
    match /characters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.ownerUid == request.auth.uid || isMjOrAdmin());
      // Owners may only edit their character's `backstory` (histoire editor,
      // FR-012) — full attribute/skill/gift edits stay mj/admin-only via the
      // raw editor. mj/admin keep unrestricted write access as before.
      allow update: if isSignedIn()
        && (
          isMjOrAdmin()
          || (
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backstory', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isMjOrAdmin());
    }

    // Session state (hp/mana/posture). Readable by any signed-in member
    // (team roster use case); writable by the owner or mj/admin.
    match /participants/{participantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (
          request.resource.data.uid == request.auth.uid
          || ownsCharacter(request.resource.data.characterId)
          || isMjOrAdmin()
        );
      allow update, delete: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || ownsCharacter(resource.data.characterId)
          || isMjOrAdmin()
        );
    }

    // Split out of `participants` so Firestore rules can actually restrict it —
    // rules can't hide a single field within an otherwise campaign-readable doc.
    match /participantNotes/{participantId} {
      allow read, write: if isSignedIn()
        && (
          get(/databases/$(database)/documents/participants/$(participantId)).data.uid == request.auth.uid
          || ownsCharacter(get(/databases/$(database)/documents/participants/$(participantId)).data.characterId)
          || isMjOrAdmin()
        );
    }

    // Table-wide session state (dés d'aventure/mésaventure). Readable by any
    // signed-in campaign member; writable by mj/admin only, doc id ==
    // campaignId. Counters must never go negative (I-S3).
    match /campaignSessions/{campaignId} {
      allow read: if isSignedIn();
      allow create, update: if isMjOrAdmin()
        && request.resource.data.adventureDice.aventure >= 0
        && request.resource.data.adventureDice.mesaventure >= 0;
      allow delete: if isMjOrAdmin();
    }

    // Character inventory extracted from participant session state.
    // Ownership and mj/admin permissions mirror participants.
    match /inventories/{inventoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.uid == request.auth.uid || isMjOrAdmin());
      allow update, delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isMjOrAdmin());
    }

    // Deny by default: anything not explicitly matched above is neither
    // readable nor writable by clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
