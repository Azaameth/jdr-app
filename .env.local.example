# Copy to .env.local (gitignored) and fill in with real values.
# Ask the project owner for the Firebase Web App config — Firebase Console →
# Project settings → General → Your apps → SDK setup and configuration.
#
# The app runs fine with this file absent or empty: every repository
# short-circuits to a no-op when Firebase isn't configured (see CLAUDE.md),
# so you can develop against the UI without real credentials — you just
# won't see real data or be able to sign in.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
