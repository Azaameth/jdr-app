<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alésia — Portail de Campagne</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  /* ── Palette sombre épique ── */
  --gold:#D4A843;--gold-l:#F0C96A;--gold-d:#A07820;--gold-pale:rgba(212,168,67,0.10);
  --parch:#0E0C0A;--parch2:#1A1410;
  --ink:#E8D9BC;--ink-m:#B8A888;--ink-l:#7A6A50;
  --surf:#181410;--surf2:#201A14;
  --bord:rgba(212,168,67,0.20);--bord-s:rgba(212,168,67,0.38);
  --red:#C0392B;--red-pale:rgba(192,57,43,0.12);
  --teal:#1A8A6A;--teal-pale:rgba(26,138,106,0.10);
  --blue:#2A5FA8;--blue-pale:rgba(42,95,168,0.10);
  --shadow:0 4px 24px rgba(0,0,0,0.5);
  --radius:8px;--sidebar:215px;
  --bg-image:none;--bg-overlay:rgba(14,12,10,0.0);
  --header-bg:#080604;--nav-bg:#100E0C;--accent:var(--gold);
}
html,body{height:100%;background:#111008;}
body{font-family:'Crimson Pro',Georgia,serif;color:#F2E6CC;display:flex;flex-direction:column;background:#111008;}
body::before{
  content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;
  background-color:#0E0C0A;
  background-image:
    radial-gradient(ellipse at 15% 60%, rgba(100,55,10,0.22) 0%, transparent 55%),
    radial-gradient(ellipse at 85% 15%, rgba(80,40,5,0.18) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 100%, rgba(60,30,5,0.12) 0%, transparent 40%);
}
body::after{display:none;}

::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:#0a0806;}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--gold-d),#6B4A10);border-radius:3px;}
::-webkit-scrollbar-thumb:hover{background:var(--gold);}

/* AUTH */
#auth-overlay{position:fixed;inset:0;background:radial-gradient(ellipse at center,#1a1208 0%,#050402 100%);display:flex;align-items:center;justify-content:center;z-index:1000;flex-direction:column;gap:24px;}
#auth-overlay.hidden{display:none;}
.auth-logo{font-family:'Cinzel',serif;font-size:62.5px;color:var(--gold);letter-spacing:.14em;text-shadow:0 0 40px rgba(212,168,67,.4),0 2px 8px rgba(0,0,0,.8);}
.auth-sub{font-size:23.5px;color:#A09070;font-style:italic;letter-spacing:.05em;}
.btn-google{display:flex;align-items:center;gap:10px;background:#1a1510;color:#F2E6CC;border:1px solid var(--bord-s);border-radius:8px;padding:12px 26px;font-size:23.5px;cursor:pointer;font-family:'Crimson Pro',serif;transition:all .2s;}
.btn-google:hover{border-color:var(--gold);background:#241c0e;box-shadow:0 0 20px rgba(212,168,67,.15);}

/* LAYOUT */
#app{display:flex;flex-direction:column;height:100vh;overflow:hidden;}
#app.hidden{display:none;}
header{
  background:linear-gradient(180deg,#0c0a06 0%,#100d08 100%);
  border-bottom:1px solid var(--gold-d);
  box-shadow:0 2px 20px rgba(0,0,0,.7),0 1px 0 rgba(212,168,67,.15);
  padding:12px 22px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
}
.hdr-title{font-family:'Cinzel',serif;font-size:31.2px;color:var(--gold);letter-spacing:.1em;text-shadow:0 0 20px rgba(212,168,67,.3);}
.hdr-sub{font-size:17.2px;color:#A09070;font-style:italic;letter-spacing:.06em;margin-top:1px;}
.hdr-right{display:flex;align-items:center;gap:10px;}
.user-badge{display:flex;align-items:center;gap:7px;background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.2);border-radius:20px;padding:5px 12px 5px 5px;}
.user-avatar{width:26px;height:26px;border-radius:50%;border:1px solid var(--gold-d);}
.user-name{font-size:18.8px;color:#F0C96A;}
.btn-so{background:none;border:1px solid rgba(212,168,67,.3);color:#A09070;border-radius:6px;padding:4px 10px;font-size:17.2px;cursor:pointer;font-family:'Crimson Pro',serif;transition:all .15s;}
.btn-so:hover{border-color:var(--gold);color:var(--gold);}
.body{display:flex;flex:1;overflow:hidden;background:#111008;}

/* SIDEBAR */
nav{
  width:var(--sidebar);
  background:linear-gradient(180deg,#16120C 0%,#120E08 100%);
  border-right:1px solid rgba(212,168,67,.22);
  box-shadow:2px 0 16px rgba(0,0,0,.5);
  display:flex;flex-direction:column;overflow:visible;flex-shrink:0;
}
.nav-scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:16px 0;min-height:0;}
.nl{
  font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.18em;
  color:#A07820;padding:0 16px 5px;text-transform:uppercase;
  opacity:.9;
}
.ni{display:flex;align-items:center;gap:9px;padding:8px 16px;cursor:pointer;font-size:20.2px;color:#B8A070;border-left:2px solid transparent;transition:all .15s;position:relative;}
.ni:hover{background:rgba(212,168,67,.10);color:#F2E6CC;border-left-color:rgba(212,168,67,.3);}
.ni.active{background:linear-gradient(90deg,rgba(212,168,67,.15),transparent);color:var(--gold-l);border-left-color:var(--gold);font-weight:600;}
.ni i{font-size:21.9px;color:var(--gold-d);opacity:.8;}
.ni.active i{color:var(--gold);opacity:1;}
.ni.active::after{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(180deg,transparent,var(--gold),transparent);border-radius:1px;}
.ndiv{height:1px;background:linear-gradient(90deg,transparent,rgba(212,168,67,.2),transparent);margin:8px 16px;}

/* SIDEBAR FOOTER */
.nav-footer{border-top:1px solid rgba(212,168,67,.2);padding:10px 12px;display:none;flex-direction:column;gap:6px;background:rgba(30,20,8,.4);}
.nav-footer.mj-visible{display:flex;}
.btn-config-nav{display:flex;align-items:center;gap:7px;width:100%;background:none;border:1px dashed rgba(212,168,67,.35);color:#A09070;border-radius:6px;padding:7px 10px;font-family:'Cinzel',serif;font-size:14px;letter-spacing:.08em;cursor:pointer;transition:all .15s;text-transform:uppercase;}
.btn-config-nav:hover{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.06);}
.btn-config-nav i{font-size:20.2px;}
.btn-config-design{display:flex;align-items:center;gap:7px;width:100%;background:none;border:1px dashed rgba(26,138,106,.45);color:#3AAA85;border-radius:6px;padding:7px 10px;font-family:'Cinzel',serif;font-size:14px;letter-spacing:.08em;cursor:pointer;transition:all .15s;text-transform:uppercase;}
.btn-config-design:hover{border-color:var(--teal);background:rgba(26,138,106,.08);}
.btn-config-design i{font-size:20.2px;}

/* MAIN */
main{flex:1;overflow-y:auto;padding:24px 28px;background:#111008;color:#CFC09A;}
.section{display:none;}.section.active{display:block;color:#F2E6CC;}
.page-title{
  font-family:'Cinzel',serif;font-size:25px;color:var(--gold-l);
  margin-bottom:20px;padding-bottom:12px;
  border-bottom:1px solid var(--bord);
  display:flex;align-items:center;gap:9px;
  letter-spacing:.06em;
  text-shadow:0 0 16px rgba(212,168,67,.2);
}
.page-title i{color:var(--gold);opacity:.9;}

/* CARDS */
.card{
  background:linear-gradient(160deg,rgba(38,30,18,0.97),rgba(28,20,12,0.99));
  border:1px solid var(--bord);
  border-radius:var(--radius);
  padding:16px;
  box-shadow:var(--shadow),inset 0 1px 0 rgba(212,168,67,.06);
  color:#CFC09A;
}
.card-title{font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.12em;color:var(--gold-d);margin-bottom:10px;text-transform:uppercase;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.full{grid-column:1/-1;}

/* EDITABLE INLINE */
.ef{cursor:pointer;border-radius:3px;padding:1px 4px;margin:-1px -4px;transition:background .15s;display:inline-block;min-width:20px;border-bottom:1px dashed transparent;}
.ef:hover{background:rgba(212,168,67,.14);border-bottom-color:var(--gold-d);}
.ef-input{font-family:inherit;font-size:inherit;color:#F2E6CC;background:rgba(50,36,16,.9);border:1px solid var(--gold);border-radius:4px;padding:1px 5px;outline:none;width:auto;min-width:40px;}
.ef-area{font-family:'Crimson Pro',serif;font-size:20.2px;color:#CFC09A;background:rgba(50,36,16,.9);border:1px solid var(--gold);border-radius:6px;padding:8px;width:100%;outline:none;resize:vertical;line-height:1.65;display:block;}

/* CHAR TABS */
.char-tabs{display:flex;border-bottom:1px solid var(--bord);margin-bottom:18px;overflow-x:auto;gap:2px;}
.char-tab{padding:9px 16px;cursor:pointer;font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.05em;color:#A09070;border-bottom:2px solid transparent;white-space:nowrap;transition:all .15s;}
.char-tab:hover{color:#F2E6CC;}
.char-tab.active{color:var(--gold);border-bottom-color:var(--gold);text-shadow:0 0 12px rgba(212,168,67,.3);}
.char-sec{display:none;}.char-sec.active{display:block;}

/* STAT BARS */
.stat-row{margin-bottom:10px;}
.stat-head{display:flex;justify-content:space-between;font-size:20.2px;margin-bottom:4px;}
.stat-name{color:#CFC09A;}
.stat-val{font-family:'Cinzel',serif;font-weight:600;color:var(--gold-l);}
.bar{height:6px;background:rgba(255,255,255,.10);border-radius:4px;overflow:hidden;}
.bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--gold-d),var(--gold),var(--gold-l));box-shadow:0 0 8px rgba(212,168,67,.3);transition:width .4s;}

/* PV MANA */
.pv-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.pv-box{background:rgba(50,36,16,.7);border:1px solid var(--bord);border-radius:8px;padding:10px;text-align:center;}
.pv-big{font-family:'Cinzel',serif;font-size:43.8px;font-weight:700;line-height:1;}
.pv-big.pv{color:#E05050;text-shadow:0 0 12px rgba(200,50,50,.3);}
.pv-big.mana{color:#5090E0;text-shadow:0 0 12px rgba(50,100,220,.3);}
.pv-lbl{font-size:17.2px;color:#A09070;margin-top:3px;}
.pv-controls{display:flex;gap:5px;justify-content:center;margin-top:6px;}
.pv-btn{background:rgba(255,255,255,.08);border:1px solid var(--bord-s);color:#CFC09A;border-radius:5px;padding:2px 8px;cursor:pointer;font-size:21.9px;font-weight:600;transition:all .15s;}
.pv-btn:hover{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.08);}

/* BADGES */
.badge{display:inline-block;font-size:15.6px;padding:2px 8px;border-radius:20px;background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.22);color:var(--gold);}
.badge.elem{background:rgba(26,138,106,.1);border-color:rgba(26,138,106,.25);color:#4EC89A;}
.badge.hostile{background:rgba(192,57,43,.1);border-color:rgba(192,57,43,.3);color:#E07070;}
.badge.ally{background:rgba(26,138,106,.1);border-color:rgba(26,138,106,.25);color:#4EC89A;}
.badge.dead{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.1);color:#666;}

/* HERO HEAD */
.hero-head{display:flex;align-items:center;gap:14px;margin-bottom:14px;}
.avatar{width:54px;height:54px;border-radius:50%;border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:31.2px;font-weight:700;color:var(--gold);flex-shrink:0;background:rgba(212,168,67,.08);box-shadow:0 0 16px rgba(212,168,67,.15);}
.hero-name{font-family:'Cinzel',serif;font-size:28.1px;color:#F2E6CC;}
.hero-sub{font-size:20.2px;color:#CFC09A;font-style:italic;margin-top:2px;}
.hero-badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px;}

/* DOTS */
.comp-list{display:flex;flex-direction:column;gap:6px;}
.comp-row{display:flex;justify-content:space-between;align-items:center;font-size:18.8px;padding:4px 0;border-bottom:1px solid rgba(212,168,67,.15);}
.comp-row:last-child{border:none;}
.comp-name{color:#CFC09A;font-size:18.8px;}
.dots{display:flex;gap:3px;}
.dot{width:9px;height:9px;border-radius:50%;border:1px solid rgba(212,168,67,.4);cursor:pointer;transition:all .1s;background:rgba(212,168,67,.06);}
.dot.on{background:var(--gold);border-color:var(--gold);box-shadow:0 0 5px rgba(212,168,67,.4);}

/* SECTION DIVIDER */
.sdiv{font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.14em;color:var(--gold);margin:12px 0 7px;text-transform:uppercase;padding-bottom:4px;border-bottom:1px solid rgba(212,168,67,.15);opacity:.9;}

/* BUTTONS */
.btn-add{display:inline-flex;align-items:center;gap:6px;background:rgba(212,168,67,.07);border:1px solid rgba(212,168,67,.25);color:var(--gold);border-radius:6px;padding:7px 14px;font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.05em;cursor:pointer;transition:all .15s;margin-bottom:14px;}
.btn-add:hover{background:rgba(212,168,67,.14);border-color:var(--gold);box-shadow:0 0 12px rgba(212,168,67,.1);}
.btn-save{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--gold-d),var(--gold));border:none;color:#0a0806;border-radius:6px;padding:7px 16px;font-family:'Cinzel',serif;font-size:17.2px;cursor:pointer;font-weight:700;letter-spacing:.04em;transition:all .15s;}
.btn-save:hover{background:linear-gradient(135deg,var(--gold),var(--gold-l));box-shadow:0 0 16px rgba(212,168,67,.3);}
.btn-cancel{display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);color:#CFC09A;border-radius:6px;padding:7px 14px;font-family:'Cinzel',serif;font-size:17.2px;cursor:pointer;transition:all .15s;}
.btn-cancel:hover{border-color:rgba(255,255,255,.2);color:#F2E6CC;}
.edit-input{font-family:'Crimson Pro',serif;font-size:21.9px;color:#F2E6CC;background:rgba(50,36,16,.9);border:1px solid var(--gold-d);border-radius:6px;padding:6px 10px;width:100%;outline:none;display:block;margin-bottom:8px;}
.edit-input:focus{border-color:var(--gold);}

/* JOURNAL */
.j-card{background:linear-gradient(160deg,rgba(40,30,18,.97),rgba(30,22,12,.99));border:1px solid var(--bord);border-radius:var(--radius);padding:14px;margin-bottom:10px;box-shadow:var(--shadow);color:#CFC09A;}
.j-meta{display:flex;align-items:center;gap:8px;margin-bottom:7px;}
.j-num{font-family:'Cinzel',serif;font-size:15.6px;color:var(--gold);background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.22);border-radius:20px;padding:2px 10px;}
.j-date{font-size:17.2px;color:#907860;}
.j-title{font-family:'Cinzel',serif;font-size:21.9px;color:#F2E6CC;margin-bottom:5px;}
.j-text{font-size:20.2px;color:#B8A070;line-height:1.65;font-style:italic;}

/* PNJ */
.pnj-card{background:linear-gradient(160deg,rgba(40,30,18,.97),rgba(30,22,12,.99));border:1px solid var(--bord);border-radius:var(--radius);padding:12px 14px;display:flex;gap:12px;align-items:flex-start;margin-bottom:10px;box-shadow:var(--shadow);}
.pnj-av{width:44px;height:44px;border-radius:50%;border:1px solid var(--bord-s);display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:21.9px;color:var(--gold);flex-shrink:0;background:rgba(212,168,67,.06);}
.pnj-name{font-family:'Cinzel',serif;font-size:20.2px;color:#F2E6CC;}
.pnj-role{font-size:17.2px;color:#A09070;font-style:italic;margin-top:1px;}
.pnj-desc{font-size:18.8px;color:#B8A070;margin-top:5px;line-height:1.55;}

/* ROYAUMES */
.r-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:10px;}
.r-card{background:linear-gradient(160deg,rgba(22,18,12,.95),rgba(14,12,8,.98));border:1px solid var(--bord);border-radius:var(--radius);padding:12px;transition:border-color .15s;}
.r-card:hover{border-color:rgba(212,168,67,.3);}
.r-name{font-family:'Cinzel',serif;font-size:18.8px;color:#F2E6CC;margin-bottom:4px;}
.r-desc{font-size:18.8px;color:#B8A070;line-height:1.5;}

/* DÉS */
.dice-result{background:linear-gradient(160deg,rgba(40,30,18,.97),rgba(30,22,12,.99));border:1px solid var(--gold-d);border-radius:var(--radius);padding:28px;text-align:center;margin-bottom:16px;box-shadow:0 0 30px rgba(212,168,67,.08),var(--shadow);}
.dice-num{font-family:'Cinzel',serif;font-size:100px;font-weight:700;color:var(--gold);line-height:1;text-shadow:0 0 30px rgba(212,168,67,.4);}
.dice-lbl{font-size:20.2px;color:#A09070;margin-top:6px;font-style:italic;}
.dice-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(74px,1fr));gap:9px;margin-bottom:16px;}
.die-btn{background:rgba(40,30,16,.8);border:1px solid var(--bord);border-radius:var(--radius);padding:12px 8px;cursor:pointer;font-family:'Cinzel',serif;font-size:20.2px;color:#CFC09A;text-align:center;transition:all .15s;}
.die-btn:hover{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.08);box-shadow:0 0 12px rgba(212,168,67,.1);}
.die-btn i{font-size:34.4px;display:block;margin-bottom:3px;color:var(--gold-d);}
.dh-row{display:flex;justify-content:space-between;font-size:18.8px;padding:5px 10px;background:rgba(45,32,14,.7);border:1px solid var(--bord);border-radius:6px;color:#CFC09A;margin-bottom:5px;}
.dh-row span:last-child{font-family:'Cinzel',serif;color:var(--gold);font-weight:600;}

/* NOTES */
#notes-area{width:100%;background:rgba(40,28,12,.85);border:1px solid var(--bord);border-radius:var(--radius);padding:14px;font-family:'Crimson Pro',serif;font-size:21.9px;color:#F2E6CC;resize:vertical;min-height:220px;line-height:1.7;outline:none;}
#notes-area:focus{border-color:var(--gold);box-shadow:0 0 16px rgba(212,168,67,.08);}
.ntags{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px;}
.ntag{font-size:17.2px;padding:3px 10px;border-radius:20px;background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.25);color:#C09030;cursor:pointer;transition:all .15s;}
.ntag:hover{background:rgba(212,168,67,.12);border-color:var(--gold);color:var(--gold);}

/* MJ PANEL */
.mj-banner{background:rgba(192,57,43,.08);border:1px solid rgba(192,57,43,.25);border-radius:8px;padding:8px 14px;font-size:18.8px;color:#E07070;margin-bottom:14px;display:flex;align-items:center;gap:6px;}

/* CUSTOM PAGE */
.custom-page-content{min-height:200px;}
.custom-edit-area{width:100%;background:rgba(22,16,10,.9);border:1px solid var(--bord);border-radius:var(--radius);padding:14px;font-family:'Crimson Pro',serif;font-size:21.9px;color:#F2E6CC;resize:vertical;min-height:300px;line-height:1.7;outline:none;}
.custom-edit-area:focus{border-color:var(--gold);}
.custom-rendered{font-size:21.9px;color:#CFC09A;line-height:1.75;white-space:pre-wrap;}
.custom-toolbar{display:flex;gap:8px;margin-bottom:12px;align-items:center;}
.btn-edit-page{display:inline-flex;align-items:center;gap:5px;background:rgba(212,168,67,.07);border:1px solid rgba(212,168,67,.2);color:var(--gold);border-radius:6px;padding:5px 12px;font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.05em;cursor:pointer;transition:all .15s;}
.btn-edit-page:hover{background:rgba(212,168,67,.14);border-color:var(--gold);}

/* ===== MODALS SHARED ===== */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(3px);z-index:500;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal-box{background:linear-gradient(160deg,#1a1510 0%,#120e0a 100%);border:1px solid var(--bord-s);border-radius:10px;width:520px;max-width:95vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.8),0 0 0 1px rgba(212,168,67,.06);}
.modal-box.wide{width:680px;}
.modal-head{padding:18px 20px 14px;border-bottom:1px solid var(--bord);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.modal-title{font-family:'Cinzel',serif;font-size:20.2px;color:var(--gold);letter-spacing:.08em;}
.modal-close{background:none;border:none;font-size:28.1px;color:#A09070;cursor:pointer;padding:2px 6px;border-radius:4px;line-height:1;transition:all .15s;}
.modal-close:hover{color:#E07070;background:rgba(192,57,43,.12);}
.modal-body{flex:1;overflow-y:auto;padding:16px 20px;}
.modal-foot{padding:14px 20px;border-top:1px solid var(--bord);display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;}

/* NAV EDITOR */
.nav-edit-row{display:flex;align-items:center;gap:8px;background:rgba(20,16,10,.7);border:1px solid var(--bord);border-radius:7px;padding:7px 10px;cursor:grab;transition:all .15s;}
.nav-edit-row.dragging{box-shadow:0 4px 20px rgba(0,0,0,.5);opacity:.85;border-color:var(--gold);}
.nav-edit-row.drag-over{border-color:var(--gold);background:rgba(212,168,67,.06);}
.nav-row-name-input{flex:1;font-family:'Crimson Pro',serif;font-size:20.2px;color:#F2E6CC;background:rgba(50,36,16,.9);border:1px solid var(--gold-d);border-radius:5px;padding:2px 7px;outline:none;}
.nav-row-name-input:focus{border-color:var(--gold);}
.nav-row-actions{display:flex;gap:4px;flex-shrink:0;}
.nav-row-btn{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);color:#A09070;border-radius:5px;padding:2px 6px;cursor:pointer;font-size:18.8px;transition:all .1s;line-height:1.4;}
.nav-row-btn:hover{border-color:var(--gold-d);color:var(--gold);}
.nav-row-btn.del:hover{border-color:#E07070;color:#E07070;background:rgba(192,57,43,.1);}
.nav-row-btn.vis-off{opacity:.4;}
.nav-add-input{flex:1;font-family:'Crimson Pro',serif;font-size:20.2px;color:#F2E6CC;background:rgba(50,36,16,.9);border:1px solid var(--bord);border-radius:6px;padding:6px 10px;outline:none;}
.nav-add-input:focus{border-color:var(--gold);}

/* ===== DESIGN EDITOR ===== */
.design-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.design-section{margin-bottom:18px;}
.design-label{font-family:'Cinzel',serif;font-size:14px;letter-spacing:.12em;color:var(--gold-d);margin-bottom:8px;text-transform:uppercase;display:flex;align-items:center;gap:6px;}
.design-label i{font-size:18.8px;}
.color-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;padding:6px 10px;background:rgba(20,16,10,.6);border:1px solid var(--bord);border-radius:7px;}
.color-label{font-size:18.8px;color:#CFC09A;flex:1;}
.color-swatch{width:28px;height:28px;border-radius:6px;border:1px solid var(--bord-s);cursor:pointer;flex-shrink:0;position:relative;overflow:hidden;}
.color-swatch input[type=color]{position:absolute;inset:-4px;width:calc(100%+8px);height:calc(100%+8px);opacity:0;cursor:pointer;border:none;padding:0;}
.color-preview{width:100%;height:100%;border-radius:4px;}
.img-upload-zone{border:2px dashed var(--bord);border-radius:10px;padding:16px;text-align:center;cursor:pointer;transition:all .2s;background:rgba(20,16,10,.5);position:relative;overflow:hidden;}
.img-upload-zone:hover{border-color:var(--gold);background:rgba(212,168,67,.04);}
.img-upload-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.img-upload-zone .upload-icon{font-size:43.8px;color:var(--gold-d);margin-bottom:6px;}
.img-upload-zone .upload-text{font-size:18.8px;color:#A09070;font-style:italic;}
.img-preview{width:100%;max-height:120px;object-fit:cover;border-radius:8px;margin-top:8px;display:none;}
.img-preview.visible{display:block;}
.preset-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:4px;}
.preset-btn{border:1px solid var(--bord);border-radius:7px;padding:8px 4px;cursor:pointer;text-align:center;transition:all .15s;background:rgba(20,16,10,.5);}
.preset-btn:hover{border-color:var(--gold);transform:translateY(-1px);}
.preset-btn.active{border-color:var(--gold);box-shadow:0 0 12px rgba(212,168,67,.15);}
.preset-swatch{width:100%;height:28px;border-radius:5px;margin-bottom:4px;}
.preset-name{font-family:'Cinzel',serif;font-size:14px;letter-spacing:.06em;color:#CFC09A;}
.range-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.range-row label{font-size:18.8px;color:#CFC09A;width:100px;flex-shrink:0;}
.range-row input[type=range]{flex:1;accent-color:var(--gold);}
.range-row span{font-family:'Cinzel',serif;font-size:17.2px;color:var(--gold);width:36px;text-align:right;}

/* ===== TOAST ===== */
#toast{position:fixed;bottom:20px;right:20px;background:linear-gradient(135deg,#1a1510,#0e0c08);color:var(--gold);border:1px solid var(--gold-d);border-radius:8px;padding:10px 18px;font-family:'Cinzel',serif;font-size:18.8px;letter-spacing:.05em;opacity:0;transform:translateY(10px);transition:all .3s;z-index:999;pointer-events:none;box-shadow:0 4px 20px rgba(0,0,0,.6),0 0 16px rgba(212,168,67,.1);}
#toast.show{opacity:1;transform:translateY(0);}

@keyframes rollA{0%{transform:scale(.5) rotate(-10deg);opacity:0}60%{transform:scale(1.15) rotate(2deg)}100%{transform:scale(1) rotate(0);opacity:1}}
.roll-anim{animation:rollA .4s ease-out;}

/* ===== 12 ROYAUMES — CERCLE ===== */
.royaumes-layout{display:grid;grid-template-columns:340px 1fr;gap:20px;align-items:start;}
.cercle-wrap{position:relative;display:flex;justify-content:center;}
.cercle-container{
  position:relative;width:320px;height:320px;
}
.ile-coeur{
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:80px;height:80px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(212,168,67,.2),rgba(212,168,67,.04));
  border:2px solid rgba(212,168,67,.4);
  box-shadow:0 0 30px rgba(212,168,67,.15),0 0 60px rgba(212,168,67,.06);
  display:flex;align-items:center;justify-content:center;
  z-index:2;
  animation:pulseIle 3s ease-in-out infinite;
}
.ile-inner{text-align:center;}
@keyframes pulseIle{
  0%,100%{box-shadow:0 0 20px rgba(212,168,67,.15),0 0 50px rgba(212,168,67,.06);}
  50%{box-shadow:0 0 35px rgba(212,168,67,.3),0 0 80px rgba(212,168,67,.1);}
}
/* Cercle de fond */
.cercle-container::before{
  content:'';position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:280px;height:280px;
  border-radius:50%;
  border:1px dashed rgba(212,168,67,.15);
}
.cercle-container::after{
  content:'';position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:200px;height:200px;
  border-radius:50%;
  border:1px dashed rgba(212,168,67,.08);
}
/* Nœud de royaume */
.royaume-node{
  position:absolute;
  width:52px;height:52px;
  border-radius:50%;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;
  gap:2px;
  border:2px solid rgba(212,168,67,.25);
  background:rgba(30,22,10,.9);
  transition:all .2s;
  transform:translate(-50%,-50%);
  z-index:3;
}
.royaume-node:hover{
  transform:translate(-50%,-50%) scale(1.18);
  border-color:var(--gold);
  box-shadow:0 0 16px rgba(212,168,67,.3);
  z-index:4;
}
.royaume-node.active{
  border-color:var(--gold);
  box-shadow:0 0 20px rgba(212,168,67,.4);
  background:rgba(50,36,14,.95);
  transform:translate(-50%,-50%) scale(1.15);
}
.royaume-node.hostile{border-color:rgba(192,57,43,.4);}
.royaume-node.hostile:hover,.royaume-node.hostile.active{border-color:#E07070;box-shadow:0 0 16px rgba(192,57,43,.3);}
.royaume-node.ally{border-color:rgba(74,122,40,.4);}
.royaume-node.ally:hover,.royaume-node.ally.active{border-color:#80C050;box-shadow:0 0 16px rgba(74,122,40,.3);}
.royaume-node.secret{border-color:rgba(106,74,186,.4);}
.royaume-node.secret:hover,.royaume-node.secret.active{border-color:#A080E0;box-shadow:0 0 16px rgba(106,74,186,.3);}
.node-icon{font-size:25px;line-height:1;}
.node-label{
  font-family:'Cinzel',serif;font-size:9.4px;letter-spacing:.04em;
  color:#907860;text-align:center;line-height:1.2;
  max-width:46px;overflow:hidden;
  white-space:nowrap;text-overflow:ellipsis;
}
.royaume-node:hover .node-label,.royaume-node.active .node-label{color:var(--gold);}
/* Ligne de connexion (svg) */
.cercle-svg{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;}

/* Carte détail du royaume */
.royaume-card-wrap{min-height:320px;display:flex;align-items:stretch;}
.royaume-card{
  flex:1;
  background:linear-gradient(160deg,rgba(38,28,12,.98),rgba(26,18,8,.99));
  border:1px solid rgba(212,168,67,.2);
  border-radius:10px;
  overflow:hidden;
  display:flex;flex-direction:column;
  box-shadow:0 4px 24px rgba(0,0,0,.4);
}
.royaume-card-empty{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:40px;
}
.royaume-card-img{
  width:100%;height:160px;object-fit:cover;display:block;
  border-bottom:1px solid rgba(212,168,67,.15);
}
.royaume-card-img-placeholder{
  width:100%;height:160px;
  background:linear-gradient(135deg,rgba(30,20,8,.8),rgba(20,12,4,.9));
  display:flex;align-items:center;justify-content:center;
  border-bottom:1px solid rgba(212,168,67,.12);
}
.royaume-card-body{padding:18px 20px;flex:1;}
.royaume-card-name{
  font-family:'Cinzel',serif;font-size:25px;color:#F2E6CC;
  letter-spacing:.05em;margin-bottom:4px;
}
.royaume-card-type{font-size:17.2px;color:#907860;font-style:italic;margin-bottom:12px;}
.royaume-card-desc{font-size:20.2px;color:#CFC09A;line-height:1.75;margin-bottom:14px;}
.royaume-card-footer{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 20px;
  border-top:1px solid rgba(212,168,67,.1);
  background:rgba(0,0,0,.15);
}
@keyframes cardIn{
  from{opacity:0;transform:translateX(10px);}
  to{opacity:1;transform:translateX(0);}
}
.royaume-card-anim{animation:cardIn .25s ease-out;}

/* ===== PAGE D'ACCUEIL ===== */
.home-hero{max-width:640px;margin:10px auto 0;text-align:center;}
.home-hero .home-emblem{font-size:38px;color:var(--gold);margin-bottom:10px;}
.home-hero h1{font-family:'Cinzel',serif;font-size:36px;letter-spacing:.1em;color:var(--gold);margin-bottom:12px;}
.home-hero p{font-size:16px;color:#CFC09A;line-height:1.8;}
.home-map-outer{display:flex;justify-content:center;padding:100px 0 100px;}
.home-map-scale{transform:scale(1.6);transform-origin:center;}
.home-hint{text-align:center;font-size:13.5px;color:#907860;font-style:italic;margin-top:0;}
.hdr-left-clickable{cursor:pointer;transition:opacity .15s;}
.hdr-left-clickable:hover{opacity:.75;}
.royaume-region{pointer-events:auto;cursor:pointer;transition:filter .15s, opacity .15s;}
.royaume-region:hover{filter:brightness(1.4);}

/* ===== PORTAIL D'ENTRÉE (double porte) ===== */
.portal-wrap{position:relative;width:95vw;max-width:2200px;max-height:94vh;margin:0 auto;aspect-ratio:1600/900;perspective:1800px;cursor:pointer;border-radius:12px;overflow:visible;box-shadow:0 10px 40px rgba(0,0,0,.5);}
.portal-door{position:absolute;top:0;width:50%;height:100%;background-repeat:no-repeat;background-size:200% 100%;transition:transform 1.1s cubic-bezier(.65,0,.35,1), box-shadow 1.1s;backface-visibility:hidden;border-radius:12px;}
.portal-door-left{left:0;background-position:left top;transform-origin:left center;border-top-right-radius:0;border-bottom-right-radius:0;box-shadow:6px 0 20px rgba(0,0,0,.4) inset;}
.portal-door-right{right:0;background-position:right top;transform-origin:right center;border-top-left-radius:0;border-bottom-left-radius:0;box-shadow:-6px 0 20px rgba(0,0,0,.4) inset;}
.portal-wrap.open .portal-door-left{transform:rotateY(-120deg);box-shadow:none;}
.portal-wrap.open .portal-door-right{transform:rotateY(120deg);box-shadow:none;}
.portal-hint{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);color:#F2E6CC;font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;background:rgba(10,7,3,.6);border:1px solid rgba(212,168,67,.35);padding:7px 18px;border-radius:20px;pointer-events:none;transition:opacity .4s;z-index:5;}
.portal-wrap.open .portal-hint{opacity:0;}
.portal-wrap.portal-done{display:none;}
.home-content{opacity:0;max-height:0;overflow:hidden;transition:opacity .8s ease .4s;}
.home-content.show{opacity:1;max-height:none;overflow:visible;}

/* Mode portail : masque toute l'interface tant que les portes ne sont pas ouvertes */
#app.portal-mode header,
#app.portal-mode nav#main-nav{display:none;}
#app.portal-mode .body{overflow:visible;}
#app.portal-mode main{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:8px;background:#0a0704;}
#app.portal-mode .page-title{display:none;}

/* ===== CLASSEUR ===== */
.classeur-wrap{
  background:linear-gradient(160deg,rgba(30,22,12,.98),rgba(20,14,8,.99));
  border:1px solid rgba(212,168,67,.22);
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 8px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(212,168,67,.06);
}
/* Rangée d'intercalaires */
.classeur-tabs{
  display:flex;
  flex-wrap:wrap;
  gap:3px;
  padding:10px 10px 0;
  background:rgba(0,0,0,.25);
  border-bottom:2px solid rgba(212,168,67,.2);
  position:relative;
}
.classeur-tab{
  display:flex;align-items:center;gap:6px;
  padding:8px 14px;
  border-radius:8px 8px 0 0;
  cursor:pointer;
  font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.06em;
  color:#907860;
  background:rgba(30,22,10,.6);
  border:1px solid rgba(212,168,67,.15);
  border-bottom:none;
  transition:all .2s;
  position:relative;
  bottom:-2px;
  white-space:nowrap;
}
.classeur-tab:hover{
  background:rgba(50,36,14,.8);
  color:#CFC09A;
  border-color:rgba(212,168,67,.3);
  transform:translateY(-2px);
}
.classeur-tab.active{
  background:linear-gradient(160deg,rgba(50,36,14,.98),rgba(38,28,10,.99));
  color:var(--gold);
  border-color:rgba(212,168,67,.4);
  border-bottom:2px solid rgba(50,36,14,.98);
  z-index:2;
  transform:translateY(0);
}
.classeur-tab.active::before{
  content:'';position:absolute;bottom:-2px;left:0;right:0;height:2px;
  background:linear-gradient(160deg,rgba(50,36,14,.98),rgba(38,28,10,.99));
}
.tab-icon{font-size:20.2px;}
.tab-label{font-size:15.6px;}

/* Corps du classeur (fiches) */
.classeur-body{padding:0;min-height:320px;position:relative;}

/* Fiche individuelle */
.fiche{
  display:none;
  padding:24px 28px;
  animation:ficheIn .25s ease-out;
}
.fiche.active{display:block;}
@keyframes ficheIn{
  from{opacity:0;transform:translateY(6px);}
  to{opacity:1;transform:translateY(0);}
}

/* En-tête de fiche */
.fiche-header{
  display:flex;align-items:center;gap:16px;margin-bottom:16px;
}
.fiche-stamp{
  width:50px;height:50px;border-radius:50%;
  border:2px solid rgba(212,168,67,.35);
  background:rgba(212,168,67,.08);
  display:flex;align-items:center;justify-content:center;
  font-size:34.4px;flex-shrink:0;
}
.fiche-title{
  font-family:'Cinzel',serif;font-size:28.1px;color:#F2E6CC;
  letter-spacing:.04em;
}
.fiche-sub{font-size:18.8px;color:#907860;font-style:italic;margin-top:3px;}
.fiche-divider{
  height:1px;
  background:linear-gradient(90deg,rgba(212,168,67,.4),transparent);
  margin-bottom:16px;
}
.fiche-text{
  font-size:21.9px;color:#CFC09A;line-height:1.8;
  margin-bottom:18px;
  font-style:italic;
  border-left:2px solid rgba(212,168,67,.2);
  padding-left:14px;
}
.fiche-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;
}
.fiche-cell{
  background:rgba(45,32,14,.6);
  border:1px solid rgba(212,168,67,.12);
  border-radius:7px;padding:10px 14px;
}
.fiche-cell-label{
  font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.12em;
  color:var(--gold-d);text-transform:uppercase;margin-bottom:5px;opacity:.9;
}
.fiche-cell-val{font-size:20.2px;color:#CFC09A;line-height:1.5;}

/* ===== VITRUVE JDR STYLE ===== */
.vitruve-layout{display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start;min-width:0;}
.vitruve-layout > *{min-width:0;}
.vitruve-sheet{background:linear-gradient(165deg,#1C1408 0%,#120E06 60%,#1A1208 100%);border:1px solid rgba(212,168,67,.28);border-radius:6px;padding:14px;box-shadow:0 8px 40px rgba(0,0,0,.6);}
.vit-header{text-align:center;padding-bottom:10px;margin-bottom:10px;border-bottom:1px solid rgba(212,168,67,.18);}
.vit-name{font-family:'Cinzel',serif;font-size:23.5px;color:#F0E4C8;letter-spacing:.06em;}
.vit-sub{font-size:17.2px;color:#907060;font-style:italic;margin-top:3px;}
.vitals-strip{display:flex;gap:8px;margin-bottom:10px;}
.vpill{flex:1;background:rgba(0,0,0,.3);border:1px solid rgba(212,168,67,.18);border-radius:5px;padding:6px 8px;text-align:center;}
.vbig{font-family:'Cinzel',serif;font-size:34.4px;font-weight:700;line-height:1;}
.vbig.pv{color:#E05050;}
.vbig.mana{color:#5090E0;}
.vlbl{font-size:14px;color:#706050;margin-top:1px;font-family:'Cinzel',serif;letter-spacing:.05em;}
.vbtns{display:flex;gap:3px;justify-content:center;margin-top:3px;}
.vbtn{background:none;border:1px solid rgba(212,168,67,.18);color:#706050;border-radius:3px;padding:1px 7px;cursor:pointer;font-size:18.8px;font-weight:600;}
.vbtn:hover{border-color:#D4A843;color:#D4A843;}
.vitruve-illo{position:relative;width:100%;aspect-ratio:1/1;background:rgba(0,0,0,.2);border:1px solid rgba(212,168,67,.12);border-radius:4px;overflow:hidden;margin-bottom:10px;}
.vitruve-illo svg{width:100%;height:100%;}
/* Zones cliquables dans le SVG */
.vzone{cursor:pointer;transition:opacity .15s;}
.vzone:hover{opacity:.7;}
.vzone.active ellipse,.vzone.active rect,.vzone.active path{fill:rgba(212,168,67,.2) !important;stroke:rgba(212,168,67,.8) !important;}
.vstat-bars{display:flex;flex-direction:column;gap:5px;}
.vstat-line{display:flex;align-items:center;gap:8px;}
.vstat-name{color:#907060;width:55px;font-family:'Cinzel',serif;font-size:14px;letter-spacing:.05em;text-transform:uppercase;}
.vstat-bar{flex:1;height:5px;background:rgba(255,255,255,.06);border-radius:3px;overflow:hidden;}
.vstat-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#8B6914,#D4A843);}
.vstat-val{color:#D4A843;font-family:'Cinzel',serif;font-size:14px;min-width:28px;text-align:right;}
.btn-edit-raw{display:flex;align-items:center;gap:6px;background:none;border:1px solid rgba(212,168,67,.2);color:#906840;border-radius:5px;padding:5px 10px;font-family:'Cinzel',serif;font-size:14px;letter-spacing:.06em;cursor:pointer;text-transform:uppercase;}
.btn-edit-raw:hover{border-color:rgba(212,168,67,.5);color:#D4A843;}
/* Panneau info */
.vit-portrait{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:rgba(212,168,67,.25);font-size:100px;}
.pchar-tabs{display:flex;gap:4px;border-bottom:1px solid rgba(212,168,67,.18);margin-bottom:14px;flex-wrap:wrap;}
.pchar-tab{padding:8px 14px;cursor:pointer;font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.06em;color:#A09070;border-bottom:2px solid transparent;display:flex;align-items:center;gap:6px;transition:all .15s;}
.pchar-tab:hover{color:#F2E6CC;}
.pchar-tab.active{color:var(--gold);border-bottom-color:var(--gold);}
.pchar-tab.furm-tab.active{color:#7FBF7A;border-bottom-color:#7FBF7A;}
.icard{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(45,30,10,.5);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:12px 8px;text-align:center;min-height:74px;}
.icard i{font-size:31.2px;color:var(--gold);}
.icard .icard-lbl{font-size:17.2px;color:#E0D8C8;line-height:1.3;}
.icard .icard-sub{font-size:15.6px;color:#907860;}
.icard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:8px;}
.vpanel{background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(22,16,8,.99));border:1px solid rgba(212,168,67,.18);border-radius:8px;padding:18px;min-height:420px;display:flex;flex-direction:column;}
.vpanel-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#604A28;}
.vpanel-content{flex:1;}
.vpanel-head{font-family:'Cinzel',serif;font-size:20.2px;color:#D4A843;letter-spacing:.05em;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid rgba(212,168,67,.15);display:flex;align-items:center;gap:7px;}
.vpanel-item{margin-bottom:7px;padding:7px 11px;background:rgba(45,30,10,.6);border-radius:5px;border-left:2px solid rgba(160,120,32,.5);}
.vpanel-lbl{font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.1em;color:#A07820;text-transform:uppercase;margin-bottom:3px;}
.vpanel-val{font-size:18.8px;color:#CFC09A;line-height:1.55;}
.vpanel-edit{margin-top:12px;display:inline-flex;align-items:center;gap:5px;background:none;border:1px solid rgba(212,168,67,.2);color:#906840;border-radius:5px;padding:5px 10px;font-family:'Cinzel',serif;font-size:14px;cursor:pointer;text-transform:uppercase;}
.vpanel-edit:hover{border-color:rgba(212,168,67,.5);color:#D4A843;}
.vsubhead{font-family:'Cinzel',serif;font-size:14px;letter-spacing:.12em;color:#A07820;text-transform:uppercase;margin:14px 0 8px;}
.vsubhead:first-child{margin-top:0;}
.vcard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px;margin-bottom:6px;}
.vcard{background:rgba(45,30,10,.6);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:11px 12px;}
.vcard.center{text-align:center;}
.vcard-icon{font-size:32.8px;margin-bottom:6px;color:#A07820;}
.vcard.center .vcard-icon{display:block;}
.vcard-lbl{font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.1em;color:#A07820;text-transform:uppercase;margin-bottom:3px;}
.vcard-val{font-size:18.8px;color:#F2E6CC;line-height:1.4;}
.vcard-sub{font-size:17.2px;color:#A07820;margin-top:4px;}
.vcard-row{display:flex;align-items:center;gap:8px;margin-bottom:4px;}
.vcard-row .ti{font-size:26.5px;color:#D4A843;flex-shrink:0;}
.vpills{display:flex;gap:6px;flex-wrap:wrap;}
.vpill{background:rgba(212,168,67,.1);border:1px solid rgba(212,168,67,.25);border-radius:14px;padding:3px 10px;font-size:18.8px;color:#F2E6CC;}
.vbar-row{margin-bottom:10px;}
.vbar-top{display:flex;justify-content:space-between;font-size:17.2px;color:#CFC09A;margin-bottom:3px;}
.vbar-top span:last-child{color:#D4A843;}
.vbar-track{height:6px;background:rgba(212,168,67,.1);border-radius:3px;overflow:hidden;}
.vbar-fill{height:100%;background:#D4A843;}
.vbm{border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:8px;}
.vbm.bonus{background:rgba(74,160,80,.08);border:1px solid rgba(74,160,80,.25);}
.vbm.malus{background:rgba(160,60,50,.08);border:1px solid rgba(160,60,50,.25);}
.vbm .ti{font-size:25px;flex-shrink:0;}
.vbm.bonus .ti,.vbm.bonus .vbm-val{color:#5FAE5A;}
.vbm.malus .ti,.vbm.malus .vbm-val{color:#D47A6A;}
.vbm-lbl{font-size:18.8px;color:#E0E0D8;}
.vbm-val{font-size:17.2px;}
.race-wheel{position:relative;height:320px;display:flex;align-items:center;justify-content:center;overflow:hidden;perspective:1200px;margin-bottom:16px;}
.race-wheel.tall{height:calc(100vh - 220px);min-height:520px;}
.race-track{position:relative;width:100%;height:100%;}
.race-card{position:absolute;top:50%;left:50%;width:240px;background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(22,16,8,.99));border:1px solid rgba(212,168,67,.22);border-radius:12px;padding:18px;transition:transform .4s ease,opacity .4s ease;cursor:pointer;}
.race-card .rimg{width:100%;height:200px;object-fit:cover;border-radius:8px;margin-bottom:10px;border:1px solid rgba(212,168,67,.2);}
.race-card .rn{font-family:'Cinzel',serif;font-size:26.5px;color:#F2E6CC;text-align:center;letter-spacing:.04em;}
.race-card .rs{font-size:17.2px;font-style:italic;color:#CFC09A;text-align:center;margin:2px 0 12px;}
.race-card .rgrp{font-size:14px;font-weight:600;margin-bottom:5px;text-transform:uppercase;letter-spacing:.1em;}
.race-card .ritem{font-size:18.8px;color:#CFC09A;margin-bottom:3px;line-height:1.4;}
.race-card .rbox{border-radius:8px;padding:8px 10px;margin-bottom:8px;}
.race-card .rbox.bon{background:var(--teal-pale);border:1px solid rgba(29,107,90,.25);}
.race-card .rbox.mal{background:var(--red-pale);border:1px solid rgba(139,32,32,.25);}
.race-card .rbox.bon .rgrp{color:var(--teal);}
.race-card .rbox.mal .rgrp{color:var(--red);}
.race-arrow{background:rgba(45,30,10,.7);border:1px solid rgba(212,168,67,.25);color:var(--gold);width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:25px;z-index:10;flex-shrink:0;}
.race-arrow:hover{border-color:var(--gold);background:rgba(212,168,67,.1);}
.race-dots{display:flex;justify-content:center;gap:8px;margin-top:20px;margin-bottom:14px;flex-wrap:wrap;}
.race-dot{width:11px;height:11px;border-radius:50%;background:rgba(212,168,67,.18);border:1px solid rgba(212,168,67,.3);cursor:pointer;transition:background .2s;}
.race-dot.active{background:var(--gold);}
.book-wrap{display:flex;align-items:center;justify-content:center;min-height:480px;perspective:1600px;}
.book-cover{width:340px;height:460px;background:linear-gradient(160deg,#2A1A0A,#1A0F06);border:3px solid var(--gold-d);border-radius:6px 14px 14px 6px;box-shadow:0 12px 40px rgba(0,0,0,.6),inset 0 0 30px rgba(212,168,67,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:transform .3s;position:relative;}
.book-cover:hover{transform:translateY(-6px) scale(1.01);}
.book-cover::before{content:'';position:absolute;inset:14px;border:1px solid rgba(212,168,67,.35);border-radius:4px 10px 10px 4px;}
.book-cover .bc-title{font-family:'Cinzel',serif;font-size:53.1px;letter-spacing:.12em;color:var(--gold);text-shadow:0 0 14px rgba(212,168,67,.4);}
.book-cover .bc-sub{font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.2em;color:var(--gold-d);text-transform:uppercase;margin-top:10px;}
.book-cover .bc-emblem{font-size:71.9px;color:var(--gold-d);margin-bottom:18px;opacity:.8;}
.book-cover .bc-hint{position:absolute;bottom:24px;font-size:17.2px;color:#8A6F40;font-style:italic;}
.book-page{width:100%;max-width:780px;background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(20,14,7,.99));border:1px solid var(--bord);border-radius:8px;padding:34px 44px;box-shadow:0 10px 36px rgba(0,0,0,.5);animation:pageIn .35s ease;}
@keyframes pageIn{from{opacity:0;transform:rotateY(-8deg);}to{opacity:1;transform:rotateY(0);}}
.book-page .bp-num{font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.15em;color:var(--gold-d);text-transform:uppercase;text-align:center;margin-bottom:6px;}
.book-page .bp-title{font-family:'Cinzel',serif;font-size:28.1px;color:var(--gold);text-align:center;margin-bottom:18px;letter-spacing:.04em;}
.book-page .bp-text{font-size:20.2px;color:#CFC09A;line-height:1.85;}
.book-page .bp-text.prophecy{font-size:21.9px;color:#F2E6CC;font-style:italic;text-align:center;line-height:2;}
.book-nav{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:18px;}
.book-nav .race-arrow{position:static;}
.book-close{font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.15em;color:var(--gold-d);text-transform:uppercase;text-align:center;margin-top:14px;cursor:pointer;}
.book-close:hover{color:var(--gold);}
.book-spread{position:relative;display:flex;width:100%;max-width:920px;min-height:480px;margin:0 auto;perspective:2400px;}
.book-half{flex:1;background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(20,14,7,.99));border:1px solid var(--bord);box-sizing:border-box;padding:32px 38px;overflow:hidden;}
.book-half.left{border-radius:8px 0 0 8px;border-right:none;}
.book-half.right{border-radius:0 8px 8px 0;}
.book-spine{width:14px;flex-shrink:0;background:linear-gradient(90deg,rgba(0,0,0,.45),rgba(0,0,0,0) 35%,rgba(0,0,0,0) 65%,rgba(0,0,0,.45));z-index:5;pointer-events:none;}
.book-flip{position:absolute;top:0;width:calc(50% - 7px);height:100%;background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(20,14,7,.99));border:1px solid var(--bord);box-sizing:border-box;padding:32px 38px;backface-visibility:hidden;transform-style:preserve-3d;z-index:10;transition:transform .7s cubic-bezier(.45,.05,.55,.95);box-shadow:0 0 40px rgba(0,0,0,.6);transform:rotateY(0deg);}
.book-flip.right-flip{left:calc(50% + 7px);border-radius:0 8px 8px 0;transform-origin:left center;}
.book-flip.left-flip{left:0;border-radius:8px 0 0 8px;transform-origin:right center;}
@media (max-width:700px){.book-spread{flex-direction:column;min-height:auto;}.book-half{border-radius:8px;border:1px solid var(--bord);}.book-half.left{margin-bottom:8px;}.book-spine{display:none;}.book-flip{display:none;}}
.tuto-wrap{display:flex;gap:24px;align-items:flex-start;}
.tuto-mascot{flex-shrink:0;width:150px;}
.tuto-bubble{flex:1;background:linear-gradient(160deg,rgba(35,25,10,.98),rgba(20,14,7,.99));border:1px solid var(--bord);border-radius:8px;padding:22px 26px;position:relative;min-height:160px;animation:pageIn .35s ease;}
.tuto-bubble::before{content:'';position:absolute;left:-14px;top:38px;border:10px solid transparent;border-right-color:var(--bord);}
.tuto-bubble::after{content:'';position:absolute;left:-12px;top:38px;border:10px solid transparent;border-right-color:#241608;}
.tuto-num{font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.15em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;}
.tuto-title{font-family:'Cinzel',serif;font-size:26.5px;color:var(--gold);margin-bottom:12px;}
.tuto-nav{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:18px;}
@media (max-width:640px){.tuto-wrap{flex-direction:column;align-items:center;}.tuto-bubble::before,.tuto-bubble::after{display:none;}}
.adv-vessel{display:flex;align-items:stretch;height:90px;border-radius:14px;overflow:hidden;border:2px solid var(--gold-d);box-shadow:0 8px 28px rgba(0,0,0,.4);margin:24px 0;}
.adv-side{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:flex-grow .4s ease;min-width:0;overflow:hidden;white-space:nowrap;}
.adv-side.aventure{background:linear-gradient(135deg,#2E7D32,#1B5E20);}
.adv-side.mesaventure{background:linear-gradient(135deg,#C0392B,#7B241C);}
.adv-side .adv-num{font-family:'Cinzel',serif;font-size:56.2px;color:#fff;line-height:1;}
.adv-side .adv-lbl{font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.15em;color:rgba(255,255,255,.85);text-transform:uppercase;margin-top:4px;}
.adv-divider{width:3px;background:var(--gold);}
.adv-dice-row{display:flex;justify-content:center;gap:10px;margin-top:18px;}
.adv-die{width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:25px;border:2px solid;transition:all .3s;}
.adv-die.on-aventure{background:rgba(46,125,50,.18);border-color:#2E7D32;color:#9CDC9C;}
.adv-die.on-mesaventure{background:rgba(192,57,43,.18);border-color:#C0392B;color:#F0B0A6;}
.adv-controls{display:flex;justify-content:center;gap:12px;margin-top:18px;}
/* Furmiaou */
.furm-layout{display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start;}

</style>
</head>
<body>

<div id="auth-overlay">
  <div class="auth-logo">⚔ Alésia</div>
  <div class="auth-sub">Portail de campagne — Réservé aux Téméraires</div>
  <button class="btn-google" onclick="signIn()">
    <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
    Se connecter avec Google
  </button>
</div>

<div id="app" class="hidden portal-mode">
  <header>
    <div class="hdr-left-clickable" onclick="goHome()" title="Retour à l'accueil"><div class="hdr-title" id="site-title">⚔ Alésia</div><div class="hdr-sub" id="site-subtitle">Portail de campagne</div></div>
    <div class="hdr-right">
      <div class="user-badge"><img id="uav" class="user-avatar" src="" alt=""><span id="uname" class="user-name"></span></div>
      <button class="btn-so" onclick="doSignOut()">Déconnexion</button>
    </div>
  </header>
  <div class="body">
    <nav id="main-nav">
      <div class="nav-scroll" id="nav-scroll"></div>
      <div class="nav-footer" id="nav-footer">
        <button class="btn-config-nav" onclick="openNavEditor()">
          <i class="ti ti-settings"></i> Configurer le menu
        </button>
        <button class="btn-config-design" onclick="openDesignEditor()">
          <i class="ti ti-palette"></i> Personnaliser le design
        </button>
      </div>
    </nav>
    <main id="main-content">

      <div id="s-accueil" class="section active">
        <div class="portal-wrap" id="portal-wrap" onclick="openPortal()">
          <div class="portal-door portal-door-left" style="background-image:url(xxx)"></div>
          <div class="portal-door portal-door-right" style="background-image:url(xxx)"></div>
          <div class="portal-hint"><i class="ti ti-door-enter" style="margin-right:6px;"></i>Cliquez pour entrer</div>
        </div>
        <div class="home-content" id="home-content">
        <div class="home-hero">
          <div class="home-emblem"><i class="ti ti-sparkles"></i></div>
          <h1>Bienvenue sur Alésia</h1>
          <p>Douze royaumes gravitent autour d'un lac sacré et de l'Île du Cœur, dernier mystère d'un monde en équilibre fragile. Explorez les nations, leurs alliances et leurs secrets — ou cliquez sur un royaume pour découvrir son histoire.</p>
        </div>
        <div class="home-map-outer">
          <div class="home-map-scale">
            <div class="cercle-container" id="home-cercle-container">
              <svg class="cercle-svg" viewBox="0 0 320 320">
                <circle cx="160" cy="160" r="58" fill="rgba(58,120,168,.16)" stroke="rgba(58,120,168,.35)" stroke-width="1.5"/>
                <path d="M124.5,12.2 A152,152 0 0,1 195.5,12.2 L173.5,103.6 A58,58 0 0,0 146.5,103.6 Z" fill="rgba(74,122,40,.28)" stroke="rgba(74,122,40,.5)" stroke-width="1.5" class="royaume-region" data-idx="0"/>
                <path d="M203.2,14.3 A152,152 0 0,1 264.6,49.7 L199.9,117.9 A58,58 0 0,0 176.5,104.4 Z" fill="rgba(74,122,40,.28)" stroke="rgba(74,122,40,.5)" stroke-width="1.5" class="royaume-region" data-idx="1"/>
                <path d="M270.3,55.4 A152,152 0 0,1 305.7,116.8 L215.6,143.5 A58,58 0 0,0 202.1,120.1 Z" fill="rgba(74,122,40,.28)" stroke="rgba(74,122,40,.5)" stroke-width="1.5" class="royaume-region" data-idx="2"/>
                <path d="M307.8,124.5 A152,152 0 0,1 307.8,195.5 L216.4,173.5 A58,58 0 0,0 216.4,146.5 Z" fill="rgba(106,74,186,.28)" stroke="rgba(106,74,186,.5)" stroke-width="1.5" class="royaume-region" data-idx="3"/>
                <path d="M305.7,203.2 A152,152 0 0,1 270.3,264.6 L202.1,199.9 A58,58 0 0,0 215.6,176.5 Z" fill="rgba(212,168,67,.16)" stroke="rgba(212,168,67,.3)" stroke-width="1.5" class="royaume-region" data-idx="4"/>
                <path d="M264.6,270.3 A152,152 0 0,1 203.2,305.7 L176.5,215.6 A58,58 0 0,0 199.9,202.1 Z" fill="rgba(212,168,67,.16)" stroke="rgba(212,168,67,.3)" stroke-width="1.5" class="royaume-region" data-idx="5"/>
                <path d="M195.5,307.8 A152,152 0 0,1 124.5,307.8 L146.5,216.4 A58,58 0 0,0 173.5,216.4 Z" fill="rgba(212,168,67,.16)" stroke="rgba(212,168,67,.3)" stroke-width="1.5" class="royaume-region" data-idx="6"/>
                <path d="M116.8,305.7 A152,152 0 0,1 55.4,270.3 L120.1,202.1 A58,58 0 0,0 143.5,215.6 Z" fill="rgba(212,168,67,.16)" stroke="rgba(212,168,67,.3)" stroke-width="1.5" class="royaume-region" data-idx="7"/>
                <path d="M49.7,264.6 A152,152 0 0,1 14.3,203.2 L104.4,176.5 A58,58 0 0,0 117.9,199.9 Z" fill="rgba(192,57,43,.28)" stroke="rgba(192,57,43,.5)" stroke-width="1.5" class="royaume-region" data-idx="8"/>
                <path d="M12.2,195.5 A152,152 0 0,1 12.2,124.5 L103.6,146.5 A58,58 0 0,0 103.6,173.5 Z" fill="rgba(192,57,43,.28)" stroke="rgba(192,57,43,.5)" stroke-width="1.5" class="royaume-region" data-idx="9"/>
                <path d="M14.3,116.8 A152,152 0 0,1 49.7,55.4 L117.9,120.1 A58,58 0 0,0 104.4,143.5 Z" fill="rgba(192,57,43,.28)" stroke="rgba(192,57,43,.5)" stroke-width="1.5" class="royaume-region" data-idx="10"/>
                <path d="M55.4,49.7 A152,152 0 0,1 116.8,14.3 L143.5,104.4 A58,58 0 0,0 120.1,117.9 Z" fill="rgba(192,57,43,.28)" stroke="rgba(192,57,43,.5)" stroke-width="1.5" class="royaume-region" data-idx="11"/>
              </svg>
              <div class="ile-coeur">
                <div class="ile-inner">
                  <div style="font-size:31.2px;">🏝</div>
                  <div style="font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.08em;color:var(--gold);margin-top:3px;">ÎLE DU</div>
                  <div style="font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.08em;color:var(--gold);">CŒUR</div>
                </div>
              </div>
              <div class="royaume-node ally" style="left:160.0px;top:34.0px;" data-idx="0" title="République de Franxx"><div class="node-icon">⚜</div><div class="node-label">Franxx</div></div>
              <div class="royaume-node ally" style="left:223.0px;top:50.9px;" data-idx="1" title="Royaume Auregia"><div class="node-icon">🌾</div><div class="node-label">Auregia</div></div>
              <div class="royaume-node ally" style="left:269.1px;top:97.0px;" data-idx="2" title="Royaume Brumelonde"><div class="node-icon">🌲</div><div class="node-label">Brumelonde</div></div>
              <div class="royaume-node secret" style="left:286.0px;top:160.0px;" data-idx="3" title="République d'Ozélis"><div class="node-icon">⚓</div><div class="node-label">Ozélis</div></div>
              <div class="royaume-node" style="left:269.1px;top:223.0px;" data-idx="4" title="Royaume d'Akassya"><div class="node-icon">🧝</div><div class="node-label">Akassya</div></div>
              <div class="royaume-node" style="left:223.0px;top:269.1px;" data-idx="5" title="Royaume de Zarûn"><div class="node-icon">💧</div><div class="node-label">Zarûn</div></div>
              <div class="royaume-node" style="left:160.0px;top:286.0px;" data-idx="6" title="Empire Lucèmien"><div class="node-icon">🏛</div><div class="node-label">Lucèmien</div></div>
              <div class="royaume-node" style="left:97.0px;top:269.1px;" data-idx="7" title="Terre de Suba"><div class="node-icon">⚔</div><div class="node-label">Suba</div></div>
              <div class="royaume-node hostile" style="left:50.9px;top:223.0px;" data-idx="8" title="Royaume de Vermeil"><div class="node-icon">👿</div><div class="node-label">Vermeil</div></div>
              <div class="royaume-node hostile" style="left:34.0px;top:160.0px;" data-idx="9" title="Autocratie Vyrrag"><div class="node-icon">🏔</div><div class="node-label">Vyrrag</div></div>
              <div class="royaume-node hostile" style="left:50.9px;top:97.0px;" data-idx="10" title="Empire de Lutèce"><div class="node-icon">🦅</div><div class="node-label">Lutèce</div></div>
              <div class="royaume-node hostile" style="left:97.0px;top:50.9px;" data-idx="11" title="Mont RokDur"><div class="node-icon">🐉</div><div class="node-label">RokDur</div></div>
            </div>
          </div>
        </div>
        <p class="home-hint">Cliquez sur un royaume pour découvrir son histoire</p>
        </div>
      </div>

      <div id="s-personnages" class="section">
        <div class="page-title"><i class="ti ti-users"></i> Fiches de personnage
          <span style="font-size:17.2px;color:#907860;font-family:'Crimson Pro',serif;font-weight:400;margin-left:8px;font-style:italic;">— Cliquez sur n'importe quel texte pour le modifier</span>
        </div>
        <div id="mj-banner" class="mj-banner" style="display:none"><i class="ti ti-crown"></i> Mode MJ — Toutes les fiches sont éditables</div>
        <div id="char-tabs-bar" class="char-tabs">
          <div class="char-tab active" onclick="showCharVitruve('azarius',this)">Azarius</div>
          <div class="char-tab" onclick="showCharVitruve('dy',this)">Dy</div>
          <div class="char-tab" onclick="showCharVitruve('firm',this)">Firm</div>
          <div class="char-tab" onclick="showCharVitruve('mwassa',this)">Mwassa</div>
          <div class="char-tab" onclick="showCharVitruve('nindey',this)">Nindey</div>
        </div>
        <!-- Layout vitruve JDR -->
        <div class="vitruve-layout" id="vitruve-main">
          <!-- Colonne gauche: fiche JDR -->
          <div class="vitruve-sheet" id="vitruve-sheet">
            <div class="vit-header">
              <div class="vit-name" id="vit-name">Azarius Desbois</div>
              <div class="vit-sub" id="vit-sub">Kitsune · Cogneur · Niv.1 · 🔥 Feu</div>
            </div>
            <div class="vitals-strip">
              <div class="vpill pv-pill">
                <div class="vbig pv" id="vit-pv">14</div>
                <div class="vlbl">PV / <span id="vit-pvmax">14</span></div>
                <div class="vbtns">
                  <button class="vbtn" onclick="vitAdj('pv',-1)">−</button>
                  <button class="vbtn" onclick="vitAdj('pv',1)">+</button>
                </div>
              </div>
              <div class="vpill mana-pill">
                <div class="vbig mana" id="vit-mana">9</div>
                <div class="vlbl">Mana / <span id="vit-manamax">9</span></div>
                <div class="vbtns">
                  <button class="vbtn" onclick="vitAdj('mana',-1)">−</button>
                  <button class="vbtn" onclick="vitAdj('mana',1)">+</button>
                </div>
              </div>
            </div>
            <!-- Portrait simple -->
            <div class="vitruve-illo" id="vitruve-illo-wrap">
              <div class="vit-portrait" id="vit-portrait"><i class="ti ti-user"></i></div>
            </div>
            <!-- Bouton MJ éditer -->
            <div id="vitruve-edit-zone" style="display:none;margin-top:10px;">
              <button class="btn-edit-raw" onclick="editRawChar()"><i class="ti ti-pencil"></i> Éditer les données brutes</button>
            </div>

            <!-- Calculateur de jets -->
            <div id="jet-calc" style="margin-top:12px;background:rgba(30,20,8,.85);border:1px solid rgba(212,168,67,.2);border-radius:10px;padding:12px 14px;">
              <div style="font-family:'Cinzel',serif;font-size:13px;color:#D4A843;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;"><i class="ti ti-dice-5" style="margin-right:6px;"></i>Calculateur de jet</div>
              <div style="display:flex;gap:6px;margin-bottom:8px;" id="jet-cat-btns">
                <button class="jet-cat-btn active" data-cat="physique" onclick="selectJetCat(this)" style="flex:1;padding:5px 4px;font-family:'Cinzel',serif;font-size:11px;border-radius:6px;cursor:pointer;border:1px solid #C07830;background:rgba(160,80,20,.25);color:#C07830;">Phys.</button>
                <button class="jet-cat-btn" data-cat="social" onclick="selectJetCat(this)" style="flex:1;padding:5px 4px;font-family:'Cinzel',serif;font-size:11px;border-radius:6px;cursor:pointer;border:1px solid rgba(48,160,112,.4);background:transparent;color:#30A070;">Soc.</button>
                <button class="jet-cat-btn" data-cat="mental" onclick="selectJetCat(this)" style="flex:1;padding:5px 4px;font-family:'Cinzel',serif;font-size:11px;border-radius:6px;cursor:pointer;border:1px solid rgba(64,128,192,.4);background:transparent;color:#4080C0;">Men.</button>
              </div>
              <div style="font-size:12px;color:#A09070;margin-bottom:6px;">Base : <span id="jet-base-lbl" style="color:#D4A843;font-weight:bold;">—%</span></div>
              <div id="jet-check-row" style="font-size:12px;color:#A09070;margin-bottom:6px;display:none;">Compétences : <span id="jet-check-lbl" style="color:#6CC090;font-weight:bold;">+0%</span></div>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <span style="font-size:12px;color:#A09070;white-space:nowrap;">Bonus/Malus :</span>
                <button onclick="adjustJetMod(-5)" style="background:rgba(192,48,48,.15);border:1px solid rgba(192,48,48,.3);color:#C03030;border-radius:5px;padding:2px 8px;cursor:pointer;font-size:14px;font-weight:bold;">−</button>
                <span id="jet-mod-lbl" style="font-family:'Cinzel',serif;font-size:16px;color:#F2E6CC;min-width:44px;text-align:center;">0%</span>
                <button onclick="adjustJetMod(5)" style="background:rgba(48,160,112,.1);border:1px solid rgba(48,160,112,.3);color:#30A070;border-radius:5px;padding:2px 8px;cursor:pointer;font-size:14px;font-weight:bold;">+</button>
                <button onclick="resetJetMod()" style="background:none;border:1px solid rgba(212,168,67,.2);color:#907050;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:11px;margin-left:2px;">↺</button>
              </div>
              <div style="border-top:1px solid rgba(212,168,67,.15);padding-top:8px;display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:12px;color:#A09070;">Total à atteindre :</span>
                <span id="jet-total" style="font-family:'Cinzel',serif;font-size:26px;font-weight:700;color:#D4A843;">—%</span>
              </div>
              <div style="display:flex;justify-content:space-between;margin-top:6px;">
                <span style="font-size:11px;color:rgba(192,48,48,.7);font-style:italic;">Min. : 5%</span>
                <span style="font-size:11px;color:rgba(48,160,112,.7);font-style:italic;">Max. : 95%</span>
              </div>
            </div>

            <!-- Avantages & Désavantages -->
            <div id="avdis-box" style="margin-top:12px;background:rgba(30,20,8,.85);border:1px solid rgba(212,168,67,.2);border-radius:10px;padding:12px 14px;">
              <div style="font-family:'Cinzel',serif;font-size:13px;color:#D4A843;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;"><i class="ti ti-cards" style="margin-right:6px;"></i>Avantages & Désavantages</div>
              <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:rgba(50,160,80,.08);border:1px solid rgba(50,160,80,.25);border-radius:8px;margin-bottom:8px;">
                <span style="font-size:15px;color:#50C070;font-family:'Cinzel',serif;">Avantage</span>
                <input type="checkbox" id="cb-avantage" style="width:22px;height:22px;cursor:pointer;accent-color:#50C070;">
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:rgba(160,60,40,.08);border:1px solid rgba(160,60,40,.25);border-radius:8px;">
                <span style="font-size:15px;color:#D06050;font-family:'Cinzel',serif;">Désavantage</span>
                <input type="checkbox" id="cb-desavantage" style="width:22px;height:22px;cursor:pointer;accent-color:#D06050;">
              </div>
            </div>

            <!-- État du groupe — PV/Mana en temps réel, toujours visible -->
            <div style="margin-top:12px;background:rgba(30,20,8,.85);border:1px solid rgba(212,168,67,.2);border-radius:10px;padding:12px 14px;">
              <div style="font-family:'Cinzel',serif;font-size:13px;color:#D4A843;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;"><i class="ti ti-heartbeat" style="margin-right:6px;"></i>État du groupe</div>
              <div id="party-status-list" style="display:flex;flex-direction:column;gap:9px;"></div>
            </div>

            <!-- Dés d'Aventure & Mésaventure — rappel visuel -->
            <div style="margin-top:12px;background:rgba(30,20,8,.85);border:1px solid rgba(212,168,67,.2);border-radius:10px;padding:12px 14px;">
              <div style="font-family:'Cinzel',serif;font-size:13px;color:#D4A843;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;"><i class="ti ti-dice" style="margin-right:6px;"></i>Dés d'Aventure</div>
              <div id="adv-mini-row" style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap;"></div>
              <div style="display:flex;justify-content:space-between;margin-top:8px;">
                <span style="font-size:11px;color:#50A070;font-style:italic;"><i class="ti ti-circle-filled" style="font-size:9px;color:#2E7D32;margin-right:3px;"></i>Aventure : <span id="adv-mini-aven" style="font-weight:700;color:#9CDC9C;">4</span></span>
                <span style="font-size:11px;color:#A05040;font-style:italic;"><i class="ti ti-circle-filled" style="font-size:9px;color:#C0392B;margin-right:3px;"></i>Mésaventure : <span id="adv-mini-meso" style="font-weight:700;color:#F0B0A6;">0</span></span>
              </div>
            </div>
          </div>
          <!-- Colonne droite: panneau info -->
          <div class="vpanel" id="vpanel">
            <div class="pchar-tabs" id="pchar-tabs">
              <div class="pchar-tab active" data-tab="fiche" onclick="showPersoTab('fiche',this)"><i class="ti ti-id-badge-2"></i> Fiche</div>
              <div class="pchar-tab" data-tab="carac" onclick="showPersoTab('carac',this)"><i class="ti ti-chart-bar"></i> Caractéristiques</div>
              <div class="pchar-tab" data-tab="dons" onclick="showPersoTab('dons',this)"><i class="ti ti-sparkles"></i> Dons</div>
              <div class="pchar-tab" data-tab="inv" onclick="showPersoTab('inv',this)"><i class="ti ti-backpack"></i> Inventaire</div>
              <div class="pchar-tab furm-tab" data-tab="furm" id="furm-tab-btn" onclick="showPersoTab('furm',this)" style="display:none"><i class="ti ti-paw"></i> Furmiaou</div>
            </div>
            <div class="vpanel-content" id="vpanel-content"></div>
          </div>
        </div>
      </div>

      <div id="s-journal" class="section">
        <div class="page-title"><i class="ti ti-book"></i> Journal de campagne</div>
        <button class="btn-add" onclick="showAddSession()"><i class="ti ti-plus"></i> Nouvelle session</button>
        <div id="add-form" style="display:none" class="card">
          <div class="card-title">Nouvelle session</div>
          <input id="s-title" class="edit-input" placeholder="Titre de la session...">
          <textarea id="s-text" class="ef-area" placeholder="Résumé..." rows="4"></textarea>
          <div style="display:flex;gap:8px;margin-top:10px;">
            <button class="btn-save" onclick="saveSession()"><i class="ti ti-check"></i> Enregistrer</button>
            <button class="btn-cancel" onclick="hideAddSession()">Annuler</button>
          </div>
        </div>
        <div id="journal-list"></div>
      </div>

      <div id="s-pnj" class="section">
        <div class="page-title"><i class="ti ti-masks-theater"></i> PNJ &amp; Factions</div>

        <style>
        .faction-card-a{border:1px solid rgba(212,168,67,.18);border-radius:10px;overflow:hidden;display:flex;min-height:180px;margin-bottom:14px;box-shadow:0 6px 30px rgba(0,0,0,.5);background:linear-gradient(160deg,rgba(28,20,10,.97),rgba(20,14,6,.99));}
        .faction-card-a + .faction-card-a{margin-top:14px;}
        .faction-img-col{width:200px;flex-shrink:0;overflow:hidden;position:relative;}
        .faction-img-col img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;filter:brightness(.75);}
        .faction-img-overlay{position:absolute;inset:0;background:linear-gradient(90deg,transparent 70%,rgba(20,14,6,.85) 100%);}
        .faction-text-col{padding:18px 20px;flex:1;display:flex;flex-direction:column;justify-content:center;}
        .faction-a-name{font-family:'Cinzel',serif;font-size:22px;letter-spacing:.08em;margin-bottom:4px;}
        .faction-a-name.hostile{color:#E07070;}
        .faction-a-name.neutre{color:#F0C96A;}
        .faction-a-role{font-size:13px;color:#A09070;font-style:italic;margin-bottom:12px;}
        .faction-a-desc{font-size:15px;color:#C8B890;line-height:1.7;margin-bottom:12px;}
        .faction-a-desc p{margin-bottom:8px;}
        .faction-a-badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:20px;}
        .faction-a-badge.hostile{background:rgba(192,57,43,.12);border:1px solid rgba(192,57,43,.35);color:#E07070;}
        .faction-a-badge.neutre{background:rgba(42,95,168,.12);border:1px solid rgba(42,95,168,.35);color:#7EB5E0;}
        .faction-a-badge i{font-size:12px;}
        </style>

        <!-- LA ROSE NOIRE -->
        <div class="faction-card-a" style="border-color:rgba(192,57,43,.25);">
          <div class="faction-img-col">
            <img src="xxx" alt="La Rose Noire">
            <div class="faction-img-overlay"></div>
          </div>
          <div class="faction-text-col">
            <div class="faction-a-name hostile">La Rose Noire</div>
            <div class="faction-a-role">Secte criminelle — née en Auregia</div>
            <div class="faction-a-desc">
              <p>Née parmi de puissants marchands sans scrupules, la Rose Noire traque inlassablement les artefacts légendaires et les reliques prophétiques pour les revendre au marché noir aux plus offrants.</p>
              <p>Elle emploie mercenaires, espions, monstres et mages renégats — menace persistante pour les nations d'Alésia et adversaire de premier plan pour les Téméraires.</p>
            </div>
            <span class="faction-a-badge hostile"><i class="ti ti-alert-triangle"></i> Hostile</span>
          </div>
        </div>

        <!-- L'ORDRE DU SAVOIR -->
        <div class="faction-card-a" style="border-color:rgba(42,95,168,.25);">
          <div class="faction-img-col">
            <img src="xxx" alt="L'Ordre du Savoir">
            <div class="faction-img-overlay"></div>
          </div>
          <div class="faction-text-col">
            <div class="faction-a-name neutre">L'Ordre du Savoir</div>
            <div class="faction-a-role">Institution érudite ancestrale</div>
            <div class="faction-a-desc">
              <p>Né parmi les premiers gardiens de la mémoire druidique, l'Ordre protège les connaissances interdites, les prophéties anciennes et les artefacts sacrés. Ses archivistes, mages-scribes et veilleurs parcourent les terres pour contrer les trafiquants et les sectes.</p>
              <p>Discret mais jamais passif, il demeure un rempart de raison autant qu'un acteur imprévisible dans les jeux de pouvoir d'Alésia.</p>
            </div>
            <span class="faction-a-badge neutre"><i class="ti ti-scale"></i> Neutre / Ambigu</span>
          </div>
        </div>

      </div>

      <div id="s-royaumes" class="section">
        <div class="page-title"><i class="ti ti-world"></i> Les 12 Royaumes</div>
        <p style="font-size:20.2px;color:#907860;font-style:italic;margin-bottom:20px;text-align:center;">Cliquez sur un royaume pour découvrir sa fiche — douze nations autour du Lac sacré et de l'Île du Cœur.</p>

        <div class="royaumes-layout">
          <div class="cercle-wrap">
            <div class="cercle-container" id="cercle-container">
              <!-- SVG lignes -->
              <svg class="cercle-svg" viewBox="0 0 320 320">
                <line x1="160" y1="160" x2="160.0" y2="34.0" stroke="rgba(74,122,40,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="223.0" y2="50.9" stroke="rgba(74,122,40,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="269.1" y2="97.0" stroke="rgba(74,122,40,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="286.0" y2="160.0" stroke="rgba(106,74,186,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="269.1" y2="223.0" stroke="rgba(212,168,67,.1)" stroke-width="1"/>
                <line x1="160" y1="160" x2="223.0" y2="269.1" stroke="rgba(212,168,67,.1)" stroke-width="1"/>
                <line x1="160" y1="160" x2="160.0" y2="286.0" stroke="rgba(212,168,67,.1)" stroke-width="1"/>
                <line x1="160" y1="160" x2="97.0" y2="269.1" stroke="rgba(212,168,67,.1)" stroke-width="1"/>
                <line x1="160" y1="160" x2="50.9" y2="223.0" stroke="rgba(192,57,43,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="34.0" y2="160.0" stroke="rgba(192,57,43,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="50.9" y2="97.0" stroke="rgba(192,57,43,.2)" stroke-width="1"/>
                <line x1="160" y1="160" x2="97.0" y2="50.9" stroke="rgba(192,57,43,.2)" stroke-width="1"/>
              </svg>
              <!-- Île du Cœur -->
              <div class="ile-coeur">
                <div class="ile-inner">
                  <div style="font-size:31.2px;">🏝</div>
                  <div style="font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.08em;color:var(--gold);margin-top:3px;">ÎLE DU</div>
                  <div style="font-family:'Cinzel',serif;font-size:12.5px;letter-spacing:.08em;color:var(--gold);">CŒUR</div>
                </div>
              </div>
              <!-- 12 nœuds statiques -->
              <div class="royaume-node ally" style="left:160.0px;top:34.0px;" data-idx="0" title="République de Franxx"><div class="node-icon">⚜</div><div class="node-label">Franxx</div></div>
              <div class="royaume-node ally" style="left:223.0px;top:50.9px;" data-idx="1" title="Royaume Auregia"><div class="node-icon">🌾</div><div class="node-label">Auregia</div></div>
              <div class="royaume-node ally" style="left:269.1px;top:97.0px;" data-idx="2" title="Royaume Brumelonde"><div class="node-icon">🌲</div><div class="node-label">Brumelonde</div></div>
              <div class="royaume-node secret" style="left:286.0px;top:160.0px;" data-idx="3" title="République d'Ozélis"><div class="node-icon">⚓</div><div class="node-label">Ozélis</div></div>
              <div class="royaume-node" style="left:269.1px;top:223.0px;" data-idx="4" title="Royaume d'Akassya"><div class="node-icon">🧝</div><div class="node-label">Akassya</div></div>
              <div class="royaume-node" style="left:223.0px;top:269.1px;" data-idx="5" title="Royaume de Zarûn"><div class="node-icon">💧</div><div class="node-label">Zarûn</div></div>
              <div class="royaume-node" style="left:160.0px;top:286.0px;" data-idx="6" title="Empire Lucèmien"><div class="node-icon">🏛</div><div class="node-label">Lucèmien</div></div>
              <div class="royaume-node" style="left:97.0px;top:269.1px;" data-idx="7" title="Terre de Suba"><div class="node-icon">⚔</div><div class="node-label">Suba</div></div>
              <div class="royaume-node hostile" style="left:50.9px;top:223.0px;" data-idx="8" title="Royaume de Vermeil"><div class="node-icon">👿</div><div class="node-label">Vermeil</div></div>
              <div class="royaume-node hostile" style="left:34.0px;top:160.0px;" data-idx="9" title="Autocratie Vyrrag"><div class="node-icon">🏔</div><div class="node-label">Vyrrag</div></div>
              <div class="royaume-node hostile" style="left:50.9px;top:97.0px;" data-idx="10" title="Empire de Lutèce"><div class="node-icon">🦅</div><div class="node-label">Lutèce</div></div>
              <div class="royaume-node hostile" style="left:97.0px;top:50.9px;" data-idx="11" title="Mont RokDur"><div class="node-icon">🐉</div><div class="node-label">RokDur</div></div>
            </div>
          </div>
          <div class="royaume-card-wrap">
            <div class="royaume-card" id="royaume-card">
              <div class="royaume-card-empty">
                <i class="ti ti-world" style="font-size:50px;color:rgba(212,168,67,.2);display:block;margin-bottom:10px;"></i>
                <div style="font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.1em;color:#604A28;">SÉLECTIONNEZ UN ROYAUME</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="s-races" class="section">
        <div class="page-title"><i class="ti ti-dna"></i> Races jouables</div>
        <div class="race-wheel tall">
          <div class="race-track" id="race-track"></div>
          <button class="race-arrow" onclick="raceNav(1)" aria-label="Suivant"><i class="ti ti-chevron-right"></i></button>
        </div>
        <div class="race-dots" id="race-dots"></div>
      </div>

      <div id="s-classes" class="section">
        <div class="page-title"><i class="ti ti-sword"></i> Classes jouables</div>
        <div class="race-wheel tall">
          <button class="race-arrow" onclick="classNav(-1)" aria-label="Précédent"><i class="ti ti-chevron-left"></i></button>
          <div class="race-track" id="class-track"></div>
          <button class="race-arrow" onclick="classNav(1)" aria-label="Suivant"><i class="ti ti-chevron-right"></i></button>
        </div>
        <div class="race-dots" id="class-dots"></div>
      </div>

      <div id="s-des" class="section">
        <div class="page-title"><i class="ti ti-dice"></i> Lanceur de dés</div>
        <div class="dice-result"><div class="dice-num" id="dice-num">—</div><div class="dice-lbl" id="dice-lbl">Choisis un dé</div></div>
        <div class="dice-grid">
          <div class="die-btn" onclick="roll(4)"><i class="ti ti-triangle"></i>D4</div>
          <div class="die-btn" onclick="roll(6)"><i class="ti ti-square"></i>D6</div>
          <div class="die-btn" onclick="roll(8)"><i class="ti ti-octagon"></i>D8</div>
          <div class="die-btn" onclick="roll(10)"><i class="ti ti-pentagon"></i>D10</div>
          <div class="die-btn" onclick="roll(12)"><i class="ti ti-hexagon"></i>D12</div>
          <div class="die-btn" onclick="roll(20)"><i class="ti ti-star"></i>D20</div>
          <div class="die-btn" onclick="roll(100)"><i class="ti ti-circle"></i>D100</div>
        </div>
        <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.1em;color:var(--gold-d);margin-bottom:8px;">HISTORIQUE</div>
        <div id="dice-hist"></div>
      </div>

      <div id="s-adventdes" class="section">
        <div class="page-title"><i class="ti ti-arrows-shuffle"></i> Dés d'Aventure</div>
        <div class="card">
          <p style="font-size:20.2px;color:#CFC09A;line-height:1.7;margin-bottom:6px;">Le groupe dispose de <strong style="color:#F2E6CC">4 dés</strong>, répartis entre <strong style="color:#5FAE5A;">Aventure</strong> et <strong style="color:#D47A6A;">Mésaventure</strong>. Vase communicant : chaque dé déplacé d'un côté est retiré de l'autre.</p>
          <div class="adv-vessel">
            <div class="adv-side aventure">
              <div class="adv-num" id="adv-aventure">4</div>
              <div class="adv-lbl">Aventure</div>
            </div>
            <div class="adv-divider"></div>
            <div class="adv-side mesaventure">
              <div class="adv-num" id="adv-mesaventure">0</div>
              <div class="adv-lbl">Mésaventure</div>
            </div>
          </div>
          <div class="adv-dice-row" id="adv-dice-row"></div>
          <div class="adv-controls">
            <button class="vpanel-edit" onclick="advShift(1)"><i class="ti ti-arrow-right"></i> Vers Mésaventure</button>
            <button class="vpanel-edit" onclick="advShift(-1)"><i class="ti ti-arrow-left"></i> Vers Aventure</button>
            <button class="vpanel-edit" onclick="advReset()"><i class="ti ti-refresh"></i> Réinitialiser (4/0)</button>
          </div>
        </div>
        <div class="card" style="margin-top:14px;">
          <div class="sdiv">📖 Rappel des règles</div>
          <div style="font-size:18.8px;color:#CFC09A;line-height:1.6;margin-bottom:10px;">Le groupe commence avec <strong style="color:#F2E6CC;">4 dés blancs (Aventure)</strong>. Quand un joueur <strong style="color:#5FAE5A;">utilise un dé d'Aventure</strong>, il devient noir et passe du côté <strong style="color:#D47A6A;">Mésaventure</strong> — donnant au MJ la possibilité de retourner la situation en utilisant à son tour un dé de ce côté. C'est un vase communicant : le total reste toujours égal à 4.</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center;margin-bottom:10px;">
            <div style="background:rgba(95,174,90,.08);border:1px solid rgba(95,174,90,.2);border-radius:8px;padding:8px;"><strong style="color:#9CDC9C;font-family:'Cinzel',serif;font-size:21.9px;">1–2</strong><br><span style="font-size:18.8px;color:#CFC09A;">Mouvement</span></div>
            <div style="background:rgba(95,174,90,.08);border:1px solid rgba(95,174,90,.2);border-radius:8px;padding:8px;"><strong style="color:#9CDC9C;font-family:'Cinzel',serif;font-size:21.9px;">3–4</strong><br><span style="font-size:18.8px;color:#CFC09A;">Posture</span></div>
            <div style="background:rgba(95,174,90,.08);border:1px solid rgba(95,174,90,.2);border-radius:8px;padding:8px;"><strong style="color:#9CDC9C;font-family:'Cinzel',serif;font-size:21.9px;">5–6</strong><br><span style="font-size:18.8px;color:#CFC09A;">Bonus "In extremis" (+5%)</span></div>
          </div>
          <div style="font-size:18.8px;color:#CFC09A;line-height:1.6;">Un dé d'<strong style="color:#5FAE5A;">Aventure</strong> permet de changer librement l'un de ces 3 éléments en pleine action (mouvement, posture, ou +5% sur un jet). Un dé de <strong style="color:#D47A6A;">Mésaventure</strong> donne le même pouvoir au MJ, mais en sa faveur (complication, ennemi qui change de posture, malus imprévu...).</div>
        </div>
      </div>

      <div id="s-notes" class="section">
        <div class="page-title"><i class="ti ti-notes"></i> Notes partagées</div>
        <textarea id="notes-area" onblur="saveNotes()" placeholder="Notes de session..." style="color:#F2E6CC;">Chargement...</textarea>
        <div class="ntags">
          <div class="ntag" onclick="insertTag('#indices')">#indices</div>
          <div class="ntag" onclick="insertTag('#suspects')">#suspects</div>
          <div class="ntag" onclick="insertTag('#lieux')">#lieux</div>
          <div class="ntag" onclick="insertTag('#théories')">#théories</div>
          <div class="ntag" onclick="insertTag('#prophétie')">#prophétie</div>
          <div class="ntag" onclick="insertTag('#objectifs')">#objectifs</div>
        </div>
        <div style="font-size:17.2px;color:#907860;font-style:italic;margin-top:8px;"><i class="ti ti-lock" style="vertical-align:-2px"></i> Notes synchronisées en temps réel.</div>
      </div>

      <!-- HISTOIRE (livret) -->
      <div id="s-histoire" class="section">
        <div class="page-title"><i class="ti ti-book-2"></i> Histoire d'Alésia</div>
        <div class="book-wrap" id="book-wrap"></div>
      </div>

      <!-- CASTES (livret) -->
      <div id="s-castes" class="section">
        <div class="page-title"><i class="ti ti-crown"></i> Castes & Factions du monde</div>

        <!-- CLASSEUR -->
        <div class="classeur-wrap">

          <!-- INTERCALAIRES (onglets) -->
          <div class="classeur-tabs">
            <div class="classeur-tab active" onclick="openFiche(0,this)" data-color="#8B6914">
              <span class="tab-icon">⚔</span><span class="tab-label">Téméraires</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(1,this)" data-color="#6B1A1A">
              <span class="tab-icon">🌹</span><span class="tab-label">Rose Noire</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(2,this)" data-color="#1A3A5A">
              <span class="tab-icon">📚</span><span class="tab-label">Ordre du Savoir</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(3,this)" data-color="#2A4A1A">
              <span class="tab-icon">🌾</span><span class="tab-label">Paysans</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(4,this)" data-color="#3A2A6A">
              <span class="tab-icon">🏰</span><span class="tab-label">Nobles</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(5,this)" data-color="#4A3010">
              <span class="tab-icon">💰</span><span class="tab-label">Marchands</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(6,this)" data-color="#1A4A3A">
              <span class="tab-icon">📜</span><span class="tab-label">Fonctionnaires</span>
            </div>
            <div class="classeur-tab" onclick="openFiche(7,this)" data-color="#4A1A3A">
              <span class="tab-icon">🙏</span><span class="tab-label">Religieux</span>
            </div>
          </div>

          <!-- CORPS DU CLASSEUR -->
          <div class="classeur-body">

            <!-- Fiche 0 : Téméraires -->
            <div class="fiche active" id="fiche-0" style="--fiche-accent:#D4A843;">
              <div class="fiche-header">
                <div class="fiche-stamp">⚔</div>
                <div>
                  <div class="fiche-title">Les Téméraires</div>
                  <div class="fiche-sub">Cercle occulte · Prophétie des Douze Voies</div>
                </div>
                <span class="badge" style="margin-left:auto;">Alliance active</span>
              </div>
              <div class="fiche-divider"></div>
              <p class="fiche-text">Issus des 12 royaumes ou élus par des forces mystiques, les Téméraires forment un cercle occulte dédié à la réalisation de la Grande Prophétie. Refusant la passivité religieuse ou politique, leur foi s'incarne dans l'action.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Structure</div><div class="fiche-cell-val">12 Maîtres actifs, un par royaume</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Objectif</div><div class="fiche-cell-val">Lever la barrière · Pénétrer l'Île du Cœur</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Statut</div><div class="fiche-cell-val">Messies ou hérétiques selon les régions</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Base</div><div class="fiche-cell-val">République de Franxx · Réseau secret</div></div>
              </div>
            </div>

            <!-- Fiche 1 : Rose Noire -->
            <div class="fiche" id="fiche-1" style="--fiche-accent:#C0392B;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(192,57,43,.15);border-color:rgba(192,57,43,.4);color:#E07070;">🌹</div>
                <div>
                  <div class="fiche-title">La Rose Noire</div>
                  <div class="fiche-sub">Secte criminelle · Née en Auregia</div>
                </div>
                <span class="badge hostile" style="margin-left:auto;">Hostile</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(192,57,43,.5),transparent);"></div>
              <p class="fiche-text">Secte criminelle d'envergure internationale. Ses membres traquent artefacts légendaires et reliques prophétiques pour les revendre au marché noir. Emploient mercenaires, espions, monstres et mages renégats.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Type</div><div class="fiche-cell-val">Secte criminelle internationale</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Origine</div><div class="fiche-cell-val">Auregia</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Objectif</div><div class="fiche-cell-val">Artefacts légendaires · Reliques prophétiques</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Menace</div><div class="fiche-cell-val">Persistante · Toutes les nations</div></div>
              </div>
            </div>

            <!-- Fiche 2 : Ordre du Savoir -->
            <div class="fiche" id="fiche-2" style="--fiche-accent:#2A5FA8;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(42,95,168,.15);border-color:rgba(42,95,168,.4);color:#6A9FD8;">📚</div>
                <div>
                  <div class="fiche-title">L'Ordre du Savoir</div>
                  <div class="fiche-sub">Institution érudite ancestrale</div>
                </div>
                <span class="badge" style="margin-left:auto;">Neutre / Ambigu</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(42,95,168,.5),transparent);"></div>
              <p class="fiche-text">Née parmi les premiers gardiens de la mémoire druidique. Dévoués à la préservation des secrets du monde. Ses archivistes, mages-scribes et veilleurs parcourent les terres pour contrer trafiquants et sectes. Discret mais jamais passif.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Rôle</div><div class="fiche-cell-val">Gardiens des savoirs interdits</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Membres</div><div class="fiche-cell-val">Archivistes · Mages-scribes · Veilleurs</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Stance</div><div class="fiche-cell-val">Intervient si les équilibres sont menacés</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Rapport</div><div class="fiche-cell-val">Ambigu avec les Téméraires</div></div>
              </div>
            </div>

            <!-- Fiche 3 : Paysans -->
            <div class="fiche" id="fiche-3" style="--fiche-accent:#4A7A28;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(74,122,40,.15);border-color:rgba(74,122,40,.4);color:#80C050;">🌾</div>
                <div>
                  <div class="fiche-title">Les Paysans</div>
                  <div class="fiche-sub">Base de la société · Caste populaire</div>
                </div>
                <span class="badge elem" style="margin-left:auto;">Caste basse</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(74,122,40,.5),transparent);"></div>
              <p class="fiche-text">Agriculteurs, pêcheurs, herboristes — le socle du monde. Souvent sous domination noble, ils subissent les guerres et les taxes. Certains rejoignent les Téméraires par désespoir ou conviction, espérant un monde plus juste après l'ouverture de l'Île du Cœur.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Rôle</div><div class="fiche-cell-val">Production alimentaire · Artisanat</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Rapport aux Téméraires</div><div class="fiche-cell-val">Potentiels alliés · Parfois recrutés</div></div>
              </div>
            </div>

            <!-- Fiche 4 : Nobles -->
            <div class="fiche" id="fiche-4" style="--fiche-accent:#6A4ABA;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(106,74,186,.15);border-color:rgba(106,74,186,.4);color:#A080E0;">🏰</div>
                <div>
                  <div class="fiche-title">Les Nobles</div>
                  <div class="fiche-sub">Caste dirigeante · Terres et armées</div>
                </div>
                <span class="badge" style="margin-left:auto;">Divisés</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(106,74,186,.5),transparent);"></div>
              <p class="fiche-text">Détenteurs des terres et des armées, les nobles sont profondément divisés face à la Prophétie. Les Traditionalistes veulent maintenir le statu quo et leur pouvoir. Les Réformateurs soutiennent les Téméraires, voyant dans l'Île du Cœur une opportunité d'expansion ou de légitimité divine.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Faction A</div><div class="fiche-cell-val">Traditionalistes — statu quo</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Faction B</div><div class="fiche-cell-val">Réformateurs — soutiennent les Téméraires</div></div>
              </div>
            </div>

            <!-- Fiche 5 : Marchands -->
            <div class="fiche" id="fiche-5" style="--fiche-accent:#A07020;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(160,112,32,.15);border-color:rgba(160,112,32,.4);color:#D4A843;">💰</div>
                <div>
                  <div class="fiche-title">Les Marchands</div>
                  <div class="fiche-sub">Guildes commerciales · Réseau mondial</div>
                </div>
                <span class="badge" style="margin-left:auto;">Opportunistes</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(160,112,32,.5),transparent);"></div>
              <p class="fiche-text">Les guildes marchandes traversent toutes les frontières. Certains financent secrètement les Téméraires, espérant des routes commerciales vers l'Île du Cœur. D'autres revendent des contrefaçons de reliques prophétiques aux crédules. Leur loyauté est avant tout au profit.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Structure</div><div class="fiche-cell-val">Guildes par spécialité et région</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Rapport</div><div class="fiche-cell-val">Ambivalent · Profit avant tout</div></div>
              </div>
            </div>

            <!-- Fiche 6 : Fonctionnaires -->
            <div class="fiche" id="fiche-6" style="--fiche-accent:#1A6A5A;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(26,106,90,.15);border-color:rgba(26,106,90,.4);color:#40C0A0;">📜</div>
                <div>
                  <div class="fiche-title">Les Fonctionnaires</div>
                  <div class="fiche-sub">Scribes · Diplomates · Archivistes</div>
                </div>
                <span class="badge elem" style="margin-left:auto;">Caste administrative</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(26,106,90,.5),transparent);"></div>
              <p class="fiche-text">Piliers invisibles des royaumes. Scribes, diplomates et archivistes tiennent les rouages du pouvoir. Certains dissimulent textes anciens et versions interdites de la Prophétie dans des archives secrètes, attendant le moment opportun pour les révéler.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Rôle</div><div class="fiche-cell-val">Administration · Diplomatie · Archives</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Secret</div><div class="fiche-cell-val">Certains cachent des textes prophétiques</div></div>
              </div>
            </div>

            <!-- Fiche 7 : Religieux -->
            <div class="fiche" id="fiche-7" style="--fiche-accent:#7A1A5A;">
              <div class="fiche-header">
                <div class="fiche-stamp" style="background:rgba(122,26,90,.15);border-color:rgba(122,26,90,.4);color:#D070A0;">🙏</div>
                <div>
                  <div class="fiche-title">Les Religieux</div>
                  <div class="fiche-sub">Prêtres · Moines · Prophètes</div>
                </div>
                <span class="badge" style="margin-left:auto;">Influents</span>
              </div>
              <div class="fiche-divider" style="background:linear-gradient(90deg,rgba(122,26,90,.5),transparent);"></div>
              <p class="fiche-text">Les religions périphériques entretiennent leurs propres versions de la Prophétie. Les prêtres de Zarûn gardent les eaux sacrées et condamnent toute tentative d'approcher l'Île. D'autres cultes voient dans les Téméraires des élus divins. Leur influence sur les masses est considérable.</p>
              <div class="fiche-grid">
                <div class="fiche-cell"><div class="fiche-cell-label">Principales factions</div><div class="fiche-cell-val">Gardiens de Zarûn · Cultes de la Prophétie</div></div>
                <div class="fiche-cell"><div class="fiche-cell-label">Rapport</div><div class="fiche-cell-val">De vénération à condamnation</div></div>
              </div>
            </div>

          </div><!-- fin classeur-body -->
        </div><!-- fin classeur-wrap -->
      </div>

      <!-- COSMOLOGIE (livret) -->
      <div id="s-cosmologie" class="section">
        <div class="page-title"><i class="ti ti-star"></i> Hiérarchie Cosmique d'Alésia</div>

        <!-- ARBRE COSMIQUE -->
        <div class="cosmo-tree-wrap" style="overflow-x:auto;padding:20px 0 10px;">

          <style>
            .cosmo-tree { font-family:'Cinzel',serif; }
            .ct-card {
              border-radius:10px; cursor:pointer; user-select:none;
              position:relative; transition:transform .15s, box-shadow .15s;
              overflow:hidden; width:200px;
            }
            .ct-card:hover { transform:translateY(-3px); }
            .ct-card-header { padding:12px 16px; text-align:center; position:relative; }
            .ct-card-title { font-size:13px; letter-spacing:.08em; font-weight:700; margin-bottom:2px; }
            .ct-card-sub { font-size:11px; font-style:italic; opacity:.8; }
            .ct-chevron {
              position:absolute; right:10px; top:50%; transform:translateY(-50%);
              font-size:14px; transition:transform .2s; opacity:.7;
            }
            .ct-card-body {
              display:none; padding:10px 12px; font-family:'Cinzel',serif;
              font-size:11.5px; line-height:1.6; color:#CFC09A;
            }
            .ct-card-body.open { display:block; }
            .ct-chevron.open { transform:translateY(-50%) rotate(180deg); }
            .ct-down-line { width:2px; flex-shrink:0; background:rgba(180,140,60,.35); }
            .ct-up-tick { width:2px; height:20px; background:rgba(180,140,60,.35); }
            .ct-deique .ct-card-header { background:linear-gradient(135deg,#8B6914,#C9A84C,#8B6914); }
            .ct-deique .ct-card { border:1px solid rgba(201,168,76,.5); box-shadow:0 4px 18px rgba(201,168,76,.25); }
            .ct-deique .ct-card-title { color:#fff; text-shadow:0 1px 4px rgba(0,0,0,.5); }
            .ct-deique .ct-card-sub { color:rgba(255,255,255,.8); }
            .ct-deique .ct-card-body { background:rgba(201,168,76,.08); border-top:1px solid rgba(201,168,76,.2); }
            .ct-legendaire .ct-card-header { background:linear-gradient(135deg,#4a2060,#7B3FA0,#4a2060); }
            .ct-legendaire .ct-card { border:1px solid rgba(150,80,200,.4); box-shadow:0 4px 14px rgba(123,63,160,.2); }
            .ct-legendaire .ct-card-title { color:#e0c0ff; }
            .ct-legendaire .ct-card-sub { color:rgba(220,180,255,.8); }
            .ct-legendaire .ct-card-body { background:rgba(123,63,160,.08); border-top:1px solid rgba(150,80,200,.2); }
            .ct-effroyable .ct-card-header { background:linear-gradient(135deg,#5c1a1a,#8B2020,#5c1a1a); }
            .ct-effroyable .ct-card { border:1px solid rgba(180,40,40,.35); box-shadow:0 3px 12px rgba(139,32,32,.18); }
            .ct-effroyable .ct-card-title { color:#ffd0d0; }
            .ct-effroyable .ct-card-sub { color:rgba(255,180,180,.8); }
            .ct-effroyable .ct-card-body { background:rgba(139,32,32,.07); border-top:1px solid rgba(180,40,40,.2); }
            .ct-rare .ct-card-header { background:linear-gradient(135deg,#1a4a30,#1D6B5A,#1a4a30); }
            .ct-rare .ct-card { border:1px solid rgba(29,107,90,.35); box-shadow:0 3px 10px rgba(29,107,90,.15); }
            .ct-rare .ct-card-title { color:#80e0c0; }
            .ct-rare .ct-card-sub { color:rgba(120,210,180,.8); }
            .ct-rare .ct-card-body { background:rgba(29,107,90,.07); border-top:1px solid rgba(29,107,90,.2); }
            .ct-commune .ct-card-header { background:linear-gradient(135deg,#2a2a3a,#3a3a5a,#2a2a3a); }
            .ct-commune .ct-card { border:1px solid rgba(100,100,150,.3); box-shadow:0 3px 8px rgba(50,50,80,.15); }
            .ct-commune .ct-card-title { color:#c0c0e0; }
            .ct-commune .ct-card-sub { color:rgba(180,180,210,.8); }
            .ct-commune .ct-card-body { background:rgba(50,50,80,.07); border-top:1px solid rgba(100,100,150,.2); }
          </style>

          <div class="cosmo-tree" style="min-width:860px;display:flex;flex-direction:column;align-items:center;gap:0;">

            <!-- NIVEAU 1 : Déïques -->
            <div style="display:flex;flex-direction:column;align-items:center;">
              <div class="ct-card ct-deique" onclick="ctToggle(this)" style="width:280px;">
                <div class="ct-card-header">
                  <div class="ct-card-title">① CRÉATURES DÉÏQUES PRIMORDIALES</div>
                  <div class="ct-card-sub">Sommet absolu — La Lumière &amp; l'Obscurité</div>
                  <i class="ti ti-chevron-down ct-chevron"></i>
                </div>
                <div class="ct-card-body">
                  Deux entités incompréhensibles. L'une incarne la <strong style="color:#F2E6CC">Lumière</strong>, l'autre l'<strong style="color:#F2E6CC">Obscurité</strong>. À l'origine du cycle cosmique, elles n'interviennent presque jamais directement. Leur trône peut être renversé : une créature légendaire qui les vainc devient à son tour une déité.
                </div>
              </div>
            </div>

            <!-- CONNECTEUR 1→2 -->
            <div class="ct-down-line" style="height:30px;"></div>

            <!-- NIVEAU 2 : Légendaires -->
            <div style="display:flex;flex-direction:column;align-items:center;">
              <div class="ct-card ct-legendaire" onclick="ctToggle(this)" style="width:280px;">
                <div class="ct-card-header">
                  <div class="ct-card-title">② LES 12 BÊTES LÉGENDAIRES</div>
                  <div class="ct-card-sub">Vythranax · Vindrasil · et 10 autres…</div>
                  <i class="ti ti-chevron-down ct-chevron"></i>
                </div>
                <div class="ct-card-body">
                  Leur identité est inconnue du commun. Chacune règne sur un aspect fondamental du réel : magie, saisons, émotions, guerre, mémoire… Pleine conscience et volonté propre. <strong style="color:#e0c0ff">Seul moyen d'en devenir une :</strong> tuer et remplacer l'une des 12.
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;">
                    <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Vythranax" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">VYTHRANAX · Le Dragon Légendaire</div>
                    </div>
                    <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Vindrasil" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">VINDRASIL · Le Serpent des Profondeurs</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CONNECTEUR 2→[3,4,5] : ligne verticale puis barre H -->
            <div class="ct-down-line" style="height:30px;"></div>

            <!-- BARRE HORIZONTALE + 3 BRANCHES -->
            <div style="position:relative;width:860px;">
              <!-- Barre horizontale reliant les 3 branches -->
              <div style="position:absolute;top:0;left:140px;right:140px;height:2px;background:rgba(180,140,60,.35);"></div>

              <div style="display:flex;justify-content:space-between;align-items:flex-start;">

                <!-- BRANCHE GAUCHE : Effroyables -->
                <div style="display:flex;flex-direction:column;align-items:center;width:260px;">
                  <div class="ct-up-tick"></div>
                  <div class="ct-card ct-effroyable" onclick="ctToggle(this)" style="width:240px;">
                    <div class="ct-card-header">
                      <div class="ct-card-title">③ BÊTES EFFROYABLES</div>
                      <div class="ct-card-sub">Titans · Aberrations · Horreurs</div>
                      <i class="ti ti-chevron-down ct-chevron"></i>
                    </div>
                    <div class="ct-card-body">
                      Nombre inconnu, chaotiques, sans conscience, guidées par l'instinct de destruction. Incarnent des catastrophes vivantes : titans, aberrations, horreurs anciennes.<br><br>
                      <span style="color:#ffd0d0;font-weight:700;">⬆</span> Une Bête Effroyable qui tue une Légendaire devient soudain <em>intelligente et consciente</em>.
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;">
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Kraken" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">KRAKEN · Terreur des profondeurs</div>
                    </div>
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Dragon de l'Ombre" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">DRAGON DE L'OMBRE · Ravageur</div>
                    </div>
                    </div>
                    </div>
                  </div>
                  <div style="margin-top:10px;font-size:10.5px;color:rgba(255,160,160,.45);font-style:italic;text-align:center;">
                    → Peut accéder au rang Légendaire
                  </div>
                </div>

                <!-- BRANCHE MILIEU : Rares -->
                <div style="display:flex;flex-direction:column;align-items:center;width:260px;">
                  <div class="ct-up-tick"></div>
                  <div class="ct-card ct-rare" onclick="ctToggle(this)" style="width:240px;">
                    <div class="ct-card-header">
                      <div class="ct-card-title">④ BÊTES RARES</div>
                      <div class="ct-card-sub">Dragons · Créatures conscientes</div>
                      <i class="ti ti-chevron-down ct-chevron"></i>
                    </div>
                    <div class="ct-card-body">
                      Ont une conscience, contrairement aux Effroyables. Créatures puissantes, exotiques, souvent uniques ou très peu nombreuses.<br><br>
                      <span style="color:#80e0c0;font-weight:700;">⬇</span> Peuvent basculer en Bêtes Effroyables par une <em>chute morale</em> : massacres ou perte de conscience.
                      <div style="margin-top:8px;">
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Dragon de Brume" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">DRAGON DE BRUME · Spectre des cieux</div>
                    </div>
                    </div>
                    </div>
                  </div>
                  <div style="margin-top:10px;font-size:10.5px;color:rgba(120,210,180,.45);font-style:italic;text-align:center;">
                    ↑ Ascension depuis les Communes possible
                  </div>
                </div>

                <!-- BRANCHE DROITE : Communes -->
                <div style="display:flex;flex-direction:column;align-items:center;width:260px;">
                  <div class="ct-up-tick"></div>
                  <div class="ct-card ct-commune" onclick="ctToggle(this)" style="width:240px;">
                    <div class="ct-card-header">
                      <div class="ct-card-title">⑤ CRÉATURES COMMUNES</div>
                      <div class="ct-card-sub">Races · Monstres · Esprits faibles</div>
                      <i class="ti ti-chevron-down ct-chevron"></i>
                    </div>
                    <div class="ct-card-body">
                      Les races d'Alésia (humains, nains, elfes, kitsune…), les créatures ordinaires (gobelins, orcs, animaux) et les esprits faibles. Les plus nombreux, les moins proches du cycle divin.<br><br>
                      <span style="color:#c0c0e0;font-weight:700;">⬆</span> Certaines peuvent devenir des Bêtes Rares par ascension, mutation ou quête épique.
                      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;">
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Créature de la Terre" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">Peuples des royaumes</div>
                    </div>
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Créature de la Mer" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">Vie des profondeurs</div>
                    </div>
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Créature du Ciel" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">Volatiles des cieux</div>
                    </div>
                      <div style="border-radius:8px;overflow:hidden;border:1px solid rgba(100,100,100,.3);margin-top:8px;">
                      <img src="xxx" alt="Créature Magique" style="width:100%;height:100px;object-fit:cover;display:block;">
                      <div style="padding:5px 8px;text-align:center;font-size:10px;opacity:.75;font-style:italic;">Petits esprits étranges</div>
                    </div>
                    </div>
                    </div>
                  </div>
                  <div style="margin-top:10px;font-size:10.5px;color:rgba(160,160,210,.45);font-style:italic;text-align:center;">
                    Base du cycle — la plus grande diversité
                  </div>
                </div>

              </div><!-- fin flex branches -->
            </div><!-- fin position:relative -->

          </div><!-- fin cosmo-tree -->

          <!-- LÉGENDE -->
          <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:28px;">
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#A09070;"><span style="width:12px;height:12px;border-radius:3px;background:linear-gradient(135deg,#8B6914,#C9A84C);display:inline-block;"></span>Déïque</div>
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#A09070;"><span style="width:12px;height:12px;border-radius:3px;background:linear-gradient(135deg,#4a2060,#7B3FA0);display:inline-block;"></span>Légendaire</div>
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#A09070;"><span style="width:12px;height:12px;border-radius:3px;background:linear-gradient(135deg,#5c1a1a,#8B2020);display:inline-block;"></span>Effroyable</div>
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#A09070;"><span style="width:12px;height:12px;border-radius:3px;background:linear-gradient(135deg,#1a4a30,#1D6B5A);display:inline-block;"></span>Rare</div>
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#A09070;"><span style="width:12px;height:12px;border-radius:3px;background:linear-gradient(135deg,#2a2a3a,#3a3a5a);display:inline-block;"></span>Commune</div>
          </div>

        </div><!-- fin cosmo-tree-wrap -->

      </div>

            <!-- CRÉATION PERSONNAGE (livret) -->
      <div id="s-creation" class="section">
        <div class="page-title"><i class="ti ti-user-plus"></i> Création de personnage</div>
        <div id="tuto-wrap"></div>
      </div>

      <!-- RÈGLES (livret) -->
      <div id="s-regles" class="section">
        <div class="page-title"><i class="ti ti-book-2"></i> Règles du jeu</div>
        <div id="regles-tuto-wrap"></div>
      </div>

      <!-- NÉGOCIATION -->
      <div id="s-negociation" class="section">
        <div class="page-title"><i class="ti ti-scale"></i> Négociation</div>
        <div class="grid2" style="align-items:start;">
          <div class="card">
            <div class="sdiv">⚖️ Mise en place</div>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div>
                <div style="font-size:17.2px;color:var(--gold-d);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">Prix de base</div>
                <input type="number" id="neg-base" value="5000" style="width:100%;background:rgba(0,0,0,.3);border:1px solid var(--bord);border-radius:6px;color:#F2E6CC;padding:8px 10px;font-family:'Cinzel',serif;font-size:21.9px;">
              </div>
              <button class="vpanel-edit" style="justify-content:center;" onclick="negStart()"><i class="ti ti-refresh"></i> Nouvelle négociation</button>
              <div id="neg-rounds" style="display:flex;flex-direction:column;gap:10px;margin-top:6px;"></div>
            </div>
          </div>
          <div class="card" style="text-align:center;">
            <div class="sdiv" style="justify-content:center;">💰 Résultat</div>
            <div style="font-family:'Cinzel',serif;font-size:17.2px;letter-spacing:.1em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Prix actuel</div>
            <div id="neg-price" style="font-family:'Cinzel',serif;font-size:65.6px;color:var(--gold);margin-bottom:14px;">5000 <span style="font-size:28.1px;">PO</span></div>
            <div style="display:flex;justify-content:center;margin-bottom:14px;">
              <svg viewBox="0 0 220 150" width="220" height="150" xmlns="http://www.w3.org/2000/svg" style="overflow:visible;">
                <text x="36" y="14" text-anchor="middle" font-family="'Cinzel',serif" font-size="9" letter-spacing="0.1em" fill="var(--gold-d)">JOUEUR</text>
                <text x="184" y="14" text-anchor="middle" font-family="'Cinzel',serif" font-size="9" letter-spacing="0.1em" fill="var(--gold-d)">MARCHAND</text>
                <!-- pied de la balance -->
                <path d="M95 110 L125 110 L110 86 Z" fill="rgba(212,168,67,.15)" stroke="var(--gold-d)" stroke-width="1.5"/>
                <line x1="110" y1="86" x2="110" y2="78" stroke="var(--gold-d)" stroke-width="2"/>
                <g id="neg-balance-beam" style="transform-origin:110px 78px;transition:transform .6s cubic-bezier(.34,1.56,.64,1);">
                  <line x1="20" y1="78" x2="200" y2="78" stroke="var(--gold)" stroke-width="3" stroke-linecap="round"/>
                  <line x1="20" y1="78" x2="20" y2="102" stroke="var(--gold-d)" stroke-width="1.5"/>
                  <line x1="200" y1="78" x2="200" y2="102" stroke="var(--gold-d)" stroke-width="1.5"/>
                  <path d="M2 102 Q20 120 38 102 Z" fill="rgba(95,174,90,.18)" stroke="#5FAE5A" stroke-width="1.5"/>
                  <path d="M182 102 Q200 120 218 102 Z" fill="rgba(212,90,80,.18)" stroke="#D47A6A" stroke-width="1.5"/>
                </g>
                <circle cx="110" cy="78" r="3" fill="var(--gold)"/>
              </svg>
            </div>
            <div id="neg-log" style="display:flex;flex-direction:column;gap:5px;text-align:left;"></div>
            <div id="neg-final" style="margin-top:14px;"></div>
          </div>
        </div>
        <div class="card" style="margin-top:14px;">
          <div class="sdiv">📖 Rappel des règles</div>
          <div style="font-size:18.8px;color:#CFC09A;line-height:1.6;margin-bottom:10px;">La négociation se joue en <strong style="color:#F2E6CC;">3 manches</strong>. À chaque manche, le Joueur et le Marchand s'affrontent (lancé de dé). Le résultat fait évoluer le prix par rapport au prix <strong style="color:#F2E6CC;">actuel</strong> — sauf en cas d'Égalité ou de Critique, qui fixent immédiatement le prix final par rapport au <strong style="color:#F2E6CC;">prix de base</strong> et arrêtent la négociation.</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;">
            <div style="background:rgba(212,168,67,.05);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Victoire Joueur</div>
              <div style="font-size:18.8px;color:#CFC09A;">Le prix actuel <strong style="color:var(--teal);">baisse</strong> de 10 / 20 / 30% selon la manche (1 / 2 / 3).</div>
            </div>
            <div style="background:rgba(212,168,67,.05);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Victoire Marchand</div>
              <div style="font-size:18.8px;color:#CFC09A;">Le prix actuel <strong style="color:var(--red);">augmente</strong> de 10 / 20 / 30% selon la manche (1 / 2 / 3).</div>
            </div>
            <div style="background:rgba(212,168,67,.05);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Égalité <span style="color:#CFC09A;font-weight:400;">— fin immédiate</span></div>
              <div style="font-size:18.8px;color:#CFC09A;">Le prix est ramené à <strong style="color:var(--teal);">20% du prix de base</strong> (−80%). Très favorable au Joueur.</div>
            </div>
            <div style="background:rgba(74,160,80,.06);border:1px solid rgba(74,160,80,.2);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:#5FAE5A;text-transform:uppercase;margin-bottom:6px;">Crit. Succès Joueur <span style="color:#CFC09A;font-weight:400;">— fin immédiate</span></div>
              <div style="font-size:18.8px;color:#CFC09A;">Prix final = <strong style="color:var(--teal);">50% du prix de base</strong> (−50%).</div>
            </div>
            <div style="background:rgba(160,60,50,.06);border:1px solid rgba(160,60,50,.2);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:#D47A6A;text-transform:uppercase;margin-bottom:6px;">Crit. Échec Joueur <span style="color:#CFC09A;font-weight:400;">— fin immédiate</span></div>
              <div style="font-size:18.8px;color:#CFC09A;">Prix final = <strong style="color:var(--red);">300% du prix de base</strong> (×3).</div>
            </div>
            <div style="background:rgba(160,60,50,.06);border:1px solid rgba(160,60,50,.2);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:#D47A6A;text-transform:uppercase;margin-bottom:6px;">Crit. Succès Marchand <span style="color:#CFC09A;font-weight:400;">— fin immédiate</span></div>
              <div style="font-size:18.8px;color:#CFC09A;">Prix final = <strong style="color:var(--red);">200% du prix de base</strong> (×2).</div>
            </div>
            <div style="background:rgba(74,160,80,.06);border:1px solid rgba(74,160,80,.2);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:#5FAE5A;text-transform:uppercase;margin-bottom:6px;">Crit. Échec Marchand <span style="color:#CFC09A;font-weight:400;">— fin immédiate</span></div>
              <div style="font-size:18.8px;color:#CFC09A;">Prix final = <strong style="color:var(--teal);">50% du prix de base</strong> (−50%).</div>
            </div>
            <div style="background:rgba(212,168,67,.05);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:10px 12px;">
              <div style="font-family:'Cinzel',serif;font-size:15.6px;letter-spacing:.08em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Les 3 manches jouées</div>
              <div style="font-size:18.8px;color:#CFC09A;">Sans Égalité ni Critique, le prix final est celui obtenu après l'enchaînement des 3 manches.</div>
            </div>
          </div>
        </div>
      </div>
      <div id="s-economie" class="section">
        <div class="page-title"><i class="ti ti-coins"></i> Économie du monde</div>
        <div class="grid2">
          <div class="card">
            <div class="sdiv">🍞 Nourriture & Boissons</div>
            <div style="display:flex;flex-direction:column;gap:4px;">
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Ration quotidienne (1 personne)</span><span style="font-family:'Cinzel',serif;color:#C09030;">5 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Ration de voyage (longue conservation)</span><span style="font-family:'Cinzel',serif;color:#C09030;">10 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Ration de luxe</span><span style="font-family:'Cinzel',serif;color:#C09030;">25 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Repas simple à l'auberge</span><span style="font-family:'Cinzel',serif;color:#C09030;">5 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Repas correct</span><span style="font-family:'Cinzel',serif;color:#C09030;">10 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Repas de luxe</span><span style="font-family:'Cinzel',serif;color:#C09030;">25 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Bière (pinte)</span><span style="font-family:'Cinzel',serif;color:#C09030;">5 PO</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Bière artisanale / spéciale</span><span style="font-family:'Cinzel',serif;color:#C09030;">10 PO</span></div>
