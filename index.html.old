              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Chambre simple (privée)</span><span style="font-family:'Cinzel',serif;color:#C09030;">10 PO/nuit</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;border-bottom:1px solid var(--bord);"><span style="color:#CFC09A;">Chambre de bonne qualité</span><span style="font-family:'Cinzel',serif;color:#C09030;">25 PO/nuit</span></div>
              <div style="color:#CFC09A;display:flex;justify-content:space-between;font-size:18.8px;padding:5px 0;"><span style="color:#CFC09A;">Suite noble</span><span style="font-family:'Cinzel',serif;color:#C09030;">50–100 PO/nuit</span></div>
