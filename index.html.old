  {id:2,nom:'Royaume Brumelonde',type:'Royaume sylvestre',icon:'🌲',statut:'ally',badge:'Favorable',desc:'Royaume des grandes forêts anciennes, gouverné par un conseil de druides. Protecteurs de la nature et des équilibres magiques.',details:'Capitale : Brumeclair · Gouvernement : Conseil druidique · Particularité : Forêts sacrées'},
