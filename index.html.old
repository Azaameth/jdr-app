<!-- Modale slot inventaire -->
<div id="inv-slot-modal" style="display:none;position:fixed;inset:0;z-index:2100;background:rgba(0,0,0,.75);align-items:center;justify-content:center;" onclick="if(event.target===this)closeInvSlot()">
  <div style="background:linear-gradient(160deg,#1A1005,#100A03);border:1px solid rgba(212,168,67,.35);border-radius:12px;width:340px;padding:24px;position:relative;">
    <button onclick="closeInvSlot()" style="position:absolute;top:12px;right:14px;background:none;border:none;color:#907050;font-size:22px;cursor:pointer;">✕</button>
    <div style="font-family:'Cinzel',serif;font-size:16px;color:#D4A843;margin-bottom:16px;"><i class="ti ti-package" style="margin-right:8px;"></i>Modifier l'emplacement</div>
    <input type="hidden" id="inv-slot-char">
    <input type="hidden" id="inv-slot-cat">
    <input type="hidden" id="inv-slot-idx">
    <label style="font-size:12px;color:#8A6A30;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:5px;">Nom de l'objet</label>
    <input id="inv-slot-name" type="text" placeholder="ex: Kit médical" onkeydown="if(event.key==='Enter')saveInvSlot()" style="width:100%;background:rgba(50,36,16,.9);border:1px solid rgba(212,168,67,.4);border-radius:6px;padding:8px 10px;color:#F2E6CC;font-size:15px;outline:none;box-sizing:border-box;margin-bottom:12px;">
    <div id="inv-slot-stat-wrap" style="display:none;">
      <label id="inv-slot-stat-label" style="font-size:12px;color:#8A6A30;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:5px;">Valeur</label>
      <input id="inv-slot-stat" type="text" placeholder="ex: D10/+4" onkeydown="if(event.key==='Enter')saveInvSlot()" style="width:100%;background:rgba(50,36,16,.9);border:1px solid rgba(212,168,67,.4);border-radius:6px;padding:8px 10px;color:#F2E6CC;font-size:15px;outline:none;box-sizing:border-box;margin-bottom:12px;">
    </div>
    <div id="inv-slot-qty-wrap">
    <label style="font-size:12px;color:#8A6A30;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:5px;">Quantité <span style="color:#604830;font-style:italic;">(optionnel)</span></label>
    <input id="inv-slot-qty" type="number" min="1" placeholder="ex: 4" onkeydown="if(event.key==='Enter')saveInvSlot()" style="width:100%;background:rgba(50,36,16,.9);border:1px solid rgba(212,168,67,.4);border-radius:6px;padding:8px 10px;color:#F2E6CC;font-size:15px;outline:none;box-sizing:border-box;margin-bottom:16px;">
    </div>
    <div style="display:flex;gap:8px;">
      <button onclick="saveInvSlot()" style="flex:1;background:linear-gradient(135deg,rgba(160,120,32,.5),rgba(212,168,67,.3));border:1px solid rgba(212,168,67,.5);color:#F2E6CC;border-radius:7px;padding:9px;font-family:'Cinzel',serif;font-size:13px;cursor:pointer;letter-spacing:.05em;"><i class="ti ti-check" style="margin-right:6px;"></i>Valider</button>
      <button id="inv-slot-del" onclick="deleteInvSlot()" style="display:none;background:rgba(192,48,48,.15);border:1px solid rgba(192,48,48,.4);color:#D06050;border-radius:7px;padding:9px 14px;font-family:'Cinzel',serif;font-size:13px;cursor:pointer;"><i class="ti ti-trash"></i></button>
    </div>
  </div>
</div>
<!-- Modale Don -->
<div id="don-modal" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.75);align-items:center;justify-content:center;" onclick="if(event.target===this)closeDonModal()">
  <div style="background:linear-gradient(160deg,#1A1005,#100A03);border:1px solid rgba(212,168,67,.35);border-radius:14px;max-width:780px;width:92%;padding:36px;position:relative;box-shadow:0 0 60px rgba(0,0,0,.8);">
    <button onclick="closeDonModal()" style="position:absolute;top:16px;right:18px;background:none;border:none;color:#907050;font-size:28px;cursor:pointer;line-height:1;">✕</button>
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:22px;padding-bottom:16px;border-bottom:1px solid rgba(212,168,67,.2);">
      <div id="don-modal-icon" style="font-size:42px;line-height:1;"></div>
      <div id="don-modal-title" style="font-family:'Cinzel',serif;font-size:30px;color:#F2E6CC;font-weight:600;"></div>
    </div>
    <div style="display:flex;gap:14px;margin-bottom:24px;">
      <div style="flex:1;text-align:center;background:rgba(80,100,200,.12);border:1px solid rgba(80,100,200,.3);border-radius:8px;padding:12px;">
        <div id="don-modal-mana" style="font-family:'Cinzel',serif;font-size:26px;font-weight:700;color:#8090E0;"></div>
        <div style="font-size:15px;color:#5060A0;letter-spacing:.08em;margin-top:4px;">MANA</div>
      </div>
      <div style="flex:1;text-align:center;background:rgba(200,80,40,.1);border:1px solid rgba(200,80,40,.3);border-radius:8px;padding:12px;">
        <div id="don-modal-des" style="font-family:'Cinzel',serif;font-size:26px;font-weight:700;color:#D07050;"></div>
        <div style="font-size:15px;color:#904030;letter-spacing:.08em;margin-top:4px;">DÉS</div>
      </div>
      <div style="flex:1;text-align:center;background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.25);border-radius:8px;padding:12px;">
        <div id="don-modal-bon" style="font-family:'Cinzel',serif;font-size:26px;font-weight:700;color:#D4A843;"></div>
        <div style="font-size:15px;color:#906830;letter-spacing:.08em;margin-top:4px;">BONUS</div>
      </div>
    </div>
    <div id="don-modal-desc" style="font-size:19px;color:#C0B090;line-height:1.85;white-space:pre-line;"></div>
  </div>
</div>
</body>
</html>
