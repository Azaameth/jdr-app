  {id:4,nom:"Royaume d'Akassya",type:'Royaume elfique',icon:'🧝',statut:'neutre',badge:'Neutre',desc:"Royaume des Elfes et des Ents, couvert de forêts magiques. Berceau de Dy Son. Observe la Prophétie avec curiosité.",details:"Capitale : Sylvaris · Gouvernement : Conseil des Anciens · Races : Elfes, Ents"},
  {id:5,nom:'Royaume saint de Zarûn',type:'Théocratie lacustre',icon:'💧',statut:'neutre',badge:'Neutre',desc:"Gardiens des eaux sacrées du Lac. Les prêtres de Zarûn veillent sur le sanctuaire et condamnent toute approche de l'Île.",details:"Capitale : Zarûnath · Gouvernement : Grand Prêtre · Doctrine : Neutralité sacrée"},
  {id:6,nom:'Empire Lucèmien',type:'Empire cosmopolite',icon:'🏛',statut:'neutre',badge:'Neutre',desc:"Vaste empire commerçant qui préfère l'équilibre à la confrontation. Commerce et neutralité avant tout.",details:"Capitale : Lucèmia · Gouvernement : Empereur élu · Spécialité : Commerce, diplomatie"},
  {id:7,nom:'Terre du cdt. Suba',type:'Régime militaire',icon:'⚔',statut:'neutre',badge:'Neutre',desc:"Territoire autoritaire sous la coupe d'un commandant militaire. Ses légions sont redoutées.",details:"Capitale : Fort-Suba · Gouvernement : Dictature militaire · Pratiques : Esclavage légal"},
  {id:8,nom:'Royaume Démonique de Vermeil',type:'Aristocratie infernale',icon:'👿',statut:'hostile',badge:'Hostile',desc:"Aristocratie infernale régie par des pactes démoniques. Magie noire et cruauté. Convoite l'Île du Cœur.",details:"Capitale : Vermeilath · Gouvernement : Conseil des Seigneurs démons · Magie : Noire"},
  {id:9,nom:'Autocratie Vyrrag',type:'État guerrier nordique',icon:'🏔',statut:'hostile',badge:'Hostile',desc:"Nation de guerriers endurcis des montagnes glaciales. S'oppose violemment à la Prophétie.",details:"Capitale : Vyrragheim · Gouvernement : Autocratie absolue · Armée : Guerriers d'élite"},
  {id:10,nom:'Empire de Lutèce',type:'Empire expansionniste',icon:'🦅',statut:'hostile',badge:'Hostile',desc:"Vaste empire à la discipline militaire implacable. En expansion constante. Voit dans la Prophétie une menace.",details:"Capitale : Lutèce Magnus · Gouvernement : Conseil impérial · Ambition : Unification forcée"},
  {id:11,nom:'Cité-État Mont RokDur',type:'Enclave draconienne et naine',icon:'🐉',statut:'hostile',badge:'Défavorable',desc:"Cité forteresse perchée dans les montagnes. Nains et draconiens sous une loi de fer. Hostilité durable envers les Téméraires.",details:"Capitale : RokDur · Gouvernement : Conseil des Forges · Races : Nains, Draconiens"}
];

window.selectRoyaume = function(idx, nodeEl) {
  document.querySelectorAll('.royaume-node').forEach(function(n){ n.classList.remove('active'); });
  if(nodeEl) nodeEl.classList.add('active');
  var roy = window.ROYAUMES[idx];
  if(!roy) return;
  var card = document.getElementById('royaume-card');
  if(!card) return;
  var badgeClass = roy.statut==='hostile'?'hostile':roy.statut==='ally'?'ally':'';
  var imgEl = document.getElementById('rimg-'+idx);
  var imgHtml = (imgEl && imgEl.src && imgEl.src.length > 50)
    ? '<img src="'+imgEl.src+'" alt="'+roy.nom+'" class="royaume-card-img">'
    : '<div class="royaume-card-img-placeholder"><span style="font-size:48px;opacity:.4;">'+roy.icon+'</span></div>';
  card.innerHTML = '<div class="royaume-card-anim">'+imgHtml
    +'<div class="royaume-card-body">'
    +'<div class="royaume-card-name">'+roy.nom+'</div>'
    +'<div class="royaume-card-type">'+roy.type+'</div>'
    +'<div class="royaume-card-desc">'+roy.desc+'</div>'
    +'<div style="font-size:11px;color:#907860;border-top:1px solid rgba(212,168,67,.1);padding-top:10px;">'+roy.details+'</div>'
    +'</div><div class="royaume-card-footer">'
    +'<span style="font-size:11px;color:#604A28;font-family:Cinzel,serif;">RAPPORT AUX TÉMÉRAIRES</span>'
    +'<span class="badge '+badgeClass+'">'+roy.badge+'</span>'
    +'</div></div>';
};

// Délégation clic royaumes
document.addEventListener('click', function(e) {
  var node = e.target.closest ? e.target.closest('.royaume-node, .royaume-region') : null;
  if(node && node.dataset && node.dataset.idx !== undefined) {
    var idx = parseInt(node.dataset.idx);
    if(node.closest('#s-accueil')){
      // Carte d'accueil : on bascule vers l'onglet 12 Royaumes et on ouvre directement la fiche
      var navEl = document.getElementById('nav-item-royaumes');
      showSec('royaumes', navEl);
      var target = document.querySelector('#s-royaumes .royaume-node[data-idx="'+idx+'"]');
      if(target) window.selectRoyaume(idx, target);
    } else {
      window.selectRoyaume(idx, node);
    }
  }
});

// Ouverture du portail (double porte) sur la page d'accueil
window.openPortal = function(){
  var wrap = document.getElementById('portal-wrap');
  if(!wrap || wrap.classList.contains('open')) return;
  wrap.classList.add('open');
  setTimeout(function(){
    var hc = document.getElementById('home-content');
    if(hc) hc.classList.add('show');
    document.getElementById('app')?.classList.remove('portal-mode');
    wrap.classList.add('portal-done');
  }, 550);
};

// Retour à l'accueil (clic sur le logo du header)
window.goHome = function(){
  var navEl = document.getElementById('nav-item-accueil');
  var wrap = document.getElementById('portal-wrap');
  var hc = document.getElementById('home-content');
  if(wrap){ wrap.classList.remove('open'); wrap.classList.remove('portal-done'); }
  if(hc) hc.classList.remove('show');
  document.getElementById('app')?.classList.add('portal-mode');
  showSec('accueil', navEl);
};

// Sync PV/Mana en temps réel

// ===== VITRUVE PANEL =====
const EMOJI_ICON = {
  '🔥':'ti-flame','🌬':'ti-wind','💨':'ti-wind','🔮':'ti-eye','🌑':'ti-moon','✨':'ti-sparkles',
  '📚':'ti-book','⚔':'ti-swords','💥':'ti-bolt','🌿':'ti-leaf','💪':'ti-barbell','🌸':'ti-flower',
  '👁':'ti-eye','🛡':'ti-shield','🥁':'ti-music','💧':'ti-droplet','🤝':'ti-handshake','🔨':'ti-hammer',
  '⚡':'ti-bolt','🌊':'ti-droplet'
};
function stripLeadingEmoji(str){
  return str.replace(/^[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\uFE0F]+\s*/u,'').trim();
}
function iconForText(str){
  const s=(str||'').toLowerCase();
  for(const key in EMOJI_ICON){ if(str && str.indexOf(key)===0) return EMOJI_ICON[key]; }
  if(/ration/.test(s)) return 'ti-bread';
  if(/sac|besace|sacoche/.test(s)) return 'ti-briefcase';
  if(/kit médical|bandage|potion|soin/.test(s)) return 'ti-first-aid-kit';
  if(/boussole/.test(s)) return 'ti-compass';
  if(/parchemin|livre|grimoire|tome/.test(s)) return 'ti-book';
  if(/corde/.test(s)) return 'ti-circle-dot';
  if(/lanterne|torche/.test(s)) return 'ti-bulb';
  if(/balle|munition|silex|pistolet|fusil|arc\b/.test(s)) return 'ti-target';
  if(/anneau|bague/.test(s)) return 'ti-circle-dot';
  if(/rune/.test(s)) return 'ti-stars';
  if(/crochetage|crochet/.test(s)) return 'ti-key';
  if(/tambourin|castagnette|musique/.test(s)) return 'ti-music';
  if(/épée|epee|dague|hache|lame|marteau|pioche|bâton|baton|wok|lance\b|arme/.test(s)) return 'ti-sword';
  if(/robe|armure|bouclier|cuirasse/.test(s)) return 'ti-shield';
  return 'ti-package';
}
function parseQty(str){
  const m=str.match(/^(.*?)\s*[x×]\s*(\d+)\s*$/i);
  if(m) return {name:m[1].trim(),qty:m[2]};
  return {name:str.trim(),qty:null};
}
function parseStat(str){
  const m=str.match(/^(.*?)\s*\(([^)]*)\)\s*$/);
  if(m) return {name:m[1].trim(),stat:m[2].trim()};
  return {name:str.trim(),stat:null};
}
function vcard(icon,label,value,sub){
  return '<div class="vcard center"><div class="vcard-icon"><i class="ti '+icon+'" aria-hidden="true"></i></div>'
    +(label?'<div class="vcard-lbl">'+label+'</div>':'')
    +'<div class="vcard-val">'+value+'</div>'
    +(sub?'<div class="vcard-sub">'+sub+'</div>':'')+'</div>';
}
function vcardRow(icon,label,value,sub){
  return '<div class="vcard"><div class="vcard-row"><i class="ti '+icon+'" aria-hidden="true"></i><span class="vcard-val">'+label+'</span></div>'
    +(value?'<div class="vcard-sub">'+value+(sub?(' · '+sub):'')+'</div>':'')+'</div>';
}

window.vitruveEditField=(name,zone,field)=>{
  const pc=document.getElementById('vpanel-content');
  const cur=charData[name][field]??'';
  const ta=document.createElement('textarea');ta.className='ef-area';ta.value=cur;ta.rows=6;
  pc.innerHTML='';pc.appendChild(ta);ta.focus();
  ta.onblur=async()=>{
    charData[name][field]=ta.value.trim();
    await saveChar(name);
    vitruveShowPanel(name,zone);
  };
};

function editBtn(name,zone,field,label){
  if(!isMJ) return '';
  return '<button class="vpanel-edit" onclick="vitruveEditField(\''+name+'\',\''+zone+'\',\''+field+'\')"><i class="ti ti-pencil"></i> '+(label||'Modifier')+'</button>';
}

function vitruveShowPanel(name, tab){
  const c = charData[name];
  if(!c) return;
  const pc = document.getElementById('vpanel-content');
  let html = '';

  if(tab==='fiche'){
    html += '<div class="vpanel-head"><i class="ti ti-id-badge-2"></i> Fiche</div>';
    html += '<div class="vcard-grid">'
      + vcard('ti-paw','Race',c.race||'—')
      + vcard('ti-gender-'+((c.genre||'').toLowerCase()==='femme'?'female':'male'),'Genre',c.genre||'—')
      + vcard('ti-language','Langues',c.langues||'—')
      + '</div>';
    const valList = (c.valeurs||'').split('\n').filter(v=>v.trim());
    if(valList.length) html += '<div class="vcard"><div class="vcard-lbl"><i class="ti ti-compass" aria-hidden="true"></i> Valeurs</div><div class="vpills" style="margin-top:8px;">' + valList.map(v=>'<span class="vpill">'+v.trim()+'</span>').join('') + '</div></div>';
    html += '<div class="vcard" style="margin-top:10px;border-left:2px solid rgba(160,120,32,.5);"><div class="vcard-lbl">Histoire</div><div class="vcard-val">'+(c.notes||'—')+'</div></div>';
    html += editBtn(name,'fiche','notes','Modifier l\'histoire');
  }

  else if(tab==='carac'){
    html += '<div class="vpanel-head"><i class="ti ti-chart-bar"></i> Caractéristiques</div>';

    // Posture defaults per character
    const POSTURE_DEFAULT = {azarius:'offensif',dy:'focus',firm:'defensif',mwassa:'focus',nindey:'offensif'};
    if(!window._postures) window._postures = {};
    if(window._postures[name]===undefined) window._postures[name] = POSTURE_DEFAULT[name] || 'focus';
    const curPost = window._postures[name];
    const postLabels = {focus:'Focus',offensif:'Offensif',defensif:'Défensif'};
    const postColors = {
      focus:   {active:'rgba(80,140,200,.25)',border:'#5090D0',text:'#80C0F0'},
      offensif:{active:'rgba(192,60,40,.25)', border:'#C04030',text:'#E07060'},
      defensif:{active:'rgba(192,168,40,.2)', border:'#C0A830',text:'#D4A843'}
    };
    const POSTURE_FX = {
      focus:   { icon:'✨', lines:['Dégâts normaux (lance le dé)','Bonus +5% sur tous les jets','Coût Mana réduit de 1','Pas d esquive possible'] },
      offensif:{ icon:'⚔', lines:['Dégâts maximum automatiques','Zone critique élargie +5%','Aucune esquive ou parade possible'] },
      defensif:{ icon:'🛡', lines:['Dégâts normaux','1 esquive ou 1 parade par tour','Pas de bonus offensif'] }
    };
    const fx = POSTURE_FX[curPost];
    const fxCol = postColors[curPost];
    const tooltipId = 'ptip-'+name;
    const tipLines = fx.lines.map(l=>'<div style="display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;"><span style="color:'+fxCol.border+';flex-shrink:0;">·</span><span style="color:#C8B888;font-size:14px;">'+l+'</span></div>').join('');
    // Tooltip
    let postHtml = '<div style="position:relative;" onmouseenter="document.getElementById(\''+tooltipId+'\').style.display=\'block\'" onmouseleave="document.getElementById(\''+tooltipId+'\').style.display=\'none\'">';
    postHtml += '<div id="'+tooltipId+'" style="display:none;position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#1A1208;border:1px solid '+fxCol.border+';border-radius:8px;padding:10px 14px;min-width:240px;z-index:500;pointer-events:none;box-shadow:0 4px 20px rgba(0,0,0,.8);">';
    postHtml += '<div style="font-family:\'Cinzel\',serif;font-size:14px;color:'+fxCol.text+';margin-bottom:8px;">'+fx.icon+' '+postLabels[curPost]+'</div>';
    postHtml += tipLines+'</div>';
    // Card
    postHtml += '<div style="background:rgba(45,30,10,.7);border:1px solid rgba(212,168,67,.15);border-radius:8px;padding:10px;text-align:center;">';
    postHtml += '<i class="ti ti-shield-half" style="font-size:20px;color:#D4A843;" aria-hidden="true"></i>';
    postHtml += '<div style="font-size:11px;letter-spacing:.12em;color:#8A6A30;text-transform:uppercase;margin:6px 0 8px;">Posture</div>';
    postHtml += '<div style="display:flex;gap:4px;">';
    ['focus','offensif','defensif'].forEach(p=>{
      const isActive = p===curPost;
      const col = postColors[p];
      const bg = isActive ? col.active : 'transparent';
      const border = isActive ? col.border : 'rgba(212,168,67,.2)';
      const color = isActive ? col.text : 'rgba(212,168,67,.3)';
      postHtml += '<div onclick="setPosture(\''+name+'\',\''+p+'\')" style="flex:1;padding:5px 2px;border-radius:6px;cursor:pointer;font-family:\'Cinzel\',serif;font-size:12px;border:1px solid '+border+';background:'+bg+';color:'+color+';transition:all .15s;">'+postLabels[p]+'</div>';
    });
    postHtml += '</div></div></div>';

    html += '<div class="vcard-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:18px;">'
      + vcard('ti-heart','PV / '+c.pv_max, c.pv)
      + vcard('ti-droplet','Mana / '+c.mana_max, c.mana)
      + vcard('ti-star','Niveau', c.niveau)
      + postHtml
      + '</div>';


    // Map compétences by name for quick lookup
    const compMap = {};
    (c.competences||[]).forEach(cp=>{ compMap[cp.n.toLowerCase().split(' ')[0]] = cp.v; });
    const getComp = (keys) => { for(const k of keys){ const v=compMap[k]; if(v!==undefined) return v; } return '—'; };

    const CATS = [
      { key:'physique', label:'Physique', pct: c.phys, color:'#C07830', bg:'rgba(160,80,20,.12)',
        subs:[
          { label:'Puissance', val: getComp(['puissance']) },
          { label:'Finesse',   val: getComp(['finesse']) }
        ]
      },
      { key:'social', label:'Social', pct: c.social, color:'#30A070', bg:'rgba(30,120,80,.12)',
        subs:[
          { label:'Aura',     val: getComp(['aura']) },
          { label:'Relation', val: getComp(['relation']) }
        ]
      },
      { key:'mental', label:'Mental', pct: c.mental, color:'#4080C0', bg:'rgba(40,80,160,.12)',
        subs:[
          { label:'Instinct', val: getComp(['instinct']) },
          { label:'Savoir',   val: getComp(['savoir']) }
        ]
      }
    ];

    const buildCatBlock = (cat) => {
      // Calcul du % ajusté selon les états des sous-caractéristiques
      const states = cat.subs.map((_,si)=>(window._caracStates && window._caracStates[name+'_'+cat.key+'_'+si])||'none');
      const nbJaune = states.filter(s=>s==='jaune').length;
      const nbRouge = states.filter(s=>s==='rouge').length;
      const allRouge = states.length > 0 && states.every(s=>s==='rouge');
      let adjPct, mainColor, blockBorder;
      if(allRouge){
        adjPct = 5;
        mainColor = '#C03030';
        blockBorder = 'border:2px solid #C03030;';
      } else {
        adjPct = Math.max(5, parseInt(cat.pct) - nbJaune*10 - nbRouge*20);
        mainColor = cat.color;
        blockBorder = 'border:1px solid rgba(212,168,67,.15);';
      }
      let b = '<div style="background:'+cat.bg+';'+blockBorder+'border-radius:12px;padding:14px 18px;flex:1;">';
      b += '<div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">';
      b += '<div style="font-family:\'Cinzel\',serif;font-size:24px;font-weight:700;color:'+mainColor+';text-transform:uppercase;letter-spacing:.06em;min-width:100px;">'+cat.label+'</div>';
      b += '<div style="flex:1;"><div style="height:8px;background:rgba(212,168,67,.08);border-radius:4px;"><div style="height:100%;width:'+adjPct+'%;background:'+mainColor+';border-radius:4px;opacity:.7;"></div></div></div>';
      b += '<div style="font-family:\'Cinzel\',serif;font-size:28px;font-weight:700;color:'+mainColor+';min-width:54px;text-align:right;">'+adjPct+'%</div>';
      b += '</div>';
      b += '<div style="display:flex;flex-direction:column;gap:8px;">';
      cat.subs.forEach((sub,si)=>{
        const stateKey = name+'_'+cat.key+'_'+si;
        const state = (window._caracStates && window._caracStates[stateKey]) || 'none';
        const sqColor = state==='jaune'?'#D4A843': state==='rouge'?'#C03030':'transparent';
        const sqBorder = state==='none'?'rgba(212,168,67,.35)':sqColor;
        const isRouge = state==='rouge';
        const isJaune = state==='jaune';
        const dispVal = isJaune ? Math.max(0, parseInt(sub.val)-1) : sub.val;
        const rowStyle = isRouge
          ? 'display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(0,0,0,.22);border-radius:8px;opacity:.4;'
          : 'display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(0,0,0,.22);border-radius:8px;';
        const labelStyle = isRouge
          ? 'flex:1;font-size:20px;color:#807060;text-decoration:line-through;'
          : 'flex:1;font-size:20px;color:#E0D8C8;';
        const valColor = isRouge ? '#605040' : isJaune ? '#D4A843' : cat.color;
        b += '<div style="'+rowStyle+'">';
        b += '<div style="'+labelStyle+'">'+sub.label+'</div>';
        b += '<div style="font-family:\'Cinzel\',serif;font-size:32px;font-weight:700;color:'+valColor+';min-width:36px;text-align:center;">'+(isRouge?'—':dispVal)+'</div>';
        b += '<div class="carac-sq" data-key="'+stateKey+'" onclick="cycleCaracState(this)" title="Cliquer pour changer l\'état" style="width:28px;height:28px;border:2px solid '+sqBorder+';border-radius:5px;cursor:pointer;background:'+sqColor+';flex-shrink:0;transition:all .2s;"></div>';
        b += '</div>';
      });
      b += '</div></div>';
      return b;
    };

    // Triangle : Mental centré en haut, Physique + Social côte à côte en bas
    const mental = CATS.find(c=>c.key==='mental');
    const physique = CATS.find(c=>c.key==='physique');
    const social = CATS.find(c=>c.key==='social');
    html += '<div style="display:flex;justify-content:center;margin-bottom:12px;">';
    html += buildCatBlock(mental);
    html += '</div>';
    html += '<div style="display:flex;gap:12px;margin-bottom:4px;">';
    html += buildCatBlock(physique);
    html += buildCatBlock(social);
    html += '</div>';

    // Compétences (bonus %) — seulement les compétences hors sous-carac principales
    const allComps = c.competences || [];
    const mainKeys = ['puissance','finesse','aura','relation','instinct','savoir'];
    const extras = allComps.filter(cp => {
      const low = cp.n.toLowerCase();
      // Exclude the 6 main sub-stats (plain name or "savoir (xxx)" variants)
      if(mainKeys.some(k => low === k || low.startsWith(k+' ('))) return false;
      return true;
    });

    html += '<div class="vsubhead" style="margin-top:16px;">Compétences</div>';
    if(extras.length){
      extras.forEach(cp=>{
        const pct = cp.v * 10;
        const ckKey = name + '__check__' + encodeURIComponent(cp.n).replace(/'/g,'%27') + '__' + pct;
        const checked = window._checkStates[ckKey] ? 'checked' : '';
        html += '<div style="display:flex;align-items:center;gap:10px;padding:6px 10px;background:rgba(0,0,0,.18);border-radius:7px;margin-bottom:5px;">';
        html += '<div style="flex:1;font-size:17px;color:#E0D8C8;">'+cp.n+'</div>';
        html += '<div style="font-family:\'Cinzel\',serif;font-size:22px;font-weight:700;color:#A09070;min-width:50px;text-align:right;">'+pct+'%</div>';
        html += '<input type="checkbox" '+checked+' onclick="toggleCheckState(\''+ckKey+'\',this)" title="Appliquer au calculateur" style="width:17px;height:17px;cursor:pointer;accent-color:#D4A843;flex-shrink:0;">';
        html += '</div>';
      });
    } else {
      html += '<div style="color:#A09070;font-style:italic;font-size:15px;padding:8px 0;">Aucune compétence spéciale.</div>';
    }

    const lines=(c.race_bonus||'').split('\n').filter(r=>r.trim());
    if(lines.length){
      html += '<div class="vsubhead" style="margin-top:14px;">Bonus & malus de race</div><div class="vcard-grid">' + lines.map(l=>{
        const isBonus=l.indexOf('🟢')===0 || /\+\d/.test(l);
        const clean=stripLeadingEmoji(l);
        const m=clean.match(/^(.*?)\s*([+−-]\s*\d+%?)\s*$/);
        const lbl=m?m[1].trim():clean, val=m?m[2].trim():'';
        // Parse numeric value (positive for bonus, negative for malus)
        let numVal = 0;
        if(val){
          const raw = val.replace('−','-').replace('%','').replace(' ','');
          numVal = parseInt(raw)||0;
        }
        const ckKey = name + '__check__' + encodeURIComponent(lbl).replace(/'/g,'%27') + '__' + numVal;
        const checked = window._checkStates[ckKey] ? 'checked' : '';
        return '<div class="vbm '+(isBonus?'bonus':'malus')+'" style="position:relative;padding-right:28px;">'
          + '<i class="ti '+(isBonus?'ti-arrow-up':'ti-arrow-down')+'" aria-hidden="true"></i>'
          + '<div><div class="vbm-lbl">'+lbl+'</div><div class="vbm-val">'+val+'</div></div>'
          + '<input type="checkbox" '+checked+' onclick="toggleCheckState(\''+ckKey+'\',this)" title="Appliquer au calculateur" style="position:absolute;top:8px;right:8px;width:15px;height:15px;cursor:pointer;accent-color:#D4A843;">'
          + '</div>';
      }).join('') + '</div>';
    }
    html += editBtn(name,'carac','race_bonus','Modifier bonus/malus');
  }

  else if(tab==='dons'){
    html += '<div class="vpanel-head"><i class="ti ti-sparkles"></i> Dons & Sorts</div>';
    const dons=(c.dons||'').split('\n').filter(d=>d.trim());
    if(dons.length){
      html += '<div style="display:flex;flex-direction:column;gap:10px;">';
      dons.forEach(d=>{
        const icon = iconForText(d);
        const clean = stripLeadingEmoji(d);
        let sep = clean.indexOf(' — ')>=0?' — ':(clean.indexOf(' : ')>=0?' : ':null);
        let nom=clean, eff='';
        if(sep){ const parts=clean.split(sep); nom=parts[0].trim(); eff=parts.slice(1).join(sep).trim(); }
        const donData = (DONS_DATA[name]||{})[nom] || {};
        const mana = donData.mana!==undefined ? String(donData.mana) : null;
        const des  = donData.des && donData.des!=='—' ? donData.des : null;
        const bon  = donData.bonus && donData.bonus!==0 ? (donData.bonus>0?'+'+donData.bonus:String(donData.bonus)) : null;
        html += '<div onclick="openDonModal(\''+name+'\',\''+nom.replace(/'/g,"\\'")+'\')" style="background:rgba(45,30,10,.6);border:1px solid rgba(212,168,67,.18);border-left:3px solid rgba(212,168,67,.5);border-radius:8px;padding:12px 16px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor=\'rgba(212,168,67,.5)\'" onmouseout="this.style.borderColor=\'rgba(212,168,67,.18)\'">';
        html += '<i class="ti '+icon+'" style="font-size:28px;color:rgba(212,168,67,.6);flex-shrink:0;" aria-hidden="true"></i>';
        html += '<div style="flex:1;">';
        html += '<div style="font-family:\'Cinzel\',serif;font-size:19px;color:#F2E6CC;font-weight:600;">'+nom+'</div>';
        if(eff) html += '<div style="font-size:15px;color:#A09070;margin-top:3px;font-style:italic;">'+eff+'</div>';
        html += '</div>';
        if(mana || des){
          html += '<div style="display:flex;border:1px solid rgba(212,168,67,.22);border-radius:10px;overflow:hidden;flex-shrink:0;">';
          if(mana) html += '<div style="background:rgba(80,100,200,.18);padding:8px 14px;text-align:center;border-right:1px solid rgba(212,168,67,.15);"><div style="font-family:\'Cinzel\',serif;font-size:20px;font-weight:700;color:#8090E0;">'+mana+'</div><div style="font-size:10px;color:#5060A0;letter-spacing:.1em;margin-top:2px;">MANA</div></div>';
          if(des){ const desStr = bon ? des+' <span style="color:#D4A843;">'+bon+'</span>' : des; html += '<div style="background:rgba(200,80,40,.12);padding:8px 14px;text-align:center;"><div style="font-family:\'Cinzel\',serif;font-size:20px;font-weight:700;color:#D07050;">'+desStr+'</div><div style="font-size:10px;color:#904030;letter-spacing:.1em;margin-top:2px;">DÉGÂTS</div></div>'; }
          html += '</div>';
        }
        html += '</div>';
      });
      html += '</div>';
    } else {
      html += '<div style="color:#A09070;font-style:italic;padding:20px 0;">Aucun don.</div>';
    }
    html += editBtn(name,'dons','dons','Modifier les dons');
  }

  else if(tab==='inv'){
    html += '<div class="vpanel-head"><i class="ti ti-backpack"></i> Inventaire</div>';
    const slot = (icon, nom, sub, color, iconColor, h, charN, cat, itemName) => {
      const enc = encodeURIComponent(itemName||'').replace(/'/g,'%27');
      return '<div onclick="openInvSlot(\''+charN+'\',\''+cat+'\',\''+enc+'\')" style="background:rgba(40,28,10,.75);border:1px solid '+color+';border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 4px;text-align:center;gap:3px;min-height:'+h+';cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor=\'rgba(212,168,67,.45)\'" onmouseout="this.style.borderColor=\''+color+'\'">'
        +'<i class="ti '+icon+'" style="font-size:17px;color:'+iconColor+';" aria-hidden="true"></i>'
        +(nom?'<div style="font-size:12px;color:#E0D8C8;line-height:1.2;">'+nom+'</div>':'')
        +(sub?'<div style="font-size:10px;color:#806840;font-style:italic;">'+sub+'</div>':'')
        +'</div>';
    };
    const emptySlot = (icon, color, iconColor, h, charN, cat) =>
      '<div onclick="openInvSlot(\''+charN+'\',\''+cat+'\',\'\')" style="background:rgba(40,28,10,.4);border:1px dashed '+color+';border-radius:7px;display:flex;align-items:center;justify-content:center;min-height:'+h+';opacity:.4;cursor:pointer;transition:opacity .15s;" onmouseover="this.style.opacity=\'0.7\'" onmouseout="this.style.opacity=\'0.4\'">'
      +'<i class="ti '+icon+'" style="font-size:15px;color:'+iconColor+';" aria-hidden="true"></i></div>';
    const secTitle = t => '<div style="font-size:11px;letter-spacing:.13em;color:#8A6A30;text-transform:uppercase;margin-bottom:7px;font-family:\'Cinzel\',serif;">'+t+'</div>';
    const statCard = (icon, nom, statVal, badgeLabel, badgeColor, badgeBg, charN, cat, itemName) => {
      const enc = encodeURIComponent(itemName||'').replace(/'/g,'%27');
      let badge = '';
      if(statVal){
        const fsize = statVal.length>7 ? '13px' : '18px';
        badge = '<div style="background:'+badgeBg+';padding:7px 14px;text-align:center;border-radius:10px;border:1px solid rgba(212,168,67,.22);flex-shrink:0;min-width:64px;">'
          +'<div style="font-family:\'Cinzel\',serif;font-size:'+fsize+';font-weight:700;color:'+badgeColor+';white-space:nowrap;">'+statVal+'</div>'
          +'<div style="font-size:9.5px;color:'+badgeColor+';opacity:.8;letter-spacing:.1em;margin-top:2px;">'+badgeLabel+'</div></div>';
      }
      return '<div onclick="openInvSlot(\''+charN+'\',\''+cat+'\',\''+enc+'\')" style="background:rgba(45,30,10,.6);border:1px solid rgba(212,168,67,.18);border-left:3px solid rgba(212,168,67,.5);border-radius:8px;padding:10px 14px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;min-height:56px;" onmouseover="this.style.borderColor=\'rgba(212,168,67,.5)\'" onmouseout="this.style.borderColor=\'rgba(212,168,67,.18)\'">'
        +'<i class="ti '+icon+'" style="font-size:24px;color:rgba(212,168,67,.6);flex-shrink:0;" aria-hidden="true"></i>'
        +'<div style="flex:1;"><div style="font-family:\'Cinzel\',serif;font-size:17px;color:#F2E6CC;font-weight:600;">'+nom+'</div></div>'
        +badge+'</div>';
    };
    const armes   = (c.armes||'').split('\n').filter(a=>a.trim());
    const armures = (c.armures||'').split('\n').filter(a=>a.trim());
    // TOP: Armes / Armures
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">';
    html += '<div><div style="font-size:15px;font-weight:700;color:#D4A843;letter-spacing:.04em;margin-bottom:9px;display:flex;align-items:center;gap:7px;font-family:\'Cinzel\',serif;"><i class="ti ti-sword" aria-hidden="true"></i> Armes</div><div style="display:flex;flex-direction:column;gap:8px;">';
    armes.forEach((a)=>{ const p=parseStat(a); html+=statCard(iconForText(p.name),p.name,p.stat,'DÉGÂTS','#D07050','rgba(200,80,40,.12)',name,'armes',a); });
    for(let i=armes.length;i<3;i++) html+=emptySlot('ti-sword','rgba(212,168,67,.15)','rgba(212,168,67,.2)','56px',name,'armes');
    html+='</div>'+editBtn(name,'inv','armes','Modifier les armes')+'</div>';
    html += '<div><div style="font-size:15px;font-weight:700;color:#D4A843;letter-spacing:.04em;margin-bottom:9px;display:flex;align-items:center;gap:7px;font-family:\'Cinzel\',serif;"><i class="ti ti-shield" aria-hidden="true"></i> Armures & Protections</div><div style="display:flex;flex-direction:column;gap:8px;">';
    armures.forEach((a)=>{ const p=parseStat(a); const ic=iconForText(p.name)==='ti-package'?'ti-shield':iconForText(p.name); html+=statCard(ic,p.name,p.stat,'ARMURE','#8090E0','rgba(80,100,200,.15)',name,'armures',a); });
    for(let i=armures.length;i<3;i++) html+=emptySlot('ti-shield','rgba(212,168,67,.15)','rgba(212,168,67,.2)','56px',name,'armures');
    html+='</div>'+editBtn(name,'inv','armures','Modifier les armures')+'</div>';
    html+='</div>';
    // SAC TITLE
    html += '<div style="font-size:15px;font-weight:700;color:#D4A843;letter-spacing:.04em;margin-bottom:12px;display:flex;align-items:center;gap:7px;font-family:\'Cinzel\',serif;"><i class="ti ti-backpack" aria-hidden="true"></i> Sac à dos</div>';
    // Items per dedicated category field
    const getCat = cat => (c['inv_'+cat]||'').split('|').map(e=>e.trim()).filter(e=>e);
    const nourriture= getCat('nourriture');
    const munitions = getCat('munitions');
    const soins     = getCat('soins');
    const potions   = getCat('potions');
    const quete     = getCat('quete');
    const speciaux  = getCat('speciaux');
    const docs      = getCat('docs');
    const gemmes    = getCat('gemmes');
    const butin     = getCat('butin');
    const bivouac   = getCat('bivouac');
    const grid = (items, max, cols, icon, iconColor, borderColor, h, label, cat) => {
      let g = secTitle(label+' — '+max+' emplacements');
      g += '<div style="display:grid;grid-template-columns:repeat('+cols+',1fr);gap:6px;margin-bottom:14px;">';
      items.forEach((it)=>{ const p=parseQty(it); g+=slot(icon,p.name+(p.qty?' ×'+p.qty:''),null,borderColor,iconColor,h,name,cat,it); });
      for(let i=items.length;i<max;i++) g+=emptySlot(icon,borderColor,iconColor.replace(/[\d.]+\)$/,'0.2)'),h,name,cat);
      return g+'</div>';
    };
    // Nourriture + Munitions
    html += '<div style="display:grid;grid-template-columns:2fr 1fr;gap:10px;margin-bottom:14px;">';
    html += '<div>'+secTitle('Nourriture — 1 emplacement');
    if(nourriture.length){ const p=parseQty(nourriture[0]); const nenc=encodeURIComponent(nourriture[0]).replace(/'/g,'%27'); html+='<div onclick="openInvSlot(\''+name+'\',\'nourriture\',\''+nenc+'\')" style="background:rgba(40,28,10,.75);border:1px solid rgba(212,168,67,.22);border-radius:7px;display:flex;align-items:center;gap:10px;padding:10px 14px;min-height:66px;cursor:pointer;"><i class="ti ti-bread" style="font-size:22px;color:rgba(212,168,67,.55);flex-shrink:0;" aria-hidden="true"></i><div><div style="font-size:13px;color:#E0D8C8;">'+p.name+(p.qty?' ×'+p.qty:'')+'</div><div style="font-size:10px;color:#806840;font-style:italic;">1 pers./jour · max ×12</div></div></div>'; }
    else html+=emptySlot('ti-bread','rgba(212,168,67,.15)','rgba(212,168,67,.2)','66px',name,'nourriture');
    html+='</div><div>'+secTitle('Munitions — 2 emplacements')+'<div style="display:flex;flex-direction:column;gap:6px;">';
    munitions.forEach((it)=>{ const p=parseQty(it); html+=slot('ti-circle-dot',p.name+(p.qty?' ×'+p.qty:''),null,'rgba(212,168,67,.2)','rgba(212,168,67,.45)','52px',name,'munitions',it); });
    for(let i=munitions.length;i<2;i++) html+=emptySlot('ti-circle-dot','rgba(212,168,67,.15)','rgba(212,168,67,.2)','52px',name,'munitions');
    html+='</div></div></div>';
    // Grids
    html += grid(bivouac, 15, 5, 'ti-tent',          'rgba(212,168,67,.5)',  'rgba(212,168,67,.18)', '58px', 'Matériel de bivouac & camp',   'bivouac');
    html += grid(soins,   15, 5, 'ti-first-aid-kit', 'rgba(100,200,120,.5)','rgba(100,200,120,.2)', '58px', 'Matériel de soins',             'soins');
    html += grid(potions, 15, 5, 'ti-flask',          'rgba(160,80,200,.5)', 'rgba(160,80,200,.2)',  '48px', 'Potions, Poisons, Antidotes',   'potions');
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">';
    html += '<div>'+grid(quete,   7, 3,'ti-map-pin',  'rgba(212,168,67,.45)','rgba(212,168,67,.2)','52px','Objets de quête',             'quete')+'</div>';
    html += '<div>'+grid(speciaux,7, 3,'ti-sparkles', 'rgba(200,120,80,.5)', 'rgba(200,120,80,.2)','52px','Objets spéciaux & Reliques',  'speciaux')+'</div>';
    html += '</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">';
    html += '<div>'+grid(docs,  9,3,'ti-book',    'rgba(212,168,67,.45)','rgba(212,168,67,.2)','58px','Documents, Livres, Titres',       'docs')+'</div>';
    html += '<div>'+grid(gemmes,9,3,'ti-diamond', 'rgba(80,200,220,.5)', 'rgba(80,200,220,.2)','58px','Gemmes & Pierres précieuses',     'gemmes')+'</div>';
    html += '</div>';
    html += grid(butin, 16, 4, 'ti-coin', 'rgba(212,168,67,.5)', 'rgba(212,168,67,.2)', '58px', 'Butin à revendre (ou pas)', 'butin');
  }

  else if(tab==='furm'){
    html += buildFurmHTML();
  }

  pc.innerHTML = html;
  if(tab==='furm'){
    document.querySelectorAll('#vpanel-content .furm-cap-btn').forEach(b=>{
      b.addEventListener('click',()=>showFurmCap(b.dataset.zone));
    });
  }
}

window.showCharVitruve = function(name, el){
  document.querySelectorAll('.char-tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  vitruveChar = name;
  vitruveTab = 'fiche';
  vitruveRender(name);
};
window._caracStates = {};
let _jetCat = 'physique';
let _jetMod = 0;

// Cases à cocher compétences & bonus/malus race pour le calculateur
window._checkStates = window._checkStates || {};

function getCheckedBonus(charName){
  // Retourne la somme des % cochés (compétences + bonus/malus race)
  const prefix = charName + '__check__';
  let sum = 0;
  Object.keys(window._checkStates).forEach(k => {
    if(k.startsWith(prefix) && window._checkStates[k]){
      // Extraire la valeur stockée dans la clé : prefix + encodedName + '__' + pct
      const parts = k.slice(prefix.length).split('__');
      if(parts.length >= 2){
        const val = parseInt(parts[parts.length-1]);
        if(!isNaN(val)) sum += val;
      }
    }
  });
  return sum;
}

window.toggleCheckState = function(key, el){
  window._checkStates[key] = !window._checkStates[key];
  el.checked = window._checkStates[key];
  updateJetDisplay();
};

function getAdjustedPct(charName, catKey, basePct){
  const c = charData[charName];
  if(!c) return parseInt(basePct)||0;
  const nb = 2;
  let nbJaune=0, nbRouge=0;
  // Pour Furmiaou les clés sont 'furm_furm_<catKey>_<si>'
  const isFurm = vitruveTab === 'furm';
  for(let si=0; si<nb; si++){
    const stKey = isFurm ? 'furm_furm_'+catKey+'_'+si : charName+'_'+catKey+'_'+si;
    const st = (window._caracStates && window._caracStates[stKey]) || 'none';
    if(st==='jaune') nbJaune++;
    if(st==='rouge') nbRouge++;
  }
  const allRouge = (nbRouge === nb);
  if(allRouge) return 5;
  return Math.max(5, parseInt(basePct) - nbJaune*10 - nbRouge*20);
}

function updateJetDisplay(){
  const c = charData[vitruveChar];
  if(!c) return;
  const isFurm = vitruveTab === 'furm';
  const catKey = _jetCat; // 'physique','social','mental'
  let rawPct;
  if(isFurm){
    rawPct = catKey==='physique' ? 65 : catKey==='social' ? 50 : 55;
  } else {
    rawPct = catKey==='physique' ? parseInt(c.phys)||0 : catKey==='social' ? parseInt(c.social)||0 : parseInt(c.mental)||0;
  }
  const base = getAdjustedPct(vitruveChar, catKey, rawPct);
  const checkedBonus = getCheckedBonus(vitruveChar);
  const total = Math.min(Math.max(base + _jetMod + checkedBonus, 5), 95);
  const el = document.getElementById('jet-base-lbl');
  const tm = document.getElementById('jet-total');
  const ml = document.getElementById('jet-mod-lbl');
  if(el) el.textContent = base+'%';
  if(ml) ml.textContent = (_jetMod>=0?'+':'')+_jetMod+'%';
  // Afficher la ligne compétences cochées si > 0
  const ckRow = document.getElementById('jet-check-row');
  const ckLbl = document.getElementById('jet-check-lbl');
  if(ckRow && ckLbl){
    if(checkedBonus !== 0){
      ckRow.style.display = 'block';
      ckLbl.textContent = (checkedBonus>=0?'+':'')+checkedBonus+'%';
      ckLbl.style.color = checkedBonus > 0 ? '#6CC090' : '#D07060';
    } else {
      ckRow.style.display = 'none';
    }
  }
  if(tm){ tm.textContent = total+'%'; tm.style.color = total>=60?'#50C050':total>=35?'#D4A843':'#C03030'; }
}
window.selectJetCat = function(btn){
  _jetCat = btn.dataset.cat;
  _jetMod = 0;
  document.querySelectorAll('.jet-cat-btn').forEach(b=>{
    const active = b===btn;
    const colors = {physique:['#C07830','rgba(160,80,20,.25)'],social:['#30A070','rgba(48,160,112,.15)'],mental:['#4080C0','rgba(64,128,192,.15)']};
    const [col,bg] = colors[b.dataset.cat];
    b.style.background = active ? bg : 'transparent';
    b.style.borderColor = active ? col : col+'66';
    b.style.color = col;
  });
  updateJetDisplay();
};
window.adjustJetMod = function(delta){ _jetMod = Math.min(Math.max(_jetMod+delta,-100),100); updateJetDisplay(); };
window.resetJetMod  = function(){ _jetMod=0; updateJetDisplay(); };

const DONS_DATA = {
  azarius: {
    'Turbo Fist':           { mana:2,  des:'1D10', bonus:2,  desc:'Le bras mécanique se verrouille dans un claquement sec.\nUn grondement sourd monte depuis l\'intérieur du coude.\nLes plaques d\'acier vibrent. Les pistons s\'alignent. Puis le réacteur s\'allume.\nUne lumière brûlante traverse les conduits du bras. La pression monte brutalement. L\'air autour du poing se déforme sous la chaleur.\nLe porteur pivote l\'épaule.\nBOUM.' },
    'Armagédon sans Bâton': { mana:5,  des:'1D12', bonus:4,  desc:'Le bras mécanique se déploie.\nLes plaques du bras coulissent avec un grincement métallique.\nLe poing se désassemble légèrement, révélant une chambre interne incandescente.\nLe réacteur du coude change de tonalité plus grave… plus instable.\nUne pression monte. Les soupapes vibrent.\nUn torrent de flammes jaillit du bras mécanique comme la gueule d\'un dragon forgé en acier.' },
    'Fire Shield':          { mana:3,  des:'1D6',  bonus:1,  desc:'Un grondement sourd vibre dans le coude mécanique.\nLe réacteur s\'embrase à bas régime.\nDes anneaux internes tournent autour de l\'avant-bras, créant un champ thermique instable.\nUn cercle de flammes explose vers l\'extérieur, formant un bouclier ardent devant le bras.\nLes flammes ne sont pas chaotiques.\nElles tournent en spirale, maintenues par un champ de pression généré par le réacteur.' },
    'Say My Name':          { mana:8,  des:'1D6+1D8', bonus:1, desc:'Le poing se verrouille.\nLes plaques d\'acier glissent, révélant un noyau interne incandescent.\nLe réacteur du coude hurle pas en puissance continue…\nMais en compression extrême. Toute l\'énergie est retenue.\nAccumulation maximale. Distance minimale.' },
    'Maîtrise des Armes':   { mana:0,  des:'—',    bonus:0,  desc:'Capacité passive.\nRelance 1 fois par combat un jet raté en combat au corps à corps.' },
    'Baroud d\'Honneur':    { mana:0,  des:'—',    bonus:2,  desc:'Capacité passive.\nSi les PV tombent sous 30%, les attaques infligent +2 dégâts bonus automatiquement.' }
  },
  dy: {
    'Déplacement d\'Air':   { mana:'X', des:'—', bonus:0, desc:'Dy concentre ses pouvoirs sur les courants environnants, créant un couloir d\'air tourbillonnant capable de déplacer les cibles sur une distance définie.\n\nCoût en Mana : X par personne touchée\nDistance : X / 3 mètres\n\nPrécision ciblée :\nDy peut viser précisément une ou plusieurs personnes. Elle subit un malus de –20 sur son jet par personne ciblée.\n\nJet de sauvegarde :\nDy peut relancer un seul jet, une seule fois, pour augmenter ses chances de succès.' },
    'Mur d\'Air':           { mana:6,  des:'—', bonus:0, desc:'Dy concentre ses pouvoirs pour ériger un mur invisible mais tangible de vent tourbillonnant.\n\nEffet : Le mur impose un malus de –30 sur les jets de traversée ou d\'attaque.\nSi Dy maintient le mur actif, elle ne peut effectuer aucune autre action pendant ce tour.\nCoût : X par tranche de –20 de malus.' },
    'Lame d\'Air':          { mana:3,  des:'1D8', bonus:2, desc:'Dy concentre le flux du vent en une lame tranchante et invisible, capable de fendre l\'air avec la précision d\'une épée. La lame frappe les ennemis comme une lame physique, infligeant des dégâts de coupure proportionnels à son intensité et à sa maîtrise.' },
    'Largage Aérien':       { mana:'2+(1/5m)', des:'—', bonus:0, desc:'Dy utilise la magie du vent pour téléporter sur une courte distance (15m) elle-même ou un autre joueur (une seule personne à la fois).' },
    'Invocations démoniques': { mana:'?', des:'—', bonus:0, desc:'Dy peut invoquer des entités démoniques pour l\'assister au combat ou en dehors.' },
    'La Boule Magique':     { mana:'Tout', des:'—', bonus:0, desc:'Sort ultime. Dy dépense tout son mana restant pour déclencher une explosion magique massive.' },
    'Maîtrise des Arcanes': { mana:0, des:'—', bonus:0, desc:'Capacité passive. Maîtrise avancée des sorts arcaniques.' },
    'Connaissance Interdite': { mana:0, des:'—', bonus:0, desc:'Capacité passive. Accès à des sorts normalement proscrits.' }
  },
  firm: {
    'Transmutation':        { mana:'1-2', des:'—', bonus:0, desc:'Double ses PV max et réduit le mana à 0. La vie du lanceur varie en fonction de ses PV manquants.' },
    'Gonflette':            { mana:2,  des:'—', bonus:0, desc:'Vous canalisez la puissance tellurique dans les muscles et la peau. Vos fibres se gonflent, votre cuir s\'épaissit, vos nerfs se tendent.\nPour chaque palier de 2 points de mana dépensés, vous bénéficiez d\'un bonus temporaire de +1 en Armure naturelle et +1 en Attaque physique.' },
    'Tarte aux prunes':     { mana:'1/PV', des:'1D4', bonus:-1, desc:'Renforce une de ses mains de feuilles et de fleurs magiques, puis gifle la personne souhaitée afin de la soigner.\n1 mana par PV soigné.' },
    'Extension du territoire': { mana:1, des:'—', bonus:0, desc:'Prend le contrôle d\'un œil et d\'une oreille d\'un animal à proximité.' },
    'Châtiment Sacré':      { mana:0, des:'—', bonus:0, desc:'Capacité passive de combat sacré.' },
    'Provoc\' Sauvage':     { mana:0, des:'—', bonus:0, desc:'Provoque un ennemi pour attirer son attention sur Firm.' }
  },
  mwassa: {
    'Bénédiction du goupil': { mana:3, des:'—', bonus:0, desc:'Au rythme frénétique de son tambourin et du claquement de ses castagnettes, Mwassa invoque une bénédiction divine.\nUne vibration invisible parcourt l\'air, trouve le cœur des alliés visés et y fait battre la force des hymnes anciens.\n\nEffet : Les personnes dans un rayon de 5m gagnent +10% sur tous leurs jets pendant 2 tours.\n+20% en mono-cible.' },
    'Aux armes !':          { mana:'1+1D4-12', des:'—', bonus:0, desc:'Mwassa appelle la mémoire des grands Hommes pour l\'habiter. Elle projette cette énergie pour revigorer sa cible.\n\nEffet : 25% du dé est consommé en mana. Le résultat du dé est transféré à la cible.' },
    'Marionette':           { mana:6, des:'—', bonus:0, desc:'Mwassa invoque un djin, fantôme de ses anciennes relations, et le projette dans sa cible.\nElle tisse autour de sa cible un filet invisible de charme et de désir, une promesse douce comme le vice et forte comme un serment.\nL\'esprit de l\'ennemi s\'incline, docile, incapable de discerner l\'enchantement de la fascination.\n\nEffet : Soumet un ennemi intelligent à la volonté de Mwassa pendant 1 heure.' },
    'Rosée de la vitalité': { mana:'1+1D4-12', des:'—', bonus:0, desc:'Mwassa condense l\'eau autour de la cible qu\'elle souhaite soigner.\nL\'eau glisse dessus pour lui restaurer sa vitalité.\n\nEffet : 25% du dé est consommé en mana. Le résultat du dé est transféré à la cible.' },
    'Soin Divin':           { mana:'?', des:'—', bonus:0, desc:'Soin divin canalisé par la grâce des 12.' },
    'Pacte des 12':         { mana:'?', des:'—', bonus:0, desc:'Invoque l\'alliance sacrée des 12 divinités pour un effet puissant.' }
  },
  nindey: {
    'Armes Foudroyante':    { mana:3, des:'—', bonus:2, desc:'Ce pouvoir ancien permet au porteur de graver des runes draconiques sur ses armes. Ces runes, issues du langage primordial des Dragons-Tempêtes d\'Alésia, servent de catalyseur : elles attirent et canalisent la foudre vivante.\nUne fois activées, l\'arme se couvre d\'arcs électriques qui tournent autour de la lame comme des serpents d\'éclair. (5 Tours)' },
    'Marteau de Thor':      { mana:2, des:'—', bonus:0, desc:'Nindey peut lancer l\'une de ses deux haches, recouverte de foudre. Un lien électrique relie sa main à la hache : tant qu\'elle n\'est pas coincée, celle-ci revient automatiquement dans sa main.' },
    'Blitzer':              { mana:4, des:'1D6', bonus:1, desc:'Vous invoquez une sphère d\'électricité pure qui éclate en un instant. L\'énergie électrise l\'espace autour de vous, zébrant l\'air de lignes de foudre qui fauchent tout être imprudent à portée (3m).' },
    'Lance de Foudre':      { mana:6, des:'1D10', bonus:2, desc:'Le joueur canalise l\'énergie orageuse contenue dans ses runes draconiques pour façonner une lance entièrement faite de foudre pure.\nL\'arme n\'est pas matérielle : c\'est une projection d\'énergie condensée, vibrante et instable, prête à être lancée.\nUne fois formée, la lance crépite, illuminant les environs d\'un bleu électrique avant de frapper sa cible avec la violence d\'un tonnerre.' },
    'Maîtrise des Armes':   { mana:0, des:'—', bonus:0, desc:'Capacité passive. Maîtrise avancée du maniement des armes.' },
    'Baroud d\'Honneur':    { mana:0, des:'—', bonus:2, desc:'Capacité passive. Si les PV tombent sous 30%, les attaques infligent +2 dégâts bonus.' }
  }
};

// Modale don
window.openDonModal = function(charName, donNom){
  const data = (DONS_DATA[charName]||{})[donNom];
  const icon = document.getElementById('don-modal-icon');
  const title = document.getElementById('don-modal-title');
  const desc = document.getElementById('don-modal-desc');
  const mana = document.getElementById('don-modal-mana');
  const des  = document.getElementById('don-modal-des');
  const bon  = document.getElementById('don-modal-bon');
  if(!data){ return; }
  if(icon)  icon.textContent = donNom.match(/^[\p{Emoji}]/u)?donNom.match(/^[\p{Emoji}]/u)[0]:'✦';
  if(title) title.textContent = donNom.replace(/^[\p{Emoji}\s]+/u,'');
  if(desc)  desc.textContent = data.desc||'';
  if(mana)  mana.textContent = (data.mana!==undefined && data.mana!==0 ? data.mana : '—') + (data.mana&&data.mana!=='—'?' mana':'');
  if(des)   des.textContent  = data.des||'—';
  if(bon)   bon.textContent  = data.bonus>0?'+'+data.bonus:data.bonus<0?data.bonus:'—';
  document.getElementById('don-modal').style.display='flex';
};
window.closeDonModal = function(){
  document.getElementById('don-modal').style.display='none';
};

// ===== INVENTAIRE SLOT EDITOR =====
window.openInvSlot = function(charName, category, encodedItem){
  const itemName = decodeURIComponent(encodedItem||'');
  const existing = itemName ? itemName : null;
  const isEquip = (category === 'armes' || category === 'armures');

  document.getElementById('inv-slot-char').value = charName;
  document.getElementById('inv-slot-cat').value = category;
  document.getElementById('inv-slot-idx').value = itemName;
  document.getElementById('inv-slot-name').value = existing ? existing.replace(/\s*×\d+$/,'').replace(/\s*\(.*?\)\s*$/,'').trim() : '';
  document.getElementById('inv-slot-qty').value = existing ? (existing.match(/×(\d+)$/)?.[1]||'') : '';
  document.getElementById('inv-slot-stat').value = existing ? (existing.match(/\(([^)]*)\)\s*$/)?.[1]||'') : '';
  document.getElementById('inv-slot-stat-wrap').style.display = isEquip ? 'block' : 'none';
  document.getElementById('inv-slot-qty-wrap').style.display = isEquip ? 'none' : 'block';
  document.getElementById('inv-slot-stat-label').textContent = category==='armes' ? "Dégâts / particularité" : "Armure (RD) / particularité";
  document.getElementById('inv-slot-stat').placeholder = category==='armes' ? 'ex: D10/+4' : 'ex: RD4 ou Résiste au feu';
  document.getElementById('inv-slot-del').style.display = existing ? 'inline-flex' : 'none';
  document.getElementById('inv-slot-modal').style.display = 'flex';
  setTimeout(()=>document.getElementById('inv-slot-name').focus(), 50);
};

window.closeInvSlot = function(){
  document.getElementById('inv-slot-modal').style.display = 'none';
};

window.saveInvSlot = async function(){
  const charName    = document.getElementById('inv-slot-char').value;
  const category    = document.getElementById('inv-slot-cat').value;
  const originalItem= document.getElementById('inv-slot-idx').value;
  const nom         = document.getElementById('inv-slot-name').value.trim();
  const qty         = document.getElementById('inv-slot-qty').value.trim();
  const stat        = document.getElementById('inv-slot-stat').value.trim();
  if(!nom){ closeInvSlot(); return; }
  const isEquip = (category === 'armes' || category === 'armures');
  const newEntry = isEquip ? (nom + (stat ? ' ('+stat+')' : '')) : (nom + (qty ? ' ×'+qty : ''));
  _updateInvSlot(charName, category, originalItem, newEntry);
  closeInvSlot();
};

window.deleteInvSlot = async function(){
  const charName    = document.getElementById('inv-slot-char').value;
  const category    = document.getElementById('inv-slot-cat').value;
  const originalItem= document.getElementById('inv-slot-idx').value;
  _updateInvSlot(charName, category, originalItem, null);
  closeInvSlot();
};

async function _updateInvSlot(charName, category, originalItem, newEntry){
  const c = charData[charName];

  // Armes et armures = champs dédiés séparés par \n
  if(category === 'armes' || category === 'armures'){
    let items = (c[category]||'').split('\n').map(e=>e.trim()).filter(e=>e);
    if(newEntry===null){ items = items.filter(i=>i!==originalItem); }
    else if(originalItem){ items = items.map(i=>i===originalItem?newEntry:i); }
    else { items.push(newEntry); }
    charData[charName][category] = items.join('\n');
    await saveChar(charName);
    vitruveShowPanel(charName,'inv');
    return;
  }

  // Toutes les autres catégories = champ inv_<cat> séparé par |
  const field = 'inv_' + category;
  let items = (c[field]||'').split('|').map(e=>e.trim()).filter(e=>e);
  if(newEntry===null){ items = items.filter(i=>i!==originalItem); }
  else if(originalItem){ items = items.map(i=>i===originalItem?newEntry:i); }
  else { items.push(newEntry); }
  charData[charName][field] = items.join('|');
  await saveChar(charName);
  vitruveShowPanel(charName, 'inv');
}

window._postures = {};
window.setPosture = function(charName, posture){
  if(!window._postures) window._postures = {};
  window._postures[charName] = posture;
  // Refresh carac tab to update buttons
  if(vitruveChar===charName && vitruveTab==='carac') vitruveShowPanel(charName,'carac');
};

window.cycleCaracState = function(el){
  const key = el.dataset.key;
  const states = ['none','jaune','rouge'];
  const cur = window._caracStates[key] || 'none';
  const next = states[(states.indexOf(cur)+1)%states.length];
  window._caracStates[key] = next;
  // Refresh carac/furm panel + jet calculator
  const tab = vitruveTab;
  if(tab==='carac' || tab==='furm') vitruveShowPanel(vitruveChar, tab);
  updateJetDisplay();
};

window.vitAdj = async function(stat, delta){
  const name = vitruveChar;
  const cur = isNaN(parseInt(charData[name][stat]))?0:parseInt(charData[name][stat]);
  const newVal = Math.max(0, cur+delta);
  charData[name][stat] = String(newVal);
  document.getElementById('vit-'+stat).textContent = newVal;
  updatePartyRow(name);
  await setDoc(doc(db,'characters',name),{[stat]:String(newVal)},{merge:true});
  toast(name+' '+stat.toUpperCase()+' : '+newVal);
};
window.editRawChar = function(){
  const name = vitruveChar;
  const area = document.createElement('textarea');
  area.className='ef-area';
  area.style.cssText='width:100%;min-height:200px;font-size:11px;';
  area.value = JSON.stringify(charData[name], null, 2);
  document.getElementById('vpanel-content').innerHTML='';
  document.getElementById('vpanel-content').appendChild(area);
  area.onblur = async()=>{
    try{
      const parsed = JSON.parse(area.value);
      charData[name] = {...charData[name],...parsed};
      await saveChar(name);
      vitruveRender(name);
      toast('Données mises à jour ✓');
    }catch(e){ toast('JSON invalide'); }
  };
};

// ===== FURMIAOU =====
let _furmPV = 48;
function buildFurmHTML(){
  const FURM_CATS = [
    { key:'furm_physique', label:'Physique', pct: 65, color:'#4A9050', bg:'rgba(20,60,20,.2)',
      subs:[
        { label:'Puissance', val: 5 },
        { label:'Finesse',   val: 2 }
      ]
    },
    { key:'furm_social', label:'Social', pct: 50, color:'#30A070', bg:'rgba(20,80,50,.15)',
      subs:[
        { label:'Aura',     val: 3 },
        { label:'Relation', val: 2 }
      ]
    },
    { key:'furm_mental', label:'Mental', pct: 55, color:'#5090A0', bg:'rgba(20,60,80,.15)',
      subs:[
        { label:'Instinct', val: 5 },
        { label:'Savoir',   val: 1 }
      ]
    }
  ];

  let html = '<div class="vpanel-head" style="color:#7FBF7A;"><i class="ti ti-paw"></i> Furmiaou — Forme Bestiale</div>';

  // Portrait Furmiaou
  html += '<div style="width:100%;height:180px;border-radius:8px;overflow:hidden;margin-bottom:14px;border:1px solid rgba(74,160,80,.3);">';
  html += '<img src="'+PORTRAITS.furmiaou+'" style="width:100%;height:100%;object-fit:cover;object-position:center 30%;">';
  html += '</div>';
  html += '<div style="display:flex;gap:10px;margin-bottom:18px;align-items:center;">';
  html += '<div style="flex:1;background:rgba(0,0,0,.3);border:1px solid rgba(74,160,80,.3);border-radius:8px;padding:10px;text-align:center;">';
  html += '<div style="font-family:\'Cinzel\',serif;font-size:26px;font-weight:700;color:#50C050;" id="furm-pv-disp">'+_furmPV+'</div>';
  html += '<div style="font-size:14px;color:#4A7040;font-family:\'Cinzel\',serif;">PV / 48</div>';
  html += '<div style="display:flex;gap:4px;justify-content:center;margin-top:6px;">';
  html += '<button onclick="furmAdj(-1)" style="background:none;border:1px solid rgba(74,160,80,.25);color:#4A7040;border-radius:4px;padding:2px 10px;cursor:pointer;font-size:17px;">−</button>';
  html += '<button onclick="furmAdj(1)" style="background:none;border:1px solid rgba(74,160,80,.25);color:#4A7040;border-radius:4px;padding:2px 10px;cursor:pointer;font-size:17px;">+</button>';
  html += '</div></div>';
  html += '<div style="flex:1;background:rgba(0,0,0,.3);border:1px solid rgba(160,80,200,.25);border-radius:8px;padding:10px;text-align:center;">';
  html += '<div style="font-family:\'Cinzel\',serif;font-size:26px;font-weight:700;color:#9050C0;">0</div>';
  html += '<div style="font-size:14px;color:#6040A0;font-family:\'Cinzel\',serif;">Mana / 0</div>';
  html += '<div style="font-size:12px;color:#4A3060;margin-top:4px;font-style:italic;">Aucune magie</div>';
  html += '</div>';
  html += '<div style="display:flex;gap:5px;flex-direction:column;">';
  html += '<span style="font-family:\'Cinzel\',serif;font-size:13px;padding:4px 10px;border:1px solid rgba(160,80,200,.35);color:#9050C0;border-radius:4px;">🌿 Nature</span>';
  html += '<span style="font-family:\'Cinzel\',serif;font-size:13px;padding:4px 10px;border:1px solid rgba(74,160,80,.35);color:#4A9050;border-radius:4px;">Transmutation</span>';
  html += '</div></div>';

  const buildFurmCatBlock = (cat) => {
    const states = cat.subs.map((_,si)=>(window._caracStates && window._caracStates['furm_'+cat.key+'_'+si])||'none');
    const nbJaune = states.filter(s=>s==='jaune').length;
    const nbRouge = states.filter(s=>s==='rouge').length;
    const allRouge = states.length > 0 && states.every(s=>s==='rouge');
    let adjPct, mainColor, blockBorder;
    if(allRouge){
      adjPct = 5; mainColor = '#C03030'; blockBorder = 'border:2px solid #C03030;';
    } else {
      adjPct = Math.max(5, parseInt(cat.pct) - nbJaune*10 - nbRouge*20);
      mainColor = cat.color; blockBorder = 'border:1px solid rgba(74,160,80,.2);';
    }
    let b = '<div style="background:'+cat.bg+';'+blockBorder+'border-radius:12px;padding:14px 18px;flex:1;">';
    b += '<div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">';
    b += '<div style="font-family:\'Cinzel\',serif;font-size:24px;font-weight:700;color:'+mainColor+';text-transform:uppercase;letter-spacing:.06em;min-width:100px;">'+cat.label+'</div>';
    b += '<div style="flex:1;"><div style="height:8px;background:rgba(255,255,255,.06);border-radius:4px;"><div style="height:100%;width:'+adjPct+'%;background:'+mainColor+';border-radius:4px;opacity:.7;"></div></div></div>';
    b += '<div style="font-family:\'Cinzel\',serif;font-size:28px;font-weight:700;color:'+mainColor+';min-width:54px;text-align:right;">'+adjPct+'%</div>';
    b += '</div>';
    b += '<div style="display:flex;flex-direction:column;gap:8px;">';
    cat.subs.forEach((sub,si)=>{
      const stateKey = 'furm_'+cat.key+'_'+si;
      const state = (window._caracStates && window._caracStates[stateKey]) || 'none';
      const sqColor = state==='jaune'?'#D4A843': state==='rouge'?'#C03030':'transparent';
      const sqBorder = state==='none'?'rgba(74,160,80,.35)':sqColor;
      const isRouge = state==='rouge';
      const isJaune = state==='jaune';
      const dispVal = isJaune ? Math.max(0, parseInt(sub.val)-1) : sub.val;
      const valColor = isRouge ? '#605040' : isJaune ? '#D4A843' : cat.color;
      const rowStyle = isRouge ? 'display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(0,0,0,.25);border-radius:8px;opacity:.4;' : 'display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(0,0,0,.25);border-radius:8px;';
      const labelStyle = isRouge ? 'flex:1;font-size:20px;color:#807060;text-decoration:line-through;' : 'flex:1;font-size:20px;color:#C8E8C0;';
      b += '<div style="'+rowStyle+'">';
      b += '<div style="'+labelStyle+'">'+sub.label+'</div>';
      b += '<div style="font-family:\'Cinzel\',serif;font-size:32px;font-weight:700;color:'+valColor+';min-width:36px;text-align:center;">'+(isRouge?'—':dispVal)+'</div>';
      b += '<div class="carac-sq" data-key="'+stateKey+'" onclick="cycleCaracState(this)" title="Cliquer pour changer l\'état" style="width:28px;height:28px;border:2px solid '+sqBorder+';border-radius:5px;cursor:pointer;background:'+sqColor+';flex-shrink:0;transition:all .2s;"></div>';
      b += '</div>';
    });
    b += '</div></div>';
    return b;
  };

  const furmMental  = FURM_CATS.find(c=>c.key==='furm_mental');
  const furmPhys    = FURM_CATS.find(c=>c.key==='furm_physique');
  const furmSocial  = FURM_CATS.find(c=>c.key==='furm_social');
  html += '<div style="display:flex;justify-content:center;margin-bottom:12px;">';
  html += buildFurmCatBlock(furmMental);
  html += '</div>';
  html += '<div style="display:flex;gap:12px;margin-bottom:4px;">';
  html += buildFurmCatBlock(furmPhys);
  html += buildFurmCatBlock(furmSocial);
  html += '</div>';

  // Capacités
  html += '<div class="vsubhead" style="margin-top:16px;color:#7FBF7A;">Capacités de combat</div>';
  const caps = [
    ['Morsure','D8+3 — Attaque principale, ignore 1 RD'],
    ['Griffes','D6+2 × 2 attaques simultanées'],
    ['Bond félin','4 mana — Saut 8m + attaque en atterrissant'],
    ['Rugissement','3 mana — Terreur, −20% ennemis proches'],
    ['Sens affûtés','Passif — +30% perception, détecte embuscades'],
    ['Régénération','1 PV/tour en milieu naturel'],
    ['Armure naturelle','RD2 fourrure — RD4 vs projectiles'],
    ['Lacération','Saignement : −1 PV/tour pendant 3 tours']
  ];
  html += '<div class="icard-grid">';
  caps.forEach(([nom,eff])=>{
    html += '<div class="icard"><i class="ti ti-paw" style="color:#4A9050;"></i><div class="icard-lbl">'+nom+'</div><div class="icard-sub">'+eff+'</div></div>';
  });
  html += '</div>';
  return html;
}
const FURMIAOU_HTML = null; // replaced by buildFurmHTML()
window.furmAdj = function(delta){
  _furmPV = Math.max(0,_furmPV+delta);
  const el = document.getElementById('furm-pv-disp'); if(el) el.textContent=_furmPV;
};
function partyRowHTML(name){
  const c = charData[name];
  if(!c) return '';
  const pv = parseInt(c.pv)||0, pvmax = parseInt(c.pv_max)||1;
  const mana = parseInt(c.mana)||0, manamax = parseInt(c.mana_max)||1;
  const pvPct = Math.max(0,Math.min(100, pv/pvmax*100));
  const manaPct = Math.max(0,Math.min(100, mana/manamax*100));
  const firstName = (c.name||name).split(' ')[0];
  return '<div>'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px;">'
      +'<span style="font-size:11.5px;color:#E0D0A8;font-family:\'Cinzel\',serif;">'+firstName+'</span>'
      +'<span id="party-pvtxt-'+name+'" style="font-size:10.5px;color:#E07060;">'+pv+'/'+pvmax+' PV</span>'
    +'</div>'
    +'<div style="background:rgba(0,0,0,.35);border-radius:4px;height:6px;overflow:hidden;margin-bottom:4px;"><div id="party-pvbar-'+name+'" style="background:#C0392B;height:100%;width:'+pvPct+'%;transition:width .3s;"></div></div>'
    +'<div style="display:flex;justify-content:flex-end;margin-bottom:2px;">'
      +'<span id="party-manatxt-'+name+'" style="font-size:10px;color:#7090D0;">'+mana+'/'+manamax+' mana</span>'
    +'</div>'
    +'<div style="background:rgba(0,0,0,.3);border-radius:3px;height:4px;overflow:hidden;"><div id="party-manabar-'+name+'" style="background:#4A6FC0;height:100%;width:'+manaPct+'%;transition:width .3s;"></div></div>'
  +'</div>';
}
function renderPartyStatus(){
  const el = document.getElementById('party-status-list');
  if(!el) return;
  el.innerHTML = ['azarius','dy','firm','mwassa','nindey'].map(partyRowHTML).join('');
}
window.renderPartyStatus = renderPartyStatus;
function updatePartyRow(name){
  const c = charData[name]; if(!c) return;
  const pv = parseInt(c.pv)||0, pvmax = parseInt(c.pv_max)||1;
  const mana = parseInt(c.mana)||0, manamax = parseInt(c.mana_max)||1;
  const pvPct = Math.max(0,Math.min(100, pv/pvmax*100));
  const manaPct = Math.max(0,Math.min(100, mana/manamax*100));
  const b1=document.getElementById('party-pvbar-'+name); if(b1) b1.style.width=pvPct+'%';
  const t1=document.getElementById('party-pvtxt-'+name); if(t1) t1.textContent=pv+'/'+pvmax+' PV';
  const b2=document.getElementById('party-manabar-'+name); if(b2) b2.style.width=manaPct+'%';
  const t2=document.getElementById('party-manatxt-'+name); if(t2) t2.textContent=mana+'/'+manamax+' mana';
}
window.updatePartyRow = updatePartyRow;

['azarius','dy','firm','mwassa','nindey'].forEach(name=>{
  onSnapshot(doc(db,'characters',name),snap=>{
    if(!snap.exists())return;
    const data=snap.data();
    if(data.pv!==undefined){charData[name].pv=data.pv;const el=document.getElementById(`${name}-pv`);if(el)el.textContent=data.pv;if(name===vitruveChar){const ve=document.getElementById('vit-pv');if(ve)ve.textContent=data.pv;}}
    if(data.mana!==undefined){charData[name].mana=data.mana;const el=document.getElementById(`${name}-mana`);if(el)el.textContent=data.mana;if(name===vitruveChar){const ve=document.getElementById('vit-mana');if(ve)ve.textContent=data.mana;}}
    updatePartyRow(name);
  });
});


