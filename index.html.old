      <rect x="136" y="340" width="38" height="22" rx="4" fill="#0E0C06" stroke="${G(.3)}" stroke-width="1"/>
      <path d="M78 270 L90 310 L168 310 L180 270 Z" fill="#16120A" stroke="${G(.2)}" stroke-width="1"/>
      <path d="M72 128 L68 270 L192 270 L188 128 L164 116 L130 122 L96 116 Z" fill="#1C1610" stroke="${G(.28)}" stroke-width="1.2"/>
      <line x1="100" y1="148" x2="100" y2="268" stroke="${G(.12)}" stroke-width="0.8"/>
