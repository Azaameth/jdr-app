  {img:'xxx',n:'Rôdeur',sub:'Archer',pv:'+0',mana:'+0',arm:'+0',caps:['Maîtrise Nature : +10% Survie/Pistage','Tir Précision : +20% distance 1×/combat','Esquive Instinctive : relance 1×/combat']},
  {img:'xxx',n:'Gardien',sub:'Paladin',pv:'+2',mana:'+0',arm:'+1',caps:['Châtiment Sacré : +10% vs maléfiques','Provoc\' Sauvage : attire ennemis']},
  {img:'xxx',n:'Lames Noires',sub:'Assassin',pv:'+0',mana:'+0',arm:'Impossible',caps:['Frappe Sournoise : ×2 dégâts surprise','Maître des Ombres : relance discrétion']},
  {img:'xxx',n:'Arcaniste',sub:'Mage',pv:'+0',mana:'+2',arm:'+0',caps:['Maîtrise des Arcanes : relance sort 1×/combat','Connaissance Interdite : relance Savoir']},
  {img:'xxx',n:'Oracle',sub:'Prêtre',pv:'+1',mana:'+1',arm:'Impossible',caps:['Soin Divin : relance soin 1×/combat','Pacte des 12 : Mana full 1×/jour']},
  {img:'xxx',n:'Cogneur',sub:'Guerrier',pv:'+0',mana:'−1',arm:'+2 dégâts',caps:['Maîtrise des Armes : relance 1×/combat','Baroud d\'honneur : <30% PV → +2 dégâts']},
  {img:'xxx',n:'Troubadour',sub:'Barde',pv:'+0',mana:'+0',arm:'+0',caps:['Ruse Scénique : relance social 1×/combat','Improvisation : +30% social avec instrument']}
];
let raceIdx=0;
function renderRaceCarousel(){
  const n=races.length;
  const track=document.getElementById('race-track');
  if(!track)return;
  track.innerHTML=races.map((r,i)=>{
    let d=i-raceIdx;
    if(d>n/2) d-=n;
    if(d<-n/2) d+=n;
    let transform,opacity,z,pe='auto';
    if(d===0){ transform='translate(-50%,-50%) translateX(0) scale(1)'; opacity=1; z=5; }
    else if(Math.abs(d)===1){ transform=`translate(-50%,-50%) translateX(${d*300}px) rotateY(${-d*22}deg) scale(.75)`; opacity=.55; z=4; }
    else if(Math.abs(d)===2){ transform=`translate(-50%,-50%) translateX(${d*290}px) rotateY(${-d*28}deg) scale(.55)`; opacity=.22; z=3; }
    else { transform=`translate(-50%,-50%) translateX(${d*280}px) scale(.4)`; opacity=0; z=1; pe='none'; }
    return `<div class="race-card" style="width:300px;transform:${transform};opacity:${opacity};z-index:${z};pointer-events:${pe};" onclick="raceGoTo(${i})">
      <img class="rimg" src="${r.img}" alt="${r.n}" style="height:260px;"/>
      <div class="rn">${r.n}</div>
      <div class="rs">${r.sub||'&nbsp;'}</div>
      <div class="rbox bon"><div class="rgrp">Bonus</div>${r.bon.map(b=>`<div class="ritem">+ ${b}</div>`).join('')}</div>
      <div class="rbox mal"><div class="rgrp">Malus</div>${r.mal.map(m=>`<div class="ritem">− ${m}</div>`).join('')}</div>
    </div>`;
  }).join('');
  document.getElementById('race-dots').innerHTML=races.map((r,i)=>`<div class="race-dot ${i===raceIdx?'active':''}" onclick="raceGoTo(${i})" title="${r.n}"></div>`).join('');
}
window.raceNav=(dir)=>{ raceIdx=(raceIdx+dir+races.length)%races.length; renderRaceCarousel(); };
window.raceGoTo=(i)=>{ raceIdx=i; renderRaceCarousel(); };
renderRaceCarousel();
let classIdx=0;
function renderClassCarousel(){
  const n=classes.length;
  const track=document.getElementById('class-track');
  if(!track)return;
  track.innerHTML=classes.map((c,i)=>{
    let d=i-classIdx;
    if(d>n/2) d-=n;
    if(d<-n/2) d+=n;
    let transform,opacity,z,pe='auto';
    if(d===0){ transform='translate(-50%,-50%) translateX(0) scale(1)'; opacity=1; z=5; }
    else if(Math.abs(d)===1){ transform=`translate(-50%,-50%) translateX(${d*300}px) rotateY(${-d*22}deg) scale(.75)`; opacity=.55; z=4; }
    else if(Math.abs(d)===2){ transform=`translate(-50%,-50%) translateX(${d*290}px) rotateY(${-d*28}deg) scale(.55)`; opacity=.22; z=3; }
    else { transform=`translate(-50%,-50%) translateX(${d*280}px) scale(.4)`; opacity=0; z=1; pe='none'; }
    return `<div class="race-card" style="width:300px;transform:${transform};opacity:${opacity};z-index:${z};pointer-events:${pe};" onclick="classGoTo(${i})">
      ${c.img?`<img class="rimg" src="${c.img}" alt="${c.n}" style="height:260px;"/>`:`<div class="rimg" style="height:260px;display:flex;align-items:center;justify-content:center;background:rgba(212,168,67,.04);"><i class="ti ti-sword" style="font-size:40px;color:rgba(212,168,67,.25);"></i></div>`}
      <div class="rn">${c.n}</div>
      <div class="rs">${c.sub||'&nbsp;'}</div>
      <div style="display:flex;gap:5px;flex-wrap:wrap;justify-content:center;margin-bottom:10px;"><span class="badge">PV ${c.pv}</span><span class="badge">Mana ${c.mana}</span><span class="badge">${c.arm}</span></div>
      ${c.caps.map(cap=>`<div class="ritem" style="padding-left:8px;border-left:2px solid var(--gold);margin-bottom:5px;">${cap}</div>`).join('')}
    </div>`;
  }).join('');
  document.getElementById('class-dots').innerHTML=classes.map((c,i)=>`<div class="race-dot ${i===classIdx?'active':''}" onclick="classGoTo(${i})" title="${c.n}"></div>`).join('');
}
window.classNav=(dir)=>{ classIdx=(classIdx+dir+classes.length)%classes.length; renderClassCarousel(); };
window.classGoTo=(i)=>{ classIdx=i; renderClassCarousel(); };
renderClassCarousel();

// ===== LIVRE D'HISTOIRE =====
const HISTOIRE_PAGES = [
  {t:"Avant la Convergence", html:"Il y a plusieurs millénaires, le continent était habité par diverses peuplades sans frontières fixes. Un cataclysme cosmique — la collision d'énergies magiques ancestrales — donna naissance à un lac intérieur sacré, renfermant un pouvoir ancien au cœur de la terre. Au centre de ce lac, <strong style=\"color:#F2E6CC\">l'Île du Cœur</strong> émergea, sanctuaire de savoirs perdus et foyer des mages primordiaux. Autour du lac, douze nations se formèrent en un cercle concentrique, chacune regardant vers l'île comme source de vie et de puissance."},
  {t:"L'Ère des Douze Royaumes", html:"Durant des siècles, ces nations prospérèrent, chacune suivant ses traditions et ses forces propres. Leurs frontières naturelles — montagnes, rivières, forêts — offraient protection et démarquaient leurs identités culturelles. Mais à la veille de l'Ère de la Barrière, le désir de dominer l'Île du Cœur créa des rivalités et des tensions croissantes."},
  {t:"L'Ère de la Barrière", html:"Pour éviter la guerre, un conclave rassembla souverains et mages des douze pays. Les huit archimages du Cœur édifièrent une barrière magique autour de l'île, empêchant toute intrusion. Cette barrière apparut comme une aurore tourbillonnante, visible de loin. Depuis, aucune expédition sur l'île n'est jamais revenue. Depuis environ <strong style=\"color:#F2E6CC\">5000 ans Avant l'Éveil</strong>, l'Île du Cœur est une zone interdite, mystérieuse et redoutée."},
  {t:"La Prophétie des Douze Voies", prophecy:true, html:"« Quand les Douze se répondront en un même souffle,<br>Un trésor au-delà de toute mesure émergera.<br>La Voie s'ouvrira alors,<br>Et tous franchiront le seuil du Royaume du Cœur. »"},
  {t:"L'Ère actuelle — Les Téméraires", html:"Une ancienne stèle magique prédit qu'une alliance d'êtres courageux ouvrira la voie vers l'Île du Cœur. Les <strong style=\"color:#F2E6CC\">Téméraires</strong> incarnent cette prophétie. Leur serment : réunir les nations, briser la barrière, et franchir ensemble l'Île du Cœur. Selon les royaumes, ils sont tour à tour vus comme des hérétiques dangereux ou des sauveurs espérés."},
  {t:"Mythes et Réalités", html:"Chaque peuple entretient ses légendes — certains y voient un lieu sacré de renaissance divine, d'autres un refuge pour un ordre oublié. Les religions périphériques évoquent la Prophétie des Douze Âmes, annonçant un élu capable de lever la barrière. Certains disent que les courants du lac attirent les navires vers l'île, mais sans jamais leur permettre de s'en échapper."},
];
let histPage = -1; // -1 = couverture fermée
function pageInner(i){
  if(i<0 || i>=HISTOIRE_PAGES.length) return '';
  const p = HISTOIRE_PAGES[i];
  return `<div class="bp-num">Page ${i+1} / ${HISTOIRE_PAGES.length}</div>
    <div class="bp-title">${p.t}</div>
    <div class="bp-text ${p.prophecy?'prophecy':''}">${p.html}</div>`;
}
const BOOK_SPREADS = Math.ceil(HISTOIRE_PAGES.length/2);
let bookSpread = 0;
function dotsHtml(){
  return Array.from({length:BOOK_SPREADS},(_,i)=>`<div class="race-dot ${i===bookSpread?'active':''}" onclick="bookGoTo(${i})"></div>`).join('');
}
function renderBook(){
  const w = document.getElementById('book-wrap');
  if(!w) return;
  if(histPage === -1){
    w.innerHTML = `<div class="book-cover" onclick="bookOpen()">
      <div class="bc-emblem"><i class="ti ti-sparkles"></i></div>
      <div class="bc-title">Alésia</div>
      <div class="bc-sub">Histoire du monde</div>
      <div class="bc-hint">Cliquez pour ouvrir</div>
    </div>`;
    return;
  }
  const l = bookSpread*2, r = l+1;
  w.innerHTML = `<div style="width:100%;">
    <div class="book-spread" id="book-spread">
      <div class="book-half left" id="book-half-left">${pageInner(l)}</div>
      <div class="book-spine"></div>
      <div class="book-half right" id="book-half-right">${pageInner(r)}</div>
    </div>
    <div class="book-nav">
      <button class="race-arrow" onclick="bookNav(-1)" aria-label="Page précédente"><i class="ti ti-chevron-left"></i></button>
      <div class="race-dots" style="margin:0;" id="book-dots">${dotsHtml()}</div>
      <button class="race-arrow" onclick="bookNav(1)" aria-label="Page suivante"><i class="ti ti-chevron-right"></i></button>
    </div>
    <div class="book-close" onclick="bookClose()"><i class="ti ti-bookmark"></i> Fermer le livre</div>
  </div>`;
}
function turnBook(newSpread, dir){
  const stage = document.getElementById('book-spread');
  if(!stage){ bookSpread=newSpread; renderBook(); return; }
  const flip = document.createElement('div');
  if(dir>0){
    flip.className = 'book-flip right-flip';
    flip.innerHTML = pageInner(bookSpread*2+1);
    flip.style.zIndex = '10';
    stage.appendChild(flip);
    document.getElementById('book-half-right').innerHTML = pageInner(newSpread*2+1);
    document.getElementById('book-half-left').innerHTML = pageInner(newSpread*2);
    requestAnimationFrame(()=>requestAnimationFrame(()=>{ flip.style.transform = 'rotateY(-160deg)'; }));
  } else {
    flip.className = 'book-flip left-flip';
    flip.innerHTML = pageInner(bookSpread*2);
    flip.style.zIndex = '10';
    stage.appendChild(flip);
    document.getElementById('book-half-left').innerHTML = pageInner(newSpread*2);
    document.getElementById('book-half-right').innerHTML = pageInner(newSpread*2+1);
    requestAnimationFrame(()=>requestAnimationFrame(()=>{ flip.style.transform = 'rotateY(160deg)'; }));
  }
  setTimeout(()=>{ flip.remove(); }, 750);
  bookSpread = newSpread;
  document.querySelectorAll('#book-dots .race-dot').forEach((d,i)=>d.classList.toggle('active', i===bookSpread));
}
window.bookOpen=()=>{ histPage=0; bookSpread=0; renderBook(); };
window.bookClose=()=>{ histPage=-1; renderBook(); };
window.bookNav=(d)=>{ turnBook((bookSpread+d+BOOK_SPREADS)%BOOK_SPREADS, d); };
window.bookGoTo=(i)=>{ if(i===bookSpread) return; turnBook(i, i>bookSpread?1:-1); };
renderBook();

// ===== TUTORIEL CRÉATION DE PERSO =====
const TUTO_DRAGON = `<img src="data:image/png;base64," alt="Dragon conseiller" style="width:100%;height:auto;filter:drop-shadow(0 6px 14px rgba(0,0,0,.5));"/>`;

const TUTO_STEPS = [
  {t:"Bienvenue, Téméraire !", html:"La fiche de personnage vierge se trouve sur le Discord, dans le salon <strong style=\"color:#F2E6CC\">« Fiche de personnage »</strong>. Suis ce petit guide étape par étape, je t'accompagne tout du long !"},
  {t:"Étape 1 — Identité", html:"Choisis ta <strong style=\"color:#F2E6CC\">Race</strong>, ta <strong style=\"color:#F2E6CC\">Classe</strong> et ton <strong style=\"color:#F2E6CC\">Genre</strong>. Trouve une photo d'identité et un nom. Choisis ensuite <strong style=\"color:#F2E6CC\">3 valeurs</strong> qui représentent la façon d'être de ton personnage et la manière dont tu devras l'interpréter en RP."},
  {t:"Étape 2 — PV & Mana", html:"Au niveau 1, répartis <strong style=\"color:#F2E6CC\">15 points</strong> entre les PV et le Mana comme tu le souhaites. Attention : selon la race et/ou la classe jouée, des points bonus peuvent être attribués."},
  {t:"Étape 3 — Élément & Langues", html:"Tous les Téméraires sont affiliés à un <strong style=\"color:#F2E6CC\">élément</strong> — choisis celui qui te fait plaisir, mais attention : tes dons seront liés à celui-ci. Pour les langues, tu as droit à un maximum de <strong style=\"color:#F2E6CC\">3 langues connues</strong> (Commun compris) pour commencer."},
  {t:"Étape 4 — Caractéristiques (D100)", html:`Le système est basé sur le <strong style="color:#F2E6CC">D100</strong>. Tu as 3 grands axes :
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:10px 0;">
      <div style="background:rgba(192,57,43,.12);border-radius:7px;padding:8px;text-align:center;font-size:12px;color:#CFC09A;"><strong style="color:var(--red);">Physique</strong><br><span style="color:#CFC09A;">Force, endurance, agilité</span></div>
      <div style="background:rgba(26,138,106,.1);border-radius:7px;padding:8px;text-align:center;font-size:12px;color:#CFC09A;"><strong style="color:var(--teal);">Social</strong><br><span style="color:#CFC09A;">Charisme, persuasion, présence</span></div>
      <div style="background:rgba(42,95,168,.1);border-radius:7px;padding:8px;text-align:center;font-size:12px;color:#CFC09A;"><strong style="color:var(--blue);">Mental</strong><br><span style="color:#CFC09A;">Intelligence, sagesse, volonté</span></div>
    </div>
    Tu disposes de <strong style="color:#F2E6CC">170% à répartir</strong> (attention : selon ta classe, cette répartition peut être contrainte). Chaque axe se subdivise en sous-stats : Physique → Puissance/Finesse · Social → Aura/Relation · Mental → Instinct/Savoir.`},
  {t:"Étape 5 — Compétences", html:"Tu disposes de <strong style=\"color:#F2E6CC\">60% à répartir</strong> librement entre tes compétences. <strong style=\"color:#F2E6CC\">4 compétences maximum.</strong> Tu peux choisir dans la liste ou créer tes propres compétences (à valider avec le MJ). Les sous-compétences hors combat se lancent avec des dés D4 à D20 selon la difficulté."},
  {t:"Étape 6 — Postures de base", html:`<div style="color:#CFC09A;display:flex;flex-direction:column;gap:8px;font-size:13px;">
      <div style="background:var(--red-pale);border-radius:7px;padding:10px;border-left:3px solid var(--red);"><strong style="color:var(--red);">⚔ Offensive</strong> — Dégâts maximum automatiques, pas d'esquive/parade possible. Zone critique élargie de 5%.</div>
      <div style="background:var(--gold-pale);border-radius:7px;padding:10px;border-left:3px solid var(--gold-d);"><strong style="color:#C09030;">✨ Focus</strong> — Dégâts normaux (lance le dé), +5% sur les jets, coût Mana réduit de 1. Pas d'esquive possible.</div>
      <div style="background:var(--teal-pale);border-radius:7px;padding:10px;border-left:3px solid var(--teal);"><strong style="color:var(--teal);">🛡 Défensive</strong> — Dégâts normaux, droit à 1 esquive ou 1 parade par tour.</div>
    </div>`},
  {t:"Étape 7 — Armes & Armures", html:"Choisis une arme principale (+ éventuellement secondaire/supplémentaire). Aucune liste imposée — sois inventif ! Les dés de dégâts vont de D4 à D12 avec bonus/malus. Même logique pour les armures (Réduction de Dégâts). Attention : certaines classes ne peuvent pas porter d'armure."},
  {t:"Étape 8 — Dons", html:"Ton personnage commence avec <strong style=\"color:#F2E6CC\">3 à 5 dons</strong>. Toutes les classes y ont droit ! Pas de liste imposée — sois inventif. Seule règle : respecte ta classe et l'élément choisi. Si ton élément est le Feu, oublie les sorts d'Eau. Détermine le nom, la description, le coût en Mana et les effets avec le MJ."},
  {t:"Étape 9 — Background", html:"Construis l'histoire de ton personnage ! Utilise le livret pour te situer dans les pays et le contexte d'Alésia. N'oublie pas de préciser <strong style=\"color:#F2E6CC\">pourquoi il est devenu un Téméraire</strong> et quel est son lien avec la Prophétie. Les bonus/malus de race et classe s'appliquent ici, ainsi que les particularités liées au background."},
  {t:"Et voilà !", html:"Ton Téméraire est prêt à fouler les terres d'Alésia. N'hésite pas à demander de l'aide au MJ à n'importe quelle étape. Bonne aventure !"},
];
let tutoStep = 0;
function renderTuto(){
  const w = document.getElementById('tuto-wrap');
  if(!w) return;
  const s = TUTO_STEPS[tutoStep];
  w.innerHTML = `<div class="tuto-wrap">
    <div class="tuto-mascot">${TUTO_DRAGON}</div>
    <div class="tuto-bubble">
      <div class="tuto-num">${tutoStep===0?'Introduction':(tutoStep===TUTO_STEPS.length-1?'Conclusion':`Étape ${tutoStep} / ${TUTO_STEPS.length-2}`)}</div>
      <div class="tuto-title">${s.t}</div>
      <div style="font-size:13px;color:#CFC09A;line-height:1.7;">${s.html}</div>
    </div>
  </div>
  <div class="tuto-nav">
    <button class="race-arrow" onclick="tutoNav(-1)" ${tutoStep===0?'style="visibility:hidden;"':''} aria-label="Précédent"><i class="ti ti-chevron-left"></i></button>
    <div class="race-dots" style="margin:0;">${TUTO_STEPS.map((_,i)=>`<div class="race-dot ${i===tutoStep?'active':''}" onclick="tutoGoTo(${i})"></div>`).join('')}</div>
    <button class="race-arrow" onclick="tutoNav(1)" ${tutoStep===TUTO_STEPS.length-1?'style="visibility:hidden;"':''} aria-label="Suivant"><i class="ti ti-chevron-right"></i></button>
  </div>`;
}
window.tutoNav=(d)=>{ tutoStep=Math.max(0,Math.min(TUTO_STEPS.length-1,tutoStep+d)); renderTuto(); };
window.tutoGoTo=(i)=>{ tutoStep=i; renderTuto(); };
renderTuto();

// ===== TUTORIEL RÈGLES DU JEU =====
const RULES_STEPS = [
  {t:"Le Maître des Règles", html:"Je vais te présenter les principales règles du jeu d'Alésia. Garde-moi sous le coude si tu as un doute en pleine partie !"},
  {t:"Mécanique de base — D100", html:`Pour tenter une action, lance 1D100. <strong style="color:#F2E6CC">Succès</strong> si le résultat est ≤ à ta caractéristique + compétence. <strong style="color:#F2E6CC">Échec</strong> dans le cas contraire.
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;">
      <div style="color:#CFC09A;background:rgba(26,138,106,.1);border-radius:7px;padding:8px;font-size:12px;"><strong style="color:var(--teal);">✅ Réussite critique (1–5)</strong><br><span style="color:#CFC09A;">Effet bonus défini par le MJ ou le joueur.</span></div>
      <div style="color:#CFC09A;background:rgba(192,57,43,.1);border-radius:7px;padding:8px;font-size:12px;"><strong style="color:var(--red);">❌ Échec critique (95–100)</strong><br><span style="color:#CFC09A;">Conséquence négative majeure.</span></div>
    </div>`},
  {t:"Combat & Armure", html:"Les dégâts reçus sont réduits par les points d'armure de ton équipement (Réduction de Dégâts = RD). Une fois par combat, le groupe peut prendre une <strong style=\"color:#F2E6CC\">phase de planification stratégique</strong> en utilisant un \"Point Strat\" pour organiser sa tactique."},
  {t:"Jet de Survie", html:`Intervient quand un personnage risque de mourir (blessure mortelle, accident, magie dangereuse). Le MJ fixe un seuil sur D100 selon la dangerosité et les PV perdus.
    <div style="color:#CFC09A;display:flex;flex-direction:column;gap:6px;font-size:12px;margin-top:10px;">
      <div style="padding:7px 10px;background:rgba(45,32,14,.85);border-radius:7px;border-left:3px solid var(--gold-d);"><strong style="color:#F2E6CC">Essais :</strong> 2 essais par défaut. Les personnages avec la compétence <strong style="color:#F2E6CC">Chance</strong> ont un 3ème essai.</div>
      <div style="padding:7px 10px;background:var(--teal-pale);border-radius:7px;border-left:3px solid var(--teal);"><strong style="color:#F2E6CC">Réussite :</strong> le personnage survit dans un état critique.</div>
      <div style="padding:7px 10px;background:var(--red-pale);border-radius:7px;border-left:3px solid var(--red);"><strong style="color:#F2E6CC">Échec (tous les essais) :</strong> le personnage succombe.</div>
    </div>`},
  {t:"Altérations d'état", html:`<div style="color:#CFC09A;display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;">
      <div style="background:rgba(255,200,0,.12);border:1px solid rgba(200,150,0,.3);border-radius:7px;padding:8px;"><strong style="color:#a07800;">🟡 Carton Jaune</strong><br><span style="color:#CFC09A;">−1 point sur la caractéristique, −10% aux jets.</span></div>
      <div style="background:var(--red-pale);border:1px solid rgba(139,32,32,.2);border-radius:7px;padding:8px;"><strong style="color:var(--red);">🔴 Carton Rouge</strong><br><span style="color:#CFC09A;">Blocage total + malus calculé sur la sous-stat × 10%.</span></div>
    </div>`},
  {t:"Dés d'aventure / mésaventure", html:`<div style="color:#CFC09A;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:12px;text-align:center;">
      <div style="background:rgba(45,32,14,.85);border-radius:7px;padding:8px;"><strong style="color:#F2E6CC">1–2</strong><br><span style="color:#CFC09A;">Mouvement</span></div>
      <div style="background:rgba(45,32,14,.85);border-radius:7px;padding:8px;"><strong style="color:#F2E6CC">3–4</strong><br><span style="color:#CFC09A;">Posture</span></div>
      <div style="background:rgba(45,32,14,.85);border-radius:7px;padding:8px;"><strong style="color:#F2E6CC">5–6</strong><br><span style="color:#CFC09A;">Bonus "In extremis" (+5%)</span></div>
    </div>
    <p style="font-size:12px;color:#A09070;margin-top:8px;font-style:italic;">Après usage, les dés blancs deviennent noirs, donnant au MJ la possibilité de retourner la situation.</p>`},
  {t:"Progression de niveau", html:`<div style="color:#CFC09A;display:flex;flex-direction:column;gap:6px;font-size:12px;">
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;display:flex;gap:10px;align-items:flex-start;"><span style="font-family:'Cinzel',serif;color:#C09030;font-size:11px;min-width:60px;">Niveau 2</span><span style="color:#CFC09A;">+5 PV <em>ou</em> +5% à la caractéristique la plus basse <em>ou</em> +10% répartis sur les compétences.</span></div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;display:flex;gap:10px;align-items:flex-start;"><span style="font-family:'Cinzel',serif;color:#C09030;font-size:11px;min-width:60px;">Niveau 3</span><span style="color:#CFC09A;">+3 PV/Mana et un nouveau don dans sa branche.</span></div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;display:flex;gap:10px;align-items:flex-start;"><span style="font-family:'Cinzel',serif;color:#C09030;font-size:11px;min-width:60px;">Niveau 4</span><span style="color:#CFC09A;">+3 PV/Mana et remplacement d'une valeur par une Passion.</span></div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;display:flex;gap:10px;align-items:flex-start;"><span style="font-family:'Cinzel',serif;color:#C09030;font-size:11px;min-width:60px;">Niveau 5</span><span style="color:#CFC09A;">+3 PV/Mana, +5% à toutes les stats, acquisition d'une <strong style="color:#F2E6CC">posture élémentaire</strong>.</span></div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;display:flex;gap:10px;align-items:flex-start;"><span style="font-family:'Cinzel',serif;color:#C09030;font-size:11px;min-width:60px;">Niveau 6</span><span style="color:#CFC09A;">Amélioration d'un Don existant ou obtention d'un nouveau Don.</span></div>
    </div>`},
  {t:"Règles spéciales par classe", html:`<div style="color:#CFC09A;display:flex;flex-direction:column;gap:8px;font-size:12px;">
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Cogneur</strong> — Physique obligatoirement majeur. Puissance = sous-stat majeure. <strong style="color:#F2E6CC">150% à répartir</strong> (pas 170%).</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Rôdeur</strong> — Physique obligatoirement majeur. Finesse = sous-stat majeure.</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Gardien</strong> — Physique obligatoirement majeur. Puissance = sous-stat majeure. Social fixé à 50% obligatoirement.</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Lames Noires</strong> — Physique obligatoirement majeur. Finesse = sous-stat majeure. <strong style="color:#F2E6CC">140% à répartir</strong>.</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Oracle</strong> — Mental obligatoirement majeur. Impossible d'avoir des dons infligeant des dégâts physiques. Doit incarner empathie et altruisme.</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Arcaniste</strong> — Mental obligatoirement majeur. Physique max 40%. Mana max doit être au moins le double du PV max.</div>
      <div style="padding:8px;background:rgba(45,32,14,.85);border-radius:7px;"><strong style="color:#F2E6CC;">Troubadour</strong> — Social obligatoirement majeur. Physique max 35%.</div>
    </div>`},
  {t:"À toi de jouer !", html:"Tu connais maintenant les bases. N'hésite pas à revenir consulter cette page en cours de partie. Bon courage, Téméraire !"},
];
let rulesStep = 0;
function renderRulesTuto(){
  const w = document.getElementById('regles-tuto-wrap');
  if(!w) return;
  const s = RULES_STEPS[rulesStep];
  w.innerHTML = `<div class="tuto-wrap">
    <div class="tuto-mascot">${TUTO_DRAGON}</div>
    <div class="tuto-bubble">
      <div class="tuto-num">${rulesStep===0?'Introduction':(rulesStep===RULES_STEPS.length-1?'Conclusion':`Règle ${rulesStep} / ${RULES_STEPS.length-2}`)}</div>
      <div class="tuto-title">${s.t}</div>
      <div style="font-size:13px;color:#CFC09A;line-height:1.7;">${s.html}</div>
    </div>
  </div>
  <div class="tuto-nav">
    <button class="race-arrow" onclick="rulesNav(-1)" ${rulesStep===0?'style="visibility:hidden;"':''} aria-label="Précédent"><i class="ti ti-chevron-left"></i></button>
    <div class="race-dots" style="margin:0;">${RULES_STEPS.map((_,i)=>`<div class="race-dot ${i===rulesStep?'active':''}" onclick="rulesGoTo(${i})"></div>`).join('')}</div>
    <button class="race-arrow" onclick="rulesNav(1)" ${rulesStep===RULES_STEPS.length-1?'style="visibility:hidden;"':''} aria-label="Suivant"><i class="ti ti-chevron-right"></i></button>
  </div>`;
}
window.rulesNav=(d)=>{ rulesStep=Math.max(0,Math.min(RULES_STEPS.length-1,rulesStep+d)); renderRulesTuto(); };
window.rulesGoTo=(i)=>{ rulesStep=i; renderRulesTuto(); };
renderRulesTuto();

// ===== DÉS D'AVENTURE / MÉSAVENTURE =====
let advState = { mesaventure: 0 };
let advRemote = false;
function renderAdv(){
  const meso = advState.mesaventure ?? 0;
  const aven = 4 - meso;
  const a=document.getElementById('adv-aventure'), m=document.getElementById('adv-mesaventure');
  if(a){
    a.textContent = aven;
    m.textContent = meso;
    a.parentElement.style.flexGrow = aven;
    m.parentElement.style.flexGrow = meso || 0.0001;
    document.getElementById('adv-dice-row').innerHTML = Array.from({length:4},(_,i)=>
      `<div class="adv-die ${i<aven?'on-aventure':'on-mesaventure'}"><i class="ti ti-dice-${i+1<=6?(i+1):6}"></i></div>`
    ).join('');
  }
  // Mini rappel dans le panneau personnages
  const miniRow = document.getElementById('adv-mini-row');
  const miniAven = document.getElementById('adv-mini-aven');
  const miniMeso = document.getElementById('adv-mini-meso');
  if(miniRow){
    miniRow.innerHTML = Array.from({length:4},(_,i)=>
      `<div class="adv-die ${i<aven?'on-aventure':'on-mesaventure'}" style="width:30px;height:30px;font-size:18px;"><i class="ti ti-dice-${i+1<=6?(i+1):6}"></i></div>`
    ).join('');
  }
  if(miniAven) miniAven.textContent = aven;
  if(miniMeso) miniMeso.textContent = meso;
}
window.advShift=(dir)=>{
  let m = advState.mesaventure ?? 0;
  m = Math.max(0, Math.min(4, m+dir));
  advState.mesaventure = m;
  renderAdv();
  advSave();
};
window.advReset=()=>{
  advState.mesaventure = 0;
  renderAdv();
  advSave();
};
function advSave(){
  advRemote = true;
  setDoc(doc(db,'characters','_advdice'), advState)
    .catch(e=>{ console.error('advSave error', e); toast('Erreur de sync dés ✗'); })
    .finally(()=>{ advRemote=false; });
}
function listenAdvDice(){
  onSnapshot(doc(db,'characters','_advdice'), snap=>{
    if(snap.exists() && !advRemote){
      advState = snap.data();
      renderAdv();
    } else if(!snap.exists()){
      renderAdv();
    }
  }, e=>{ console.error('advListen error', e); });
}

// ===== NÉGOCIATION =====
const NEG_MANCHE = [0.1,0.2,0.3];
const NEG_MOD = { critM_succes:1, critM_echec:-0.5, critJ_succes:-0.5, critJ_echec:2, egalite:-0.8 };
let negState = { base:5000, price:5000, log:[], ended:false };
let negRemote = false;

const NEG_OPTIONS = [
  {v:'',label:'— Choisir le résultat —'},
  {v:'J',label:'Victoire Joueur'},
  {v:'M',label:'Victoire Marchand'},
  {v:'EGAL',label:'Égalité'},
  {v:'critJ_succes',label:'Critique — Succès Joueur'},
  {v:'critJ_echec',label:'Critique — Échec Joueur'},
  {v:'critM_succes',label:'Critique — Succès Marchand'},
  {v:'critM_echec',label:'Critique — Échec Marchand'},
];

function negStart(){
  const base = parseFloat(document.getElementById('neg-base').value) || 5000;
  negState = { base, price: base, log: [], ended:false };
  for(let i=0;i<3;i++) negState[`r${i}`] = '';
  negRenderRounds();
  negUpdateDisplay();
  negSave();
}
function negSave(){
  negRemote = true;
  setDoc(doc(db,'characters','_negociation'), negState)
    .catch(e=>{ console.error('negSave error', e); toast('Erreur de sync négociation ✗'); })
    .finally(()=>{ negRemote=false; });
}
function negRenderRounds(){
  const c = document.getElementById('neg-rounds');
  c.innerHTML = '';
  for(let i=0;i<3;i++){
    const disabled = negState.ended || (i>0 && !negState[`r${i-1}`]);
    const wrap = document.createElement('div');
    wrap.innerHTML = `<div style="font-size:11px;color:var(--gold-d);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">Manche ${i+1} <span style="color:#CFC09A;text-transform:none;letter-spacing:0;">(${NEG_MANCHE[i]*100}%)</span></div>`;
    const sel = document.createElement('select');
    sel.style="width:100%;background:rgba(0,0,0,.3);border:1px solid var(--bord);border-radius:6px;color:#F2E6CC;padding:8px 10px;font-size:13px;";
    sel.disabled = disabled;
    NEG_OPTIONS.forEach(o=>{ const opt=document.createElement('option'); opt.value=o.v; opt.textContent=o.label; if(o.v===negState[`r${i}`]) opt.selected=true; sel.appendChild(opt); });
    sel.onchange = ()=> negApplyRound(i, sel.value);
    wrap.appendChild(sel);
    c.appendChild(wrap);
  }
}
function negApplyRound(i, val){
  negState[`r${i}`] = val;
  for(let j=i+1;j<3;j++) negState[`r${j}`]='';
  negState.price = negState.base;
  negState.log = [];
  negState.ended = false;
  for(let j=0;j<3;j++){
    const r = negState[`r${j}`];
    if(!r) break;
    if(r==='J'){ const before=negState.price; negState.price -= negState.price*NEG_MANCHE[j]; negState.log.push(`Manche ${j+1} — Victoire Joueur : ${Math.round(before)} → ${Math.round(negState.price)} PO (−${NEG_MANCHE[j]*100}%)`); }
    else if(r==='M'){ const before=negState.price; negState.price += negState.price*NEG_MANCHE[j]; negState.log.push(`Manche ${j+1} — Victoire Marchand : ${Math.round(before)} → ${Math.round(negState.price)} PO (+${NEG_MANCHE[j]*100}%)`); }
    else if(r==='EGAL'){ negState.price = negState.base*(1+NEG_MOD.egalite); negState.log.push(`Manche ${j+1} — Égalité : prix ramené à ${Math.round(negState.price)} PO (${NEG_MOD.egalite*100}% du prix de base)`); negState.ended=true; break; }
    else {
      const mod = NEG_MOD[r];
      negState.price = negState.base*(1+mod);
      const lbl = {critJ_succes:'Critique — Succès Joueur',critJ_echec:'Critique — Échec Joueur',critM_succes:'Critique — Succès Marchand',critM_echec:'Critique — Échec Marchand'}[r];
      negState.log.push(`Manche ${j+1} — ${lbl} : prix fixé à ${Math.round(negState.price)} PO (${mod>0?'+':''}${mod*100}% du prix de base)`);
      negState.ended=true; break;
    }
    if(j===2) negState.ended=true;
  }
  negRenderRounds();
  negUpdateDisplay();
  negSave();
}
function negUpdateDisplay(){
  document.getElementById('neg-price').innerHTML = Math.round(negState.price) + ' <span style="font-size:18px;">PO</span>';
  const beam = document.getElementById('neg-balance-beam');
  if(beam){
    const ratio = (negState.price - negState.base) / negState.base; // <0 favorable Joueur, >0 favorable Marchand
    const clamped = Math.max(-1, Math.min(1, ratio));
    const angle = clamped * 20;
    beam.style.transform = `rotate(${angle}deg)`;
  }
  document.getElementById('neg-log').innerHTML = negState.log.map(l=>`<div style="font-size:12px;color:#CFC09A;padding:6px 10px;background:rgba(212,168,67,.05);border-left:2px solid var(--gold-d);border-radius:4px;">${l}</div>`).join('');
  const finalEl = document.getElementById('neg-final');
  if(negState.ended){
    const diff = negState.price - negState.base;
    const pct = Math.round((diff/negState.base)*100);
    const color = diff<0 ? 'var(--teal)' : (diff>0 ? 'var(--red)' : 'var(--gold)');
    finalEl.innerHTML = `<div style="border-top:1px solid var(--bord);padding-top:12px;"><div style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:.1em;color:var(--gold-d);text-transform:uppercase;margin-bottom:6px;">Prix final négocié</div><div style="font-family:'Cinzel',serif;font-size:28px;color:${color};">${Math.round(negState.price)} PO</div><div style="font-size:12px;color:#CFC09A;margin-top:4px;">${diff<0?'Économie':'Surcoût'} de ${Math.abs(Math.round(diff))} PO (${pct>0?'+':''}${pct}% du prix de base)</div></div>`;
  } else {
    finalEl.innerHTML = '';
  }
}
function listenNegotiation(){
  onSnapshot(doc(db,'characters','_negociation'), snap=>{
    if(snap.exists() && !negRemote){
      negState = snap.data();
      document.getElementById('neg-base').value = negState.base;
      negRenderRounds();
      negUpdateDisplay();
    } else if(!snap.exists()){
      negStart();
    }
  }, e=>{ console.error('negListen error', e); toast('Erreur de lecture négociation ✗'); });
}
function openFiche(idx, tabEl){
  document.querySelectorAll('.fiche').forEach(f => f.classList.remove('active'));
  document.querySelectorAll('.classeur-tab').forEach(t => t.classList.remove('active'));
  const fiche = document.getElementById('fiche-' + idx);
  if(fiche) fiche.classList.add('active');
  if(tabEl) tabEl.classList.add('active');
}
window.openFiche = openFiche;

function toggleRace(i){
  const b=document.getElementById('rb-'+i),ic=document.getElementById('ric-'+i);
  const open=b.style.display==='block';
  b.style.display=open?'none':'block';ic.style.transform=open?'':'rotate(180deg)';
}
function toggleCosmLevel(n){
  const el=document.getElementById('lvl-'+n);
  const ic=document.getElementById('ico-'+n);
  if(!el||!ic)return;
  const open=el.style.display==='block';
  el.style.display=open?'none':'block';
  ic.style.transform=open?'':'rotate(180deg)';
}
window.toggleCosmLevel=toggleCosmLevel;
function ctToggle(card){
  var body=card.querySelector('.ct-card-body');
  var chev=card.querySelector('.ct-chevron');
  if(!body)return;
  var open=body.classList.contains('open');
  body.classList.toggle('open',!open);
  if(chev) chev.classList.toggle('open',!open);
}
window.ctToggle=ctToggle;
</script>
