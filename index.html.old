        </div>
      </div>

      <div id="custom-sections-container"></div>
    </main>
  </div>
</div>

<!-- SIDEBAR EDITOR MODAL -->
<div class="modal-overlay" id="nav-editor-modal" onclick="closeNavEditorOnBg(event)">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-title"><i class="ti ti-layout-sidebar" style="margin-right:7px;color:var(--gold)"></i>Configurer le menu</div>
      <button class="modal-close" onclick="closeNavEditor()">✕</button>
    </div>
    <div class="modal-body" id="nav-editor-body"></div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeNavEditor()">Annuler</button>
      <button class="btn-save" onclick="saveNavConfig()"><i class="ti ti-check"></i> Enregistrer</button>
    </div>
  </div>
</div>

<!-- DESIGN EDITOR MODAL -->
<div class="modal-overlay" id="design-editor-modal" onclick="closeDesignEditorOnBg(event)">
  <div class="modal-box wide">
    <div class="modal-head">
      <div class="modal-title"><i class="ti ti-palette" style="margin-right:7px;color:var(--gold)"></i>Personnaliser le design</div>
      <button class="modal-close" onclick="closeDesignEditor()">✕</button>
    </div>
    <div class="modal-body" id="design-editor-body">

      <!-- THÈMES PRÉDÉFINIS -->
      <div class="design-section">
        <div class="design-label"><i class="ti ti-wand"></i> Thèmes prédéfinis</div>
        <div class="preset-grid" id="preset-grid"></div>
      </div>

      <!-- TITRE DU SITE -->
      <div class="design-section">
        <div class="design-label"><i class="ti ti-typography"></i> Titre & sous-titre</div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;align-items:center;gap:10px;">
            <label style="font-size:18.8px;color:#CFC09A;width:90px;flex-shrink:0;">Titre</label>
            <input id="de-title" class="nav-add-input" style="flex:1" value="⚔ Alésia" oninput="previewDesign()">
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <label style="font-size:18.8px;color:#CFC09A;width:90px;flex-shrink:0;">Sous-titre</label>
            <input id="de-subtitle" class="nav-add-input" style="flex:1" value="Portail de campagne" oninput="previewDesign()">
          </div>
        </div>
      </div>

      <!-- COULEURS -->
      <div class="design-section">
        <div class="design-label"><i class="ti ti-color-swatch"></i> Couleurs</div>
        <div class="design-grid">
          <div>
            <div class="color-row">
              <span class="color-label">Couleur principale (or)</span>
              <div class="color-swatch" id="sw-gold"><div class="color-preview" id="cp-gold" style="background:#C9A84C"></div><input type="color" id="de-gold" value="#C9A84C" oninput="updateSwatch('gold',this.value);previewDesign()"></div>
            </div>
            <div class="color-row">
              <span class="color-label">Fond de page</span>
              <div class="color-swatch" id="sw-parch"><div class="color-preview" id="cp-parch" style="background:#F5EFE0"></div><input type="color" id="de-parch" value="#F5EFE0" oninput="updateSwatch('parch',this.value);previewDesign()"></div>
            </div>
            <div class="color-row">
              <span class="color-label">Fond des cartes</span>
              <div class="color-swatch" id="sw-surf"><div class="color-preview" id="cp-surf" style="background:#FAF6EC"></div><input type="color" id="de-surf" value="#FAF6EC" oninput="updateSwatch('surf',this.value);previewDesign()"></div>
            </div>
          </div>
          <div>
            <div class="color-row">
              <span class="color-label">En-tête (header)</span>
              <div class="color-swatch" id="sw-header"><div class="color-preview" id="cp-header" style="background:#2C2416"></div><input type="color" id="de-header" value="#2C2416" oninput="updateSwatch('header',this.value);previewDesign()"></div>
            </div>
            <div class="color-row">
              <span class="color-label">Barre latérale</span>
              <div class="color-swatch" id="sw-nav"><div class="color-preview" id="cp-nav" style="background:#FAF6EC"></div><input type="color" id="de-nav" value="#FAF6EC" oninput="updateSwatch('nav',this.value);previewDesign()"></div>
            </div>
            <div class="color-row">
              <span class="color-label">Texte principal</span>
              <div class="color-swatch" id="sw-ink"><div class="color-preview" id="cp-ink" style="background:#2C2416"></div><input type="color" id="de-ink" value="#2C2416" oninput="updateSwatch('ink',this.value);previewDesign()"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- IMAGE DE FOND -->
      <div class="design-section">
        <div class="design-label"><i class="ti ti-photo"></i> Image de fond</div>
        <div class="img-upload-zone" id="upload-zone">
          <input type="file" accept="image/*" onchange="handleImageUpload(event)">
          <div class="upload-icon"><i class="ti ti-cloud-upload"></i></div>
          <div class="upload-text">Glissez une image ou cliquez pour choisir<br><span style="font-size:17.2px;opacity:.7;">JPG, PNG, WebP — recommandé: 1920×1080</span></div>
          <img id="bg-preview" class="img-preview" alt="Aperçu fond">
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
          <button class="btn-cancel" style="font-size:15.6px;padding:5px 10px;" onclick="clearBgImage()"><i class="ti ti-x"></i> Retirer l'image</button>
          <div style="font-size:17.2px;color:#A09070;font-style:italic;line-height:1.4;padding:5px 0;">L'image est stockée localement dans votre navigateur (non partagée).</div>
        </div>
        <div class="range-row" style="margin-top:10px;">
          <label>Opacité fond</label>
          <input type="range" id="de-bg-opacity" min="0" max="95" value="0" oninput="previewDesign();document.getElementById('de-bg-opacity-val').textContent=this.value+'%'">
          <span id="de-bg-opacity-val">0%</span>
        </div>
        <div style="font-size:17.2px;color:#A09070;font-style:italic;">↑ Opacité du voile blanc sur l'image (0% = image pure, 80% = très atténuée)</div>
      </div>

      <!-- BORDURE RADIUS -->
      <div class="design-section">
        <div class="design-label"><i class="ti ti-border-radius"></i> Style des cartes</div>
        <div class="range-row">
          <label>Arrondi des coins</label>
          <input type="range" id="de-radius" min="0" max="20" value="10" oninput="previewDesign();document.getElementById('de-radius-val').textContent=this.value+'px'">
          <span id="de-radius-val">10px</span>
        </div>
      </div>

    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="resetDesign()"><i class="ti ti-refresh"></i> Réinitialiser</button>
      <button class="btn-cancel" onclick="closeDesignEditor()">Annuler</button>
      <button class="btn-save" onclick="saveDesign()"><i class="ti ti-check"></i> Appliquer à tous</button>
    </div>
  </div>
</div>

<div id="toast"></div>


<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
