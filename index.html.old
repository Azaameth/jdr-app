// État global
const defaultChars = {
  azarius:{name:'Azarius Desbois',race:'Kitsune',genre:'Homme',classe:'Cogneur',element:'🔥 Feu',niveau:'1',pv:'14',mana:'9',pv_max:'14',mana_max:'9',phys:'85',social:'45',mental:'40',valeurs:'',langues:'Commun, Kitsune, Démoniaque',competences:[{n:'Puissance',v:6},{n:'Finesse',v:3},{n:'Aura',v:3},{n:'Relation',v:2},{n:'Instinct',v:2},{n:'Savoir (Érudit)',v:2},{n:'Persuasion',v:2},{n:'Survie',v:2},{n:'Érudit',v:2}],armes:'Vieille épée (D4/−1)\nRobe d\'Arcaniste enchantée (RD2)\nAnneau du Dieu du Feu (RD2 vs proj. magiques)',armures:'Robe d\'Arcaniste enchantée (RD2)\nAnneau du Dieu du Feu (vs proj. magiques)',dons:'🔥 Turbo Fist — 2 mana / 1D10+2\n🔥 Armagédon sans Bâton — 5 mana / 1D12+4\n🔥 Fire Shield — 3 mana / 1D6+1\n🔥 Say My Name — 8 mana / 1D6+1D8+1\n⚔ Maîtrise des Armes : relance 1×/combat\n💥 Baroud d\'Honneur : <30% PV → +2 dégâts',equip:'Rations ×19, Sac enchanté ×1, Kit médical ×4, Boussole magique ×1, Parchemin démon ×20, Corde 11m ×1, Livre Orc ×1',race_bonus:'🟢 Ruse naturelle +20%\n🟢 Vivacité renarde +10%\n🟢 Pas léger +10%\n🔴 Force faible −20%\n🔴 Défiance générale −25%',notes:'Né dans une tribu vivant au pied d\'un volcan, Azarius Desbois fut initié très jeune à la magie du feu, considérée comme une force sacrée et vivante. Il apprit à en canaliser la chaleur, la colère et la beauté sous la guidance des anciens.\nMais un incendie magique incontrôlé ravagea sa forêt natale, réduisant sa tribu en cendres. Depuis ce jour, Azarius a juré de retrouver celui qui a déclenché le brasier et de protéger l\'équilibre entre la flamme et la nature.\nPorté par ce serment et avide de réponses, il a rejoint les Téméraires, convaincu que la Prophétie du Lac lui révélera la vérité derrière le feu qui l\'habite.',color:'rgba(201,168,76,.15)',init:'A'},
  dy:{name:'Dy Son',race:'Elfe',genre:'Femme',classe:'Arcaniste',element:'💨 Air',niveau:'1',pv:'7',mana:'11',pv_max:'7',mana_max:'11',phys:'35',social:'45',mental:'90',valeurs:'',langues:'Commun, Elfique, Démoniaque',competences:[{n:'Puissance',v:2},{n:'Finesse',v:2},{n:'Aura',v:4},{n:'Beauté naturelle',v:1},{n:'Relation',v:1},{n:'Instinct',v:3},{n:'Savoir (Expert sorts)',v:6},{n:'Savoir interdit',v:1},{n:'Rat de bibliothèque',v:1},{n:'Expert en sorts',v:3}],armes:'Baguette (D4/−3)\nDague (D6/+1)',armures:'Robe d\'Arcaniste enchantée (RD2)\nAnneau du Dieu du Vent',dons:'🌬 Déplacement d\'Air — 2 mana\n🌬 Mur d\'Air — 6 mana\n🌬 Lame d\'Air — 3 mana / D8+2\n🌬 Largage Aérien — 2+(1/5m) mana\n🔮 Invocations démoniques\n🌑 La Boule Magique — tout le mana\n✨ Maîtrise des Arcanes\n📚 Connaissance Interdite',equip:'Rations ×5, Kit médical ×4, Potion vie D6 ×3, Livre de Magie ×1, Corde 10m ×1',race_bonus:'🟢 Sens affûtés +20%\n🟢 Mémoire ancienne +10%\n🔴 Détachement social −20%\n🔴 Fragilité physique −10%',notes:'Née au cœur des forêts anciennes d\'Akassya, Dy passa son enfance perchée parmi les branches, entourée des siens et bercée par le chant des vents et le bruissement des feuilles. Sa curiosité pour la magie naquit tôt, mais ce fut la rencontre fortuite avec un élémentaire du vent qui éveilla en elle un don exceptionnel : la capacité de comprendre et de manipuler les courants d\'air comme un langage secret.\nÉduquée dans une école humaine d\'arcanistes, Dy apprit à combiner la discipline humaine et l\'instinct elfique, devenant une érudite des arcanes élémentaires. Sa soif de savoir et son désir de liberté l\'ont menée à rejoindre les Téméraires, dans l\'espoir de percer les secrets de la Prophétie du Lac et de lever la barrière de l\'Île du Cœur.\nCependant, malgré son ouverture sur le monde, Dy nourrit un préjugé marqué contre les Kitsuné, qu\'elle considère avec méfiance et suspicion, résultat d\'expériences passées et de convictions culturelles profondément ancrées.\nPour Dy, chaque souffle de vent, chaque tourbillon et chaque tempête sont autant de leçons à écouter et à maîtriser, un écho des mystères qu\'elle cherche à dévoiler à travers sa quête.',color:'rgba(29,107,90,.1)',init:'D'},
  firm:{name:'Firm Bintaggle',race:'Swamninyx',genre:'Homme',classe:'Gardien',element:'🌿 Nature',niveau:'1',pv:'24',mana:'7',pv_max:'24',mana_max:'7',phys:'65',social:'50',mental:'55',valeurs:'',langues:'Commun, Swamninyx, Léonide',competences:[{n:'Puissance',v:4},{n:'Finesse',v:3},{n:'Aura',v:2},{n:'Relation',v:3},{n:'Instinct',v:3},{n:'Savoir (Herboriste)',v:3},{n:'Bagarre',v:2},{n:'Survie',v:1},{n:'Druide',v:3},{n:'Herboriste',v:1}],armes:'Bâton Long druidique (D6/+1)\nWok (D4/0)',armures:'Armure enchantée druidique (RD6)\nBouclier de cuivre (RD2)',dons:'🌿 Transmutation — 1-2 mana\n💪 Gonflette — 2 mana/palier\n🌸 Tarte aux prunes\n👁 Extension du territoire\n⚔ Châtiment Sacré\n🛡 Provoc\' Sauvage',equip:'Rations ×6, Bandages ×3, Potion PV D10 ×1, Lanterne ×1',race_bonus:'🟢 Agilité +20%\n🟢 Discrétion naturelle +10%\n🔴 Aversion sociale −10%\n🔴 Force limitée −10%',notes:'Né dans le royaume saint de Zarûn, Firm fut vendu par ses parents à l\'âge de 5 ans à des esclavagistes pour une poignée d\'or.\nPendant son transport vers les terres du commandant Suba, où il devait passer le restant de ses jours, il réussit à s\'échapper lors d\'une attaque par des pillards.\nSeul dans un territoire inconnu pendant des jours, il fut trouvé par un druide vagabond nommé Stonks, qui prit Firm sous son aile et décida de lui inculquer la voie du druide.\nFirm avait une grande affinité avec la magie de la nature, mais était très mauvais pour lancer des sorts. Par dépit, après de longues années de formation, Stonks décida de l\'envoyer dans la forêt magique de Doulogne, en dehors d\'Alésia, afin qu\'il suive la voie de la transformation druidesque, où il passa 10 ans à contrôler la transformation de sa bête intérieure.\nUne fois sa formation achevée, il se mit en route pour rentrer à son pays natal, en quête d\'ouvrir une école de formation de gardien-druides.',color:'rgba(83,74,183,.1)',init:'F'},
  mwassa:{name:'Mwassa Mekhsitt',race:'Kitsune',genre:'Femme',classe:'Oracle',element:'💧 Eaux',niveau:'1',pv:'10',mana:'17',pv_max:'10',mana_max:'17',phys:'35',social:'65',mental:'70',valeurs:'',langues:'Commun, Kitsune, Nain',competences:[{n:'Puissance',v:1},{n:'Finesse',v:3},{n:'Aura',v:3},{n:'Relation',v:4},{n:'Instinct',v:4},{n:'Savoir (Charmeuse)',v:3},{n:'Chance',v:1},{n:'Experte en sorts',v:2},{n:'Charmeuse',v:2},{n:'Alchimie',v:1}],armes:'Tambourins et Castagnettes (D4/−2)\nPistolet à silex (D6/0)\nDague (D4/0)',armures:'(Armure impossible — Oracle)',dons:'🥁 Bénédiction du goupil — 3 mana\n⚔ Aux armes ! — 1+D4-12 mana\n🎭 Marionette — 6 mana\n💧 Rosée de la vitalité\n✨ Soin Divin\n🤝 Pacte des 12',equip:'Rations ×2, Balles ×19, Kit médical ×1, Kit crochetage ×3, Anneau de Mana ×1',race_bonus:'🟢 Ruse naturelle +20%\n🟢 Vivacité renarde +10%\n🔴 Force faible −20%\n🔴 Défiance générale −25%',notes:'Née dans les bas-quartiers d\'Auregia, Mwassa grandit dans un bordel où elle apprit très tôt l\'art de plaire et d\'écouter. Lorsque sa jeunesse fanée perdit de sa valeur, elle fut renvoyée sans un mot. Pour survivre, elle transforma sa voix en arme et son tambourin en bouclier, charmant les tavernes et les passants d\'Auregia jusqu\'à Ozélis.\nSous ses airs charmeurs, elle garde un passé plus sombre : ancienne novice de Zarûn, enlevée enfant pour être vendue à la maison close. Elle conserve de cette vie une relique, qu\'elle porte encore — entre honte et mémoire.\nConnue d\'un ancien client devenu compagnon, elle a trouvé dans le groupe des Téméraires une nouvelle raison de chanter.\nCar pour Mwassa, la Prophétie est devenue tel un phare dans la nuit.',color:'rgba(29,107,90,.12)',init:'M'},
  nindey:{name:'Nindey Traqué',race:'Nain',genre:'Homme',classe:'Cogneur',element:'⚡ Foudre',niveau:'1',pv:'11',mana:'9',pv_max:'11',mana_max:'9',phys:'80',social:'20',mental:'50',valeurs:'',langues:'Commun, Nain, Draconique',competences:[{n:'Puissance',v:5},{n:'Finesse',v:3},{n:'Aura',v:2},{n:'Relation',v:2},{n:'Instinct',v:4},{n:'Savoir (Expert Runique)',v:1},{n:'Artisan',v:1.5},{n:'Maniement d\'arme',v:1},{n:'Expert Runique',v:2.5},{n:'Forgeron',v:1}],armes:'Deux haches à une main (D10/+4)\nHache à deux mains (D12/+4)\nPioche + Marteau (D4/+3)',armures:'Armure runique (RD4)\nAnneau anti-magie RD1',dons:'⚡ Armes Foudroyante — 3 mana\n🔨 Marteau de Thor — 2 mana\n💥 Blitzer — 4 mana / D6+1\n⚡ Lance de Foudre — 6 mana\n⚔ Maîtrise des Armes\n💥 Baroud d\'Honneur',equip:'Rations ×18, Kit médical ×2, Rune Majeur Feu (50k PO), Corde 10m ×1',race_bonus:'🟢 Savoir des forges +20%\n🟢 Vision des profondeurs +10%\n🔴 Vitesse réduite −10%\n🔴 Adaptation sociale −10%',notes:'Nindey naquit au cœur des mines profondes du royaume du Mont RockDur, là où les marteaux résonnent jour et nuit et où l\'odeur de la bière est presque aussi omniprésente que celle du métal chaud. Comme tout bon nain, il grandit entre pierres, trésors, jurons crépitants et pintes bien remplies. Mais son destin prit une tournure aussi improbable qu\'un elfe qui apprécierait une bonne bière : il se lia d\'amitié avec un jeune dragon nommé Skarlath, être farouche, étincelant comme une tempête et légèrement pyromane doublé d\'un certain attrait pour l\'alcool.\nUn jour, alors que Nindey s\'aventurait dans la forêt au-delà de la mine, il tomba dans une embuscade de créatures hostiles. Juste avant de finir réduit en compote nainesque, Skarlath fondit du ciel, balayant les ennemis dans une explosion d\'éclairs et de flammes. Gravement blessé, Nindey fut emporté par le dragon qui le soigna à coups d\'houblon et d\'orge.\nC\'est durant ces années passées avec Skarlath que Nindey développa une fascination profonde pour les runes draconiques. Le dragon lui enseigna les secrets des runes liées à la foudre, lui permettant d\'enchanter ses haches. Lorsque la foudre les parcourt, il se sent littéralement invincible… et parfois oublie complètement d\'élaborer un plan.\nDe retour au Mont RockDur, Nindey devint un forgeron reconnu pour ses enchantements électriques et une sorte de légende locale. Expert dans le maniement de ses deux haches, il fonce toujours tête la première dans le combat, guidé par l\'adrénaline, la foudre… et parfois l\'alcool.\nTimide au naturel, il devient étonnamment sociable après quelques pintes et raconte volontiers ses aventures, son dégoût pour les elfes (sans raison particulière — c\'est juste qu\'il est nain) et sa bière préférée, brassée selon une recette secrète qu\'il ne révélerait pour rien au monde.\nAujourd\'hui, Nindey parcourt le monde à la recherche de nouveaux matériaux, de runes oubliées, de combats glorieux… et de tavernes. Et si une tempête éclate dans le ciel, il sourit : peut-être que Skarlath veille encore, quelque part.',color:'rgba(139,32,32,.1)',init:'N'}
};

let charData = JSON.parse(JSON.stringify(defaultChars));
let currentUser = null;
let isMJ = false;
let navConfig = JSON.parse(JSON.stringify(DEFAULT_NAV));
let customPagesData = {};
let editingNav = [];
let dragSrcIdx = null;
let currentDesign = {};
let bgImageDataUrl = null;

// ===== AUTH =====
window.signIn = async () => { try { await signInWithPopup(auth, provider); } catch(e){ console.error(e); } };
window.doSignOut = async () => {
  await signOut(auth);
  document.getElementById('auth-overlay').classList.remove('hidden');
  document.getElementById('app').classList.add('hidden');
};

onAuthStateChanged(auth, user => {
  if(user){
    currentUser = user;
    document.getElementById('auth-overlay').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    document.getElementById('uname').textContent = user.displayName?.split(' ')[0] || 'Aventurier';
    document.getElementById('uav').src = user.photoURL || '';
    isMJ = user.email === 'toulousetroll@gmail.com'
         || user.displayName?.toLowerCase().includes('tanguy')
         || user.displayName?.toUpperCase().includes('LALIGUE');
    if(isMJ){
      document.getElementById('mj-banner').style.display = 'flex';
      document.getElementById('nav-footer').classList.add('mj-visible');
    }
    loadAll();
  }
});

async function loadAll(){
  await loadNavConfig();
  await loadDesignConfig();
  renderNav();
  await loadAllChars();
  renderCurrentChar();
  renderPartyStatus();
  loadNotes();
  listenJournal();
  await loadCustomPages();
  listenNegotiation();
  listenAdvDice();
}

// ===== DESIGN =====
async function loadDesignConfig(){
  // D'abord charger depuis Firebase (partagé avec tous)
  const snap = await getDoc(doc(db,'shared','design-config'));
  if(snap.exists()){
    currentDesign = snap.data();
  } else {
    currentDesign = { ...THEMES[0], title:'⚔ Alésia', subtitle:'Portail de campagne', bgOpacity:0 };
  }
  // Image de fond : stockée localement dans localStorage (trop grande pour Firestore)
  const savedBg = localStorage.getItem('alesia_bg_image');
  if(savedBg) bgImageDataUrl = savedBg;
  applyDesign(currentDesign);
}

function applyDesign(d){
  const r = document.documentElement.style;
  if(d.gold) r.setProperty('--gold', d.gold);
  if(d.gold){
    // Dériver les variantes
    r.setProperty('--gold-d', shadeColor(d.gold, -20));
    r.setProperty('--gold-l', shadeColor(d.gold, 20));
    r.setProperty('--gold-pale', hexToRgba(d.gold, 0.12));
  }
  if(d.parch){ r.setProperty('--parch', d.parch); r.setProperty('--parch2', shadeColor(d.parch, -5)); }
  if(d.surf){ r.setProperty('--surf', d.surf); r.setProperty('--surf2', shadeColor(d.surf, -4)); }
  if(d.header) r.setProperty('--header-bg', d.header);
  if(d.nav) r.setProperty('--nav-bg', d.nav);
  if(d.ink){
    r.setProperty('--ink', d.ink);
    r.setProperty('--ink-m', hexToRgba(d.ink, 0.7));
    r.setProperty('--ink-l', hexToRgba(d.ink, 0.5));
  }
  if(d.radius !== undefined) r.setProperty('--radius', d.radius + 'px');
  // Image de fond
  const bgOpacity = d.bgOpacity ?? 0;
  if(bgImageDataUrl){
    document.body.style.setProperty('--bg-image', `url('${bgImageDataUrl}')`);
    document.body.style.setProperty('--bg-overlay', `rgba(${hexToRgbTriple(d.parch||'#F5EFE0')},${bgOpacity/100})`);
  } else {
    document.body.style.setProperty('--bg-image', 'none');
    document.body.style.setProperty('--bg-overlay', 'transparent');
  }
  // Titre
  if(d.title) document.getElementById('site-title').textContent = d.title;
  if(d.subtitle) document.getElementById('site-subtitle').textContent = d.subtitle;
}

// ===== DESIGN EDITOR =====
window.openDesignEditor = () => {
  // Remplir les presets
  const pg = document.getElementById('preset-grid');
  pg.innerHTML = '';
  THEMES.forEach((t,i) => {
    const btn = document.createElement('div');
    btn.className = 'preset-btn';
    btn.innerHTML = `<div class="preset-swatch" style="background:linear-gradient(135deg,${t.header} 0%,${t.header} 40%,${t.parch} 40%,${t.parch} 100%)"></div><div class="preset-name">${t.name}</div>`;
    btn.onclick = () => { applyThemePreset(t); document.querySelectorAll('.preset-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); };
    pg.appendChild(btn);
  });
  // Remplir les inputs avec les valeurs actuelles
  document.getElementById('de-gold').value = currentDesign.gold || '#C9A84C';
  document.getElementById('de-parch').value = currentDesign.parch || '#F5EFE0';
  document.getElementById('de-surf').value = currentDesign.surf || '#FAF6EC';
  document.getElementById('de-header').value = currentDesign.header || '#2C2416';
  document.getElementById('de-nav').value = currentDesign.nav || '#FAF6EC';
  document.getElementById('de-ink').value = currentDesign.ink || '#2C2416';
  document.getElementById('de-title').value = currentDesign.title || '⚔ Alésia';
  document.getElementById('de-subtitle').value = currentDesign.subtitle || 'Portail de campagne';
  document.getElementById('de-radius').value = currentDesign.radius ?? 10;
  document.getElementById('de-radius-val').textContent = (currentDesign.radius ?? 10) + 'px';
  document.getElementById('de-bg-opacity').value = currentDesign.bgOpacity ?? 0;
  document.getElementById('de-bg-opacity-val').textContent = (currentDesign.bgOpacity ?? 0) + '%';
  // Swatches
  ['gold','parch','surf','header','nav','ink'].forEach(k => updateSwatch(k, document.getElementById('de-'+k).value));
  // Preview image
  if(bgImageDataUrl){
    const prev = document.getElementById('bg-preview');
    prev.src = bgImageDataUrl; prev.classList.add('visible');
  }
  document.getElementById('design-editor-modal').classList.add('open');
};

window.closeDesignEditor = () => document.getElementById('design-editor-modal').classList.remove('open');
window.closeDesignEditorOnBg = (e) => { if(e.target === document.getElementById('design-editor-modal')) closeDesignEditor(); };

function applyThemePreset(t){
  document.getElementById('de-gold').value = t.gold;
  document.getElementById('de-parch').value = t.parch;
  document.getElementById('de-surf').value = t.surf;
  document.getElementById('de-header').value = t.header;
  document.getElementById('de-nav').value = t.nav;
  document.getElementById('de-ink').value = t.ink;
  document.getElementById('de-radius').value = t.radius;
  document.getElementById('de-radius-val').textContent = t.radius + 'px';
  ['gold','parch','surf','header','nav','ink'].forEach(k => updateSwatch(k, document.getElementById('de-'+k).value));
  previewDesign();
}

window.updateSwatch = (key, val) => {
  const preview = document.getElementById('cp-' + key);
  if(preview) preview.style.background = val;
};

window.previewDesign = () => {
  const d = getDesignFromForm();
  applyDesign(d);
};

function getDesignFromForm(){
  return {
    gold: document.getElementById('de-gold').value,
    parch: document.getElementById('de-parch').value,
    surf: document.getElementById('de-surf').value,
    header: document.getElementById('de-header').value,
    nav: document.getElementById('de-nav').value,
    ink: document.getElementById('de-ink').value,
    title: document.getElementById('de-title').value,
    subtitle: document.getElementById('de-subtitle').value,
    radius: parseInt(document.getElementById('de-radius').value),
    bgOpacity: parseInt(document.getElementById('de-bg-opacity').value),
  };
}

window.saveDesign = async () => {
  currentDesign = getDesignFromForm();
  await setDoc(doc(db,'shared','design-config'), currentDesign);
  applyDesign(currentDesign);
  closeDesignEditor();
  toast('Design sauvegardé ✓ — visible par tous les joueurs');
};

window.resetDesign = async () => {
  const def = { ...THEMES[0], title:'⚔ Alésia', subtitle:'Portail de campagne', bgOpacity:0 };
  currentDesign = def;
  await setDoc(doc(db,'shared','design-config'), def);
  bgImageDataUrl = null;
  localStorage.removeItem('alesia_bg_image');
  applyDesign(def);
  closeDesignEditor();
  toast('Design réinitialisé ✓');
};

window.handleImageUpload = (e) => {
  const file = e.target.files[0];
  if(!file) return;
  if(file.size > 5 * 1024 * 1024){ toast('Image trop grande (max 5 Mo)'); return; }
  const reader = new FileReader();
  reader.onload = (ev) => {
    bgImageDataUrl = ev.target.result;
    localStorage.setItem('alesia_bg_image', bgImageDataUrl);
    const prev = document.getElementById('bg-preview');
    prev.src = bgImageDataUrl; prev.classList.add('visible');
    previewDesign();
    toast('Image chargée ✓');
  };
  reader.readAsDataURL(file);
};

window.clearBgImage = () => {
  bgImageDataUrl = null;
  localStorage.removeItem('alesia_bg_image');
  document.getElementById('bg-preview').classList.remove('visible');
  document.body.style.setProperty('--bg-image', 'none');
  document.body.style.setProperty('--bg-overlay', 'transparent');
  toast('Image retirée ✓');
};

// Helpers couleur
function shadeColor(hex, percent){
  const num = parseInt(hex.replace('#',''), 16);
  const r = Math.min(255, Math.max(0, (num >> 16) + Math.round(2.55 * percent)));
  const g = Math.min(255, Math.max(0, ((num >> 8) & 0xff) + Math.round(2.55 * percent)));
  const b = Math.min(255, Math.max(0, (num & 0xff) + Math.round(2.55 * percent)));
  return '#' + ((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1);
}
function hexToRgba(hex, alpha){
  const [r,g,b] = hexToRgbTriple(hex);
  return `rgba(${r},${g},${b},${alpha})`;
}
function hexToRgbTriple(hex){
  const num = parseInt((hex||'#000000').replace('#',''), 16);
  return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
}

// ===== NAV CONFIG =====
async function loadNavConfig(){
  const snap = await getDoc(doc(db,'shared','nav-config'));
  navConfig = (snap.exists() && snap.data().items) ? snap.data().items : JSON.parse(JSON.stringify(DEFAULT_NAV));
  // Migration : ajoute l'onglet Accueil s'il n'existe pas encore dans une config déjà sauvegardée
  if(!navConfig.some(e => e && e.id === 'accueil')){
    navConfig.unshift({type:'sep'});
    navConfig.unshift({type:'item',id:'accueil',label:'Accueil',icon:'ti-home',builtin:true,visible:true});
  }
}

function renderNav(){
  const scroll = document.getElementById('nav-scroll');
  scroll.innerHTML = '';
  let firstItem = true;
  navConfig.forEach(entry => {
    if(!entry) return;
    if(entry.type === 'group'){
      const div = document.createElement('div'); div.className = 'nl'; div.textContent = entry.label || ''; scroll.appendChild(div);
    } else if(entry.type === 'sep'){
      const div = document.createElement('div'); div.className = 'ndiv'; scroll.appendChild(div);
    } else if(entry.type === 'item'){
      if(entry.visible === false) return;
      const div = document.createElement('div');
      div.className = 'ni' + (firstItem ? ' active' : '');
      div.id = 'nav-item-' + entry.id;
      div.innerHTML = `<i class="ti ${entry.icon || 'ti-file'}"></i> ${entry.label}`;
      div.onclick = () => showSec(entry.id, div);
      scroll.appendChild(div);
      if(firstItem){ firstItem = false; setTimeout(() => showSec(entry.id, div), 0); }
    }
  });
}

function showSec(id, el){
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  const builtin = document.getElementById('s-' + id);
  if(builtin){ builtin.classList.add('active'); }
  else { ensureCustomSection(id); const cs = document.getElementById('cs-' + id); if(cs) cs.classList.add('active'); }
  if(el) el.classList.add('active');
}
window.showSec = showSec;

// ===== CUSTOM PAGES =====
async function loadCustomPages(){
  const snap = await getDoc(doc(db,'shared','custom-pages'));
  if(snap.exists()) customPagesData = snap.data() || {};
  navConfig.filter(e => e.type === 'item' && !e.builtin).forEach(e => ensureCustomSection(e.id));
}
function ensureCustomSection(id){
  if(document.getElementById('cs-'+id)) return;
  const container = document.getElementById('custom-sections-container');
  const entry = navConfig.find(e => e.id === id);
  if(!entry) return;
  const div = document.createElement('div');
  div.id = 'cs-' + id; div.className = 'section';
  const data = customPagesData[id] || {title: entry.label, content: ''};
  div.innerHTML = buildCustomPage(id, data);
  container.appendChild(div);
}
function buildCustomPage(id, data){
  const entry = navConfig.find(e => e.id === id) || {};
  return `<div class="page-title"><i class="ti ${entry.icon||'ti-file'}"></i> ${data.title||entry.label||'Page'}</div>
    ${isMJ?`<div class="custom-toolbar"><button class="btn-edit-page" onclick="toggleCustomEdit('${id}')"><i class="ti ti-pencil"></i> Modifier le contenu</button></div>`:''}
    <div id="cp-view-${id}">${data.content?`<div class="custom-rendered">${escapeHtml(data.content)}</div>`:`<div style="color:#A09070;font-style:italic;font-size:13px;padding:20px 0;">${isMJ?'Page vide — cliquez sur « Modifier le contenu ».':'Aucun contenu.'}</div>`}</div>
    <div id="cp-edit-${id}" style="display:none"><textarea class="custom-edit-area" id="cp-area-${id}" rows="16">${escapeHtml(data.content||'')}</textarea>
    <div style="display:flex;gap:8px;margin-top:10px;"><button class="btn-save" onclick="saveCustomPage('${id}')"><i class="ti ti-check"></i> Enregistrer</button><button class="btn-cancel" onclick="toggleCustomEdit('${id}')">Annuler</button></div></div>`;
}
window.toggleCustomEdit = (id) => {
  const v=document.getElementById('cp-view-'+id), e=document.getElementById('cp-edit-'+id);
  if(!v||!e) return;
  const open=e.style.display==='block';
  v.style.display=open?'block':'none'; e.style.display=open?'none':'block';
};
window.saveCustomPage = async (id) => {
  const area=document.getElementById('cp-area-'+id); if(!area) return;
  customPagesData[id]={...(customPagesData[id]||{}),content:area.value};
  await setDoc(doc(db,'shared','custom-pages'),customPagesData,{merge:true});
  const sec=document.getElementById('cs-'+id);
  if(sec) sec.innerHTML=buildCustomPage(id,customPagesData[id]);
  toast('Page sauvegardée ✓');
};
function escapeHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ===== NAV EDITOR =====
window.openNavEditor = () => {
  editingNav = JSON.parse(JSON.stringify(navConfig));
  renderNavEditorBody();
  document.getElementById('nav-editor-modal').classList.add('open');
};
window.closeNavEditor = () => document.getElementById('nav-editor-modal').classList.remove('open');
window.closeNavEditorOnBg = (e) => { if(e.target===document.getElementById('nav-editor-modal')) closeNavEditor(); };

function renderNavEditorBody(){
  const body = document.getElementById('nav-editor-body');
  body.innerHTML = '';
  const info = document.createElement('div');
  info.style.cssText='font-size:12px;color:#A09070;font-style:italic;margin-bottom:14px;padding:8px 12px;background:rgba(22,16,10,.9);border:1px solid var(--bord);border-radius:7px;';
  info.innerHTML='<i class="ti ti-info-circle" style="vertical-align:-2px;margin-right:4px;"></i>Glissez pour réordonner · Cliquez le nom pour le modifier · Œil pour masquer/afficher';
  body.appendChild(info);
  const list = document.createElement('div');
  list.id='nav-edit-list'; list.style.cssText='display:flex;flex-direction:column;gap:5px;margin-bottom:16px;';
  body.appendChild(list);
  editingNav.forEach((entry,i) => list.appendChild(buildEditRow(entry,i)));
  const addSection = document.createElement('div');
  addSection.style.cssText='border-top:1px solid var(--bord);padding-top:14px;';
  addSection.innerHTML=`<div style="font-family:'Cinzel',serif;font-size:9px;letter-spacing:.1em;color:var(--gold-d);margin-bottom:10px;text-transform:uppercase;">Ajouter</div>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <div style="display:flex;gap:8px;">
        <input class="nav-add-input" id="new-item-label" placeholder="Nom du nouvel onglet..." style="flex:1">
        <select id="new-item-icon" style="font-family:'Crimson Pro',serif;font-size:13px;background:rgba(45,32,14,.85);border:1px solid var(--bord-s);border-radius:7px;padding:5px 8px;color:#F2E6CC;outline:none;">${AVAILABLE_ICONS.map(ic=>`<option value="${ic}">${ic.replace('ti-','')}</option>`).join('')}</select>
        <button class="btn-save" style="white-space:nowrap;" onclick="addNavItem()"><i class="ti ti-plus"></i> Onglet</button>
      </div>
      <div style="display:flex;gap:8px;">
        <input class="nav-add-input" id="new-group-label" placeholder="Nom du groupe...">
        <button class="btn-add" style="margin-bottom:0;white-space:nowrap;" onclick="addNavGroup()"><i class="ti ti-plus"></i> Groupe</button>
        <button class="btn-cancel" style="white-space:nowrap;" onclick="addNavSep()"><i class="ti ti-minus"></i> Séparateur</button>
      </div>
    </div>`;
  body.appendChild(addSection);
}

function buildEditRow(entry,i){
  const row = document.createElement('div');
  row.dataset.idx = i;
  if(entry.type==='sep'){
    row.style.cssText='display:flex;align-items:center;gap:8px;padding:5px 10px;background:rgba(139,105,20,.05);border:1px dashed var(--bord);border-radius:8px;';
    row.draggable=true;
    row.innerHTML=`<i class="ti ti-grip-vertical" style="color:#A09070;font-size:14px;cursor:grab;"></i><span style="font-family:'Cinzel',serif;font-size:9px;letter-spacing:.08em;color:#A09070;flex:1;text-transform:uppercase;">— Séparateur —</span><button class="nav-row-btn del" onclick="removeNavEntry(${i})"><i class="ti ti-trash"></i></button>`;
    addDragListeners(row,i); return row;
  }
  if(entry.type==='group'){
    row.style.cssText='display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--gold-pale);border:1px solid rgba(201,168,76,.25);border-radius:8px;';
    row.draggable=true;
    row.innerHTML=`<i class="ti ti-grip-vertical" style="color:var(--gold-d);font-size:14px;cursor:grab;"></i><i class="ti ti-folder" style="color:var(--gold-d);font-size:14px;"></i><input class="nav-row-name-input" style="flex:1;background:transparent;border-color:transparent;" value="${escapeHtml(entry.label||'')}" onchange="editNavEntry(${i},'label',this.value)" onfocus="this.style.borderColor='var(--gold)';this.style.background='var(--surf2)'" onblur="this.style.borderColor='transparent';this.style.background='transparent'"><button class="nav-row-btn del" onclick="removeNavEntry(${i})"><i class="ti ti-trash"></i></button>`;
    addDragListeners(row,i); return row;
  }
  row.className='nav-edit-row'; row.draggable=true;
  const visIcon=entry.visible===false?'ti-eye-off':'ti-eye';
  const isBuiltin=entry.builtin?'<span style="font-size:10px;background:var(--blue-pale);color:var(--blue);border:1px solid rgba(26,74,122,.2);border-radius:10px;padding:1px 6px;">intégré</span>':'';
  row.innerHTML=`<i class="ti ti-grip-vertical" style="color:#A09070;font-size:14px;cursor:grab;"></i><i class="ti ${entry.icon||'ti-file'}" style="font-size:16px;color:var(--gold-d);cursor:pointer;width:22px;text-align:center;" onclick="cycleIcon(${i},this)" title="Changer l'icône"></i><input class="nav-row-name-input" value="${escapeHtml(entry.label||'')}" onchange="editNavEntry(${i},'label',this.value)" onfocus="this.style.borderColor='var(--gold)'" onblur="this.style.borderColor='transparent'">${isBuiltin}<div class="nav-row-actions"><button class="nav-row-btn ${entry.visible===false?'vis-off':''}" onclick="toggleNavVis(${i},this)"><i class="ti ${visIcon}"></i></button>${!entry.builtin?`<button class="nav-row-btn del" onclick="removeNavEntry(${i})"><i class="ti ti-trash"></i></button>`:''}</div>`;
  addDragListeners(row,i); return row;
}

function addDragListeners(row,i){
  row.addEventListener('dragstart',e=>{dragSrcIdx=i;row.classList.add('dragging');e.dataTransfer.effectAllowed='move';});
  row.addEventListener('dragend',()=>row.classList.remove('dragging'));
  row.addEventListener('dragover',e=>{e.preventDefault();row.classList.add('drag-over');});
  row.addEventListener('dragleave',()=>row.classList.remove('drag-over'));
  row.addEventListener('drop',e=>{
    e.preventDefault();row.classList.remove('drag-over');
    if(dragSrcIdx===null||dragSrcIdx===i) return;
    const moved=editingNav.splice(dragSrcIdx,1)[0];
    editingNav.splice(i>dragSrcIdx?i-1:i,0,moved);
    dragSrcIdx=null;renderNavEditorBody();
  });
}
window.editNavEntry=(i,field,val)=>{if(editingNav[i])editingNav[i][field]=val;};
window.removeNavEntry=(i)=>{editingNav.splice(i,1);renderNavEditorBody();};
window.toggleNavVis=(i)=>{if(editingNav[i])editingNav[i].visible=editingNav[i].visible===false;renderNavEditorBody();};
window.cycleIcon=(i,el)=>{
  const cur=editingNav[i].icon||'ti-file';
  const idx=AVAILABLE_ICONS.indexOf(cur);
  const next=AVAILABLE_ICONS[(idx+1)%AVAILABLE_ICONS.length];
  editingNav[i].icon=next; el.className='ti '+next; el.style.cssText='font-size:16px;color:var(--gold-d);cursor:pointer;width:22px;text-align:center;';
};
window.addNavItem=()=>{
  const label=document.getElementById('new-item-label').value.trim();
  const icon=document.getElementById('new-item-icon').value;
  if(!label){toast('Entrez un nom');return;}
  editingNav.push({type:'item',id:'custom_'+Date.now(),label,icon,builtin:false,visible:true});
  document.getElementById('new-item-label').value='';renderNavEditorBody();
};
window.addNavGroup=()=>{
  const label=document.getElementById('new-group-label').value.trim();
  if(!label){toast('Entrez un nom de groupe');return;}
  editingNav.push({type:'group',label});document.getElementById('new-group-label').value='';renderNavEditorBody();
};
window.addNavSep=()=>{editingNav.push({type:'sep'});renderNavEditorBody();};
window.saveNavConfig=async()=>{
  navConfig=JSON.parse(JSON.stringify(editingNav));
  await setDoc(doc(db,'shared','nav-config'),{items:navConfig});
  navConfig.filter(e=>e.type==='item'&&!e.builtin).forEach(e=>ensureCustomSection(e.id));
  renderNav();closeNavEditor();toast('Menu mis à jour ✓');
};

// ===== CHARS =====
async function loadAllChars(){
  for(const name of ['azarius','dy','firm','mwassa','nindey']){
    const snap=await getDoc(doc(db,'characters',name));
    if(snap.exists()) charData[name]={...defaultChars[name],...snap.data()};
  }
}
async function saveChar(name){
  await setDoc(doc(db,'characters',name),charData[name],{merge:true});toast('Sauvegardé ✓');
}
let currentChar='azarius';
window.showChar=window.showCharVitruve=(name,el)=>{
  document.querySelectorAll('.char-sec').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.char-tab').forEach(t=>t.classList.remove('active'));
  vitruveChar=name;vitruveZone=null;vitruveRender(name);document.getElementById('vpanel-empty').style.display='flex';document.getElementById('vpanel-content').style.display='none';
  document.getElementById('char-'+name)?.classList.add('active');el.classList.add('active');
};
let vitruveChar = 'azarius';
let vitruveZone = null;

