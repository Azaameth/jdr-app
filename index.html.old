  const CLASS_MAP = {"Lames Noires":'Cogneur', "Rôdeur":'Cogneur', Troubadour:'Arcaniste'};
  const mapped = silhouettes[classe] || silhouettes[CLASS_MAP[classe]] || silhouettes['Cogneur'];
  const defaultSvg = mapped;
  return defaultSvg;
}

function getPanelsForChar(name){
  const c = charData[name];
  return {
    identite:{icon:'👤',title:'Identité',items:[
      {l:'Race',v:c.race},{l:'Genre',v:c.genre},{l:'Valeurs',v:(c.valeurs||'').replace(/\n/g,' · ')},
      {l:'Langues',v:c.langues},{l:'Histoire',v:c.notes||'—'}
    ]},
    dons:{icon:'✨',title:'Dons & Capacités',items:
      (c.dons||'').split('\n').filter(d=>d.trim()).map(d=>({v:d}))
    },
    armes:{icon:'⚔',title:'Armement & Armures',items:[
      {l:'Armes',v:(c.armes||'—').replace(/\n/g,' · ')},
      {l:'Armures',v:(c.armures||'—').replace(/\n/g,' · ')}
    ]},
    equip:{icon:'🎒',title:'Équipement',items:
      (c.equip||'—').split(',').map(e=>({v:e.trim()})).filter(e=>e.v)
    },
    stats:{icon:'📊',title:'Statistiques',items:[
      {l:'Physique',v:c.phys+'%'},{l:'Social',v:c.social+'%'},{l:'Mental',v:c.mental+'%'},
      {l:'PV',v:c.pv+' / '+c.pv_max},{l:'Mana',v:c.mana+' / '+c.mana_max},{l:'Niveau',v:c.niveau}
    ]},
    histoire:{icon:'📜',title:'Bonus & Malus de Race',items:
      (c.race_bonus||'').split('\n').filter(r=>r.trim()).map(r=>({v:r}))
    }
  };
}

const CLASS_ICON = {'Cogneur':'ti-sword','Arcaniste':'ti-wand','Oracle':'ti-eye','Gardien':'ti-shield','Lames Noires':'ti-sword','Rôdeur':'ti-target','Troubadour':'ti-music'};
const PORTRAITS = {
  furmiaou:'xxx',
  azarius:'xxx',
  dy:'xxx',
  firm:'xxx',
  mwassa:'xxx',
  nindey:'xxx'
};
let vitruveTab = 'fiche';
function vitruveRender(name){
  const c = charData[name];
  document.getElementById('vit-name').textContent = c.name;
  document.getElementById('vit-sub').textContent = c.race+' · '+c.classe+' · Niv.'+c.niveau+' · '+c.element;
  document.getElementById('vit-pv').textContent = c.pv;
  document.getElementById('vit-pvmax').textContent = c.pv_max;
  document.getElementById('vit-mana').textContent = c.mana;
  document.getElementById('vit-manamax').textContent = c.mana_max;
  if(isMJ) document.getElementById('vitruve-edit-zone').style.display='block';
  const port = document.getElementById('vit-portrait');
  if(port) port.innerHTML = PORTRAITS[name] ? '<img src="'+PORTRAITS[name]+'" alt="'+c.name+'" style="width:100%;height:100%;object-fit:cover;">' : '<i class="ti '+(CLASS_ICON[c.classe]||'ti-user')+'"></i>';
  const furmBtn = document.getElementById('furm-tab-btn');
  if(furmBtn) furmBtn.style.display = (name==='firm') ? 'flex' : 'none';
  if(vitruveTab==='furm' && name!=='firm') vitruveTab='fiche';
  document.querySelectorAll('.pchar-tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===vitruveTab));
  vitruveShowPanel(name, vitruveTab);
  _jetMod = 0; updateJetDisplay();
}
window.vitruveRender = vitruveRender;
window.showPersoTab = function(tab, el){
  vitruveTab = tab;
  document.querySelectorAll('.pchar-tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===tab));
  vitruveShowPanel(vitruveChar, tab);
};

function renderCurrentChar(){ vitruveRender(vitruveChar); }
function renderChar(name){ vitruveRender(name); }


window.editField=(charName,field)=>{
  const allEf=document.querySelectorAll(`#char-${charName} .ef`);
  let targetEl=null;
  allEf.forEach(el=>{if(el.onclick&&el.onclick.toString().includes(`'${field}'`))targetEl=el;});
  if(!targetEl)return;
  const oldVal=charData[charName][field]??'';
  const input=document.createElement('input');input.className='ef-input';input.value=oldVal;
  input.style.width=Math.max(60,oldVal.toString().length*9)+'px';
  targetEl.replaceWith(input);input.focus();input.select();
  const save=async()=>{charData[charName][field]=input.value.trim();await saveChar(charName);renderChar(charName);};
  input.onblur=save;input.onkeydown=e=>{if(e.key==='Enter')save();if(e.key==='Escape')renderChar(charName);};
};
window.editFieldArea=(charName,field)=>{
  const allEf=document.querySelectorAll(`#char-${charName} .ef`);
  let targetEl=null;
  allEf.forEach(el=>{if(el.onclick&&el.onclick.toString().includes(`editFieldArea('${charName}','${field}')`))targetEl=el;});
  if(!targetEl)return;
  const ta=document.createElement('textarea');ta.className='ef-area';ta.value=charData[charName][field]??'';ta.rows=4;
  targetEl.replaceWith(ta);ta.focus();
  ta.onblur=async()=>{charData[charName][field]=ta.value.trim();await saveChar(charName);renderChar(charName);};
};
window.toggleDot=async(charName,compIdx,dotIdx)=>{
  const comp=charData[charName].competences[compIdx];
  comp.v=comp.v===dotIdx+1?dotIdx:dotIdx+1;
  renderChar(charName);await saveChar(charName);
};
window.adj=async(name,stat,delta)=>{
  const cur=isNaN(parseInt(charData[name][stat]))?0:parseInt(charData[name][stat]);
  const newVal=Math.max(0,cur+delta);
  charData[name][stat]=String(newVal);
  document.getElementById(`${name}-${stat}`).textContent=newVal;
  await setDoc(doc(db,'characters',name),{[stat]:String(newVal)},{merge:true});
  toast(`${name} ${stat.toUpperCase()} : ${newVal}`);
};

// ===== NOTES =====
async function loadNotes(){
  onSnapshot(doc(db,'shared','notes'),snap=>{
    const area=document.getElementById('notes-area');
    if(snap.exists())area.value=snap.data().content||'';
    else area.value='• Tolosa — groupe banni\n• La Lanterne — navire clé\n• Koben — Kitsune borgne\n• Rose Noire — veut Skarlath\n• Mira Solène — décédée';
  });
}
window.saveNotes=async()=>{await setDoc(doc(db,'shared','notes'),{content:document.getElementById('notes-area').value,updated:serverTimestamp()});toast('Notes sauvegardées ✓');};
window.insertTag=tag=>{const a=document.getElementById('notes-area');a.value+='\n'+tag+' ';a.focus();};

// ===== JOURNAL =====
function listenJournal(){
  onSnapshot(query(collection(db,'journal'),orderBy('createdAt','asc')),snap=>{
    const list=document.getElementById('journal-list');
    if(snap.empty){list.innerHTML='<div class="j-card"><div class="j-meta"><span class="j-num">Session 1</span></div><div class="j-title" style="color:#F2E6CC;">Les débuts à Tolosa</div><div class="j-text" style="color:#B8A070;">Le groupe se retrouve à Tolosa...</div></div>';return;}
    list.innerHTML='';
    snap.docs.forEach((d,i)=>{
      const data=d.data();const date=data.createdAt?.toDate?.()?.toLocaleDateString('fr-FR')||'—';
      list.innerHTML+=`<div class="j-card"><div class="j-meta"><span class="j-num">Session ${i+1}</span><span class="j-date" style="color:#907860;">${date}</span></div><div class="j-title" style="color:#F2E6CC;">${data.title}</div><div class="j-text" style="color:#B8A070;">${data.text}</div></div>`;
    });
  });
}
window.showAddSession=()=>{document.getElementById('add-form').style.display='block';};
window.hideAddSession=()=>{document.getElementById('add-form').style.display='none';};
window.saveSession=async()=>{
  const t=document.getElementById('s-title').value.trim(),x=document.getElementById('s-text').value.trim();
  if(!t||!x){toast('Titre et résumé requis');return;}
  await addDoc(collection(db,'journal'),{title:t,text:x,createdAt:serverTimestamp()});
  document.getElementById('s-title').value='';document.getElementById('s-text').value='';
  hideAddSession();toast('Session ajoutée !');
};


