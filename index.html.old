<script>
// DÉS
let dh=[];
function roll(f){
  const r=Math.floor(Math.random()*f)+1;
  const el=document.getElementById('dice-num');
  el.classList.remove('roll-anim');void el.offsetWidth;
  el.textContent=r;el.classList.add('roll-anim');
  document.getElementById('dice-lbl').textContent=`Résultat sur D${f}`;
  dh.unshift({f,r});if(dh.length>6)dh.pop();
  document.getElementById('dice-hist').innerHTML=dh.map(h=>`<div class="dh-row"><span>D${h.f}</span><span>${h.r}</span></div>`).join('');
}
function toast(msg){
  const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}
window.toast=toast;

